---
import Layout from '../layouts/Layout.astro';
import { teamMembers } from '../data/team';

const categories = [
  { id: 'all', label: 'All Specialists' },
  { id: 'leadership', label: 'Executive & Legal Directorate' },
  { id: 'legal_advisory', label: 'Immigration & Consular Advisors' },
  { id: 'candidate_care', label: 'Candidate Care & Welfare' },
  { id: 'employer_relations', label: 'Employer Relations & Corporate' }
];
---

<Layout 
  title="Meet Our European Immigration & Relocation Specialists · Licensed Consular Team | MyGo Travel"
  description="Meet the accredited European immigration attorneys, consular specialists, and admissions case officers helping candidates relocate to Europe with guaranteed jobs, housing, and meals. 8+ years experience."
  keywords="certified european immigration consultants, licensed visa advisors europe, mygo travel reviews, meet the team mygo travel, live and study in europe team, european relocation directorate"
  ogImage="/images/og-share-cover.jpg"
>
  <!-- TOP CREDIBILITY BANNER (Matching Screenshot 5) -->
  <section class="bg-slate-50 dark:bg-navy-950 border-b border-slate-200 dark:border-navy-800 py-3 sm:py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-3 text-center md:text-left">
      <div class="flex items-center gap-3">
        <span class="px-2.5 py-1 rounded bg-brand-500 text-white font-black text-xs uppercase tracking-wider">
          LIVE &amp; WORK IN EUROPE
        </span>
        <span class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-200">
          #1 Immigration solutions provider in Europe
        </span>
      </div>

      <!-- Trust Badges matching screenshot -->
      <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-semibold">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          8 years of experience in work immigration
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-500/10 text-blue-700 dark:text-blue-400 border border-blue-500/20">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          9,000+ workers placed for jobs in Europe
        </span>
      </div>
    </div>
  </section>

  <!-- HERO SECTION -->
  <section class="pt-12 pb-10 sm:pt-16 sm:pb-14 bg-[#FAF7EE] dark:bg-navy-900/60 border-b border-slate-200 dark:border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-left max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-700 dark:text-amber-400 text-xs font-bold mb-4">
          <span>Admissions Directorate &amp; Legal Desk</span>
        </div>
        
        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 dark:text-white font-serif tracking-tight leading-tight">
          Meet <span class="text-amber-500 italic">our team</span>
        </h1>
        
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 font-normal mt-4 leading-relaxed">
          From legal consular filings and labor permit certifications to employer contract vetting and post-arrival housing inspections, our multinational team supports candidates at every stage of their European relocation.
        </p>
      </div>

      <!-- Department Filter Pills -->
      <div class="flex flex-wrap gap-2 pt-8" id="team-filters">
        {categories.map((cat, idx) => (
          <button 
            type="button" 
            data-filter={cat.id}
            class={`team-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all cursor-pointer ${
              idx === 0 
                ? 'bg-amber-500 text-white shadow-sm active' 
                : 'bg-white dark:bg-navy-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-navy-700 border border-slate-200 dark:border-navy-700'
            }`}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- FULL TEAM DIRECTORY GRID (Matching Screenshot 5) -->
  <section class="py-14 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 sm:gap-10" id="team-grid">
      {teamMembers.map((member) => (
        <div 
          class="team-card flex flex-col items-center text-center p-6 rounded-3xl bg-white dark:bg-navy-900 border border-slate-200/80 dark:border-navy-800 shadow-sm hover:shadow-xl hover:border-amber-500/50 transition-all duration-300 group cursor-pointer"
          data-category={member.category}
          data-member-id={member.id}
          data-member-name={member.name}
          data-member-role={member.role}
          data-member-img={member.image}
          data-member-exp={member.experience}
          data-member-spec={member.specialization}
          data-member-lang={member.languages.join(', ')}
          data-member-bio={member.bio}
        >
          <!-- Circular Headshot Frame -->
          <div class="relative w-44 h-44 sm:w-48 sm:h-48 rounded-full overflow-hidden border-4 border-slate-100 dark:border-navy-800 shadow-md group-hover:scale-105 group-hover:border-amber-500/30 transition-all duration-300 bg-slate-200 dark:bg-navy-800 mb-5">
            <img 
              src={member.image} 
              alt={member.name} 
              loading="lazy"
              class="w-full h-full object-cover object-top"
            />
          </div>

          <!-- Name & Designation -->
          <h3 class="text-lg font-extrabold text-slate-900 dark:text-white tracking-tight group-hover:text-amber-500 transition-colors">
            {member.name}
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-semibold mt-1">
            {member.role}
          </p>

          <!-- Languages Pill -->
          <div class="mt-3 flex flex-wrap justify-center gap-1">
            {member.languages.map((lang) => (
              <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-slate-100 dark:bg-navy-950 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-navy-800">
                {lang}
              </span>
            ))}
          </div>

          <!-- Eye Icon button -->
          <button 
            type="button" 
            class="mt-4 text-slate-400 group-hover:text-amber-500 transition-colors inline-flex items-center gap-1.5 text-xs font-semibold p-1"
            aria-label={`View full dossier of ${member.name}`}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
            <span>View Bio</span>
          </button>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="py-14 bg-gradient-to-r from-slate-900 via-navy-900 to-slate-900 border-t border-slate-800 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black">Ready to Begin Your European Relocation?</h2>
        <p class="text-slate-400 text-sm mt-1">Our admissions advisors are ready to match you with vetted employers across 8 European nations.</p>
      </div>
      <div class="flex flex-wrap gap-3 justify-center">
        <a 
          href="/assess" 
          class="px-7 py-3.5 rounded-xl font-extrabold text-sm text-slate-900 bg-amber-400 hover:bg-amber-300 shadow-lg transition"
        >
          Take Eligibility Assessment
        </a>
        <a 
          href="/support" 
          class="px-7 py-3.5 rounded-xl font-bold text-sm text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition"
        >
          Contact Support Desk
        </a>
      </div>
    </div>
  </section>

  <!-- TEAM MEMBER DETAIL MODAL -->
  <div 
    id="team-page-modal" 
    class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center p-4 transition-opacity"
  >
    <div class="bg-white dark:bg-navy-900 rounded-3xl max-w-lg w-full p-6 sm:p-8 border border-slate-200 dark:border-navy-800 shadow-2xl relative transform transition-all">
      <button 
        id="team-page-modal-close" 
        type="button" 
        class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition-colors"
        aria-label="Close bio"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>

      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 mb-5 text-center sm:text-left">
        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden border-4 border-amber-500/20 shadow-md shrink-0 bg-slate-100 dark:bg-navy-800">
          <img id="pmodal-img" src="" alt="" class="w-full h-full object-cover object-top" />
        </div>
        <div>
          <div class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-500/15 text-amber-600 dark:text-amber-400 mb-1">
            MyGo Travel Relocation Officer
          </div>
          <h3 id="pmodal-name" class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white"></h3>
          <p id="pmodal-role" class="text-sm font-semibold text-slate-600 dark:text-slate-300"></p>
          <p id="pmodal-exp" class="text-xs text-slate-400 dark:text-slate-500 mt-1"></p>
        </div>
      </div>

      <div class="space-y-3.5 text-xs sm:text-sm text-slate-600 dark:text-slate-300 border-t border-slate-100 dark:border-navy-800 pt-4">
        <div>
          <span class="font-bold text-slate-900 dark:text-white block uppercase tracking-wider text-[11px] mb-1">Specialization</span>
          <p id="pmodal-spec" class="bg-slate-50 dark:bg-navy-950 p-2.5 rounded-xl border border-slate-200 dark:border-navy-800"></p>
        </div>
        <div>
          <span class="font-bold text-slate-900 dark:text-white block uppercase tracking-wider text-[11px] mb-1">Languages Spoken</span>
          <p id="pmodal-lang" class="font-medium text-slate-800 dark:text-slate-200"></p>
        </div>
        <div>
          <span class="font-bold text-slate-900 dark:text-white block uppercase tracking-wider text-[11px] mb-1">Advisor Background</span>
          <p id="pmodal-bio" class="leading-relaxed"></p>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-slate-100 dark:border-navy-800 flex gap-3">
        <a 
          href="/assess" 
          class="flex-1 py-3 rounded-xl font-bold text-xs sm:text-sm text-center text-white bg-amber-500 hover:bg-amber-600 shadow-sm transition"
        >
          Begin Evaluation
        </a>
        <a 
          href="/support" 
          class="px-4 py-3 rounded-xl font-bold text-xs sm:text-sm text-center text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-navy-800 hover:bg-slate-200 dark:hover:bg-navy-700 transition"
        >
          Contact Desk
        </a>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  (() => {
    // Filter buttons
    const filterButtons = document.querySelectorAll('.team-filter-btn');
    const cards = document.querySelectorAll('.team-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.classList.remove('bg-amber-500', 'text-white', 'shadow-sm', 'active');
          b.classList.add('bg-white', 'dark:bg-navy-800', 'text-slate-600', 'dark:text-slate-300', 'border', 'border-slate-200', 'dark:border-navy-700');
        });

        btn.classList.add('bg-amber-500', 'text-white', 'shadow-sm', 'active');
        btn.classList.remove('bg-white', 'dark:bg-navy-800', 'text-slate-600', 'dark:text-slate-300', 'border', 'border-slate-200', 'dark:border-navy-700');

        const filter = btn.getAttribute('data-filter');

        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Modal Handling
    const modal = document.getElementById('team-page-modal');
    const closeBtn = document.getElementById('team-page-modal-close');

    const modalImg = document.getElementById('pmodal-img');
    const modalName = document.getElementById('pmodal-name');
    const modalRole = document.getElementById('pmodal-role');
    const modalExp = document.getElementById('pmodal-exp');
    const modalSpec = document.getElementById('pmodal-spec');
    const modalLang = document.getElementById('pmodal-lang');
    const modalBio = document.getElementById('pmodal-bio');

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        if (!modal) return;
        modalImg.src = card.getAttribute('data-member-img') || '';
        modalImg.alt = card.getAttribute('data-member-name') || '';
        modalName.textContent = card.getAttribute('data-member-name') || '';
        modalRole.textContent = card.getAttribute('data-member-role') || '';
        modalExp.textContent = card.getAttribute('data-member-exp') || '';
        modalSpec.textContent = card.getAttribute('data-member-spec') || '';
        modalLang.textContent = card.getAttribute('data-member-lang') || '';
        modalBio.textContent = card.getAttribute('data-member-bio') || '';

        modal.classList.remove('hidden');
        modal.classList.add('flex');
      });
    });

    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });
  })();
</script>
