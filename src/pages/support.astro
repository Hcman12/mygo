---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Official Support & Candidate Help Desk · MyGo Travel"
  description="Need assistance with your European visa, relocation application, or job placement? Contact our admissions support desk at support@mygotravel.eu or reach our 24/7 advisory channels."
>
  <!-- HERO SECTION -->
  <section class="relative pt-12 pb-16 sm:pt-16 sm:pb-24 overflow-hidden border-b border-slate-200 dark:border-navy-800">
    <!-- Subtle Background Glows -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-600 dark:text-brand-400 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Admissions Directorate &amp; Help Desk</span>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <span>24/7 Candidate Inquiries</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-tight max-w-4xl mx-auto mb-6">
        How Can We <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-500 via-amber-500 to-brand-600">Help You</span> Today?
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        Whether you are tracking an existing relocation dossier, need guidance on visa and permit documents, or have employer sponsorship inquiries, our team is standing by to assist you.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 text-xs text-slate-500 dark:text-slate-400">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 dark:bg-navy-900 border border-slate-200 dark:border-navy-800 font-medium">
          <svg class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          Average Response: &lt; 2 Hours
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 dark:bg-navy-900 border border-slate-200 dark:border-navy-800 font-medium">
          <svg class="w-3.5 h-3.5 text-brand-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          Schengen Legal Team Active
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 dark:bg-navy-900 border border-slate-200 dark:border-navy-800 font-medium">
          <svg class="w-3.5 h-3.5 text-blue-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          Official Support: support@mygotravel.eu
        </span>
      </div>
    </div>
  </section>

  <!-- DIRECT CONTACT CHANNELS (3 PILLARS) -->
  <section class="py-14 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      
      <!-- Card 1: Official Email Desk -->
      <div class="bg-white dark:bg-navy-900 rounded-2xl p-7 border border-slate-200 dark:border-navy-800 shadow-sm hover:border-brand-500 transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-brand-500/10 text-brand-500 flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-brand-500/10 text-brand-600 dark:text-brand-400 mb-2">
            Primary Channel
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Direct Email Support</h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
            Send application updates, document attachments, passport bio-data, or case inquiries directly to our central admissions team.
          </p>
          <div class="p-3 bg-slate-50 dark:bg-navy-950 rounded-xl border border-slate-200 dark:border-navy-800 font-mono text-sm text-brand-600 dark:text-brand-400 font-bold break-all mb-4 flex items-center justify-between">
            <span>support@mygotravel.eu</span>
            <button id="btn-copy-email" class="text-slate-400 hover:text-brand-500 text-xs p-1" title="Copy email address">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </button>
          </div>
        </div>
        <a 
          href="mailto:support@mygotravel.eu" 
          class="inline-flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl font-bold text-sm text-white bg-brand-500 hover:bg-brand-600 shadow-sm transition"
        >
          <span>Email Support Desk</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

      <!-- Card 2: WhatsApp Live Advisor -->
      <div class="bg-white dark:bg-navy-900 rounded-2xl p-7 border border-slate-200 dark:border-navy-800 shadow-sm hover:border-emerald-500 transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </div>
          <div class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 mb-2">
            Real-Time Chat
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">WhatsApp Case Desk</h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
            Connect immediately with a designated case counselor for urgent visa inquiries, flight scheduling, or arrival instructions.
          </p>
          <div class="p-3 bg-slate-50 dark:bg-navy-950 rounded-xl border border-slate-200 dark:border-navy-800 font-mono text-sm text-emerald-600 dark:text-emerald-400 font-bold mb-4">
            +1 (209) 949-3346
          </div>
        </div>
        <a 
          href="https://wa.me/12099493346?text=Hello%20MyGo%20Travel%20Support%2C%20I%20have%20an%20inquiry%20regarding%20my%20relocation%20application." 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl font-bold text-sm text-white bg-emerald-600 hover:bg-emerald-500 shadow-sm transition"
        >
          <span>Chat on WhatsApp</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>

      <!-- Card 3: NicerApp Cloud Channel -->
      <div class="bg-white dark:bg-navy-900 rounded-2xl p-7 border border-slate-200 dark:border-navy-800 shadow-sm hover:border-blue-500 transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-500 flex items-center justify-center mb-5">
            <img src="/nicerapplogo.png" alt="NicerApp" class="w-7 h-7 object-contain rounded-full" />
          </div>
          <div class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-blue-500/10 text-blue-600 dark:text-blue-400 mb-2">
            Secure Cloud Desk
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">NicerApp Support Chat</h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
            Join the official European Admissions room on NicerApp for direct dossier verification, biometric updates, and legal notices.
          </p>
          <div class="p-3 bg-slate-50 dark:bg-navy-950 rounded-xl border border-slate-200 dark:border-navy-800 font-mono text-sm text-blue-600 dark:text-blue-400 font-bold mb-4">
            nicerapp.cloud/invite
          </div>
        </div>
        <a 
          href="https://nicerapp.cloud/invite/cd0452e9-e0be-4f0d-9fde-2aaa865c4e01" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl font-bold text-sm text-white bg-blue-600 hover:bg-blue-500 shadow-sm transition"
        >
          <span>Open NicerApp Channel</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>

    </div>
  </section>

  <!-- INTERACTIVE SUPPORT REQUEST FORM -->
  <section class="py-12 bg-slate-100/60 dark:bg-navy-900/40 border-y border-slate-200 dark:border-navy-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white dark:bg-navy-900 rounded-3xl p-6 sm:p-10 border border-slate-200 dark:border-navy-800 shadow-xl">
        <div class="text-center max-w-xl mx-auto mb-8">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
            Send an Official Inquiry
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2">
            Complete the docket inquiry form below. Your request will be directly routed to our admissions desk at <span class="font-bold text-brand-500">support@mygotravel.eu</span>.
          </p>
        </div>

        <div id="form-feedback" class="hidden mb-6 p-4 rounded-2xl text-sm font-medium text-center"></div>

        <form id="support-ticket-form" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">
                Your Full Name *
              </label>
              <input 
                type="text" 
                id="ticket-name" 
                required 
                placeholder="e.g. John Doe" 
                class="w-full bg-slate-50 dark:bg-navy-950 border border-slate-200 dark:border-navy-800 rounded-xl px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-brand-500 transition"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">
                Your Email Address *
              </label>
              <input 
                type="email" 
                id="ticket-email" 
                required 
                placeholder="e.g. applicant@example.com" 
                class="w-full bg-slate-50 dark:bg-navy-950 border border-slate-200 dark:border-navy-800 rounded-xl px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-brand-500 transition"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">
                Phone / WhatsApp Number
              </label>
              <input 
                type="tel" 
                id="ticket-phone" 
                placeholder="e.g. +44 7700 900000" 
                class="w-full bg-slate-50 dark:bg-navy-950 border border-slate-200 dark:border-navy-800 rounded-xl px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-brand-500 transition"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">
                Inquiry Department *
              </label>
              <select 
                id="ticket-topic" 
                required 
                class="w-full bg-slate-50 dark:bg-navy-950 border border-slate-200 dark:border-navy-800 rounded-xl px-4 py-3 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-brand-500 cursor-pointer"
              >
                <option value="tracking">Application Status &amp; Tracking ID Inquiry</option>
                <option value="visa">Visa Permit &amp; Embassy Consular Booking</option>
                <option value="housing">Employer Accommodation &amp; Meal Plans</option>
                <option value="contract">Employer Contract &amp; Job Offer Verification</option>
                <option value="documents">Passport Bio-Data &amp; CV Updates</option>
                <option value="other">General Inquiries &amp; Orientation</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">
              Candidate Tracking Reference (Optional)
            </label>
            <input 
              type="text" 
              id="ticket-tracking-id" 
              placeholder="e.g. mygo128934 (if you completed the evaluation)" 
              class="w-full bg-slate-50 dark:bg-navy-950 border border-slate-200 dark:border-navy-800 rounded-xl px-4 py-3 text-sm text-slate-900 dark:text-white font-mono placeholder-slate-400 focus:outline-none focus:border-brand-500 transition"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">
              Message or Specific Inquiry *
            </label>
            <textarea 
              id="ticket-message" 
              rows="5" 
              required 
              placeholder="Describe your question, relocation timeline, or application details..." 
              class="w-full bg-slate-50 dark:bg-navy-950 border border-slate-200 dark:border-navy-800 rounded-xl p-4 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-brand-500 leading-relaxed font-sans transition"
            ></textarea>
          </div>

          <div class="pt-2">
            <button 
              type="submit" 
              id="btn-submit-ticket" 
              class="w-full py-4 px-6 rounded-xl font-extrabold text-sm sm:text-base text-white bg-brand-500 hover:bg-brand-600 shadow-md hover:shadow-lg transition duration-150 flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Submit Inquiry to Admissions Desk</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
            <p class="text-center text-[11px] text-slate-400 mt-2.5">
              Official replies dispatched from <strong class="text-slate-600 dark:text-slate-300">support@mygotravel.eu</strong>. All dossiers are kept strictly confidential.
            </p>
          </div>
        </form>
      </div>

    </div>
  </section>

  <!-- FREQUENTLY ASKED QUESTIONS SECTION -->
  <section class="py-16 sm:py-24 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">
        Frequently Asked Questions
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base mt-2">
        Common inquiries from candidates relocating to European employment programs.
      </p>
    </div>

    <div class="space-y-4">
      <!-- FAQ 1 -->
      <details class="group bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 rounded-2xl p-6 transition-all [&_svg]:open:-rotate-180">
        <summary class="flex items-center justify-between font-bold text-slate-900 dark:text-white cursor-pointer list-none text-base sm:text-lg">
          <span>How does employer-provided accommodation and meal coverage work?</span>
          <svg class="w-5 h-5 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <p class="mt-4 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          Every employment contract brokered through MyGo Travel includes guaranteed housing and food plans. Your employer arranges clean, furnished living quarters near your workplace (utilities often included) and provides daily hot meals on shift or monthly food stipends. You do not need to hunt for an apartment or pay upfront rent upon arrival.
        </p>
      </details>

      <!-- FAQ 2 -->
      <details class="group bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 rounded-2xl p-6 transition-all [&_svg]:open:-rotate-180">
        <summary class="flex items-center justify-between font-bold text-slate-900 dark:text-white cursor-pointer list-none text-base sm:text-lg">
          <span>What is the standard processing timeline for work permits?</span>
          <svg class="w-5 h-5 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <p class="mt-4 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          Processing depends on your chosen destination. Fast-Track routes (like Serbia, North Macedonia, and seasonal corridors) take approximately <strong>1 to 2 months</strong>. Standard Schengen corridors (such as Poland, Slovakia, Czech Republic, Lithuania, and Portugal) typically average <strong>2 to 4 months</strong> for labor ministry certificate issuance and embassy visa stamping.
        </p>
      </details>

      <!-- FAQ 3 -->
      <details class="group bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 rounded-2xl p-6 transition-all [&_svg]:open:-rotate-180">
        <summary class="flex items-center justify-between font-bold text-slate-900 dark:text-white cursor-pointer list-none text-base sm:text-lg">
          <span>How can I check the status of my candidate evaluation?</span>
          <svg class="w-5 h-5 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <p class="mt-4 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          When you complete the eligibility assessment, a unique Tracking Reference (starting with <code>mygo...</code>) is generated. You can submit an inquiry via the form above or email <strong>support@mygotravel.eu</strong> quoting your Tracking ID to receive an immediate real-time update from your case officer.
        </p>
      </details>

      <!-- FAQ 4 -->
      <details class="group bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 rounded-2xl p-6 transition-all [&_svg]:open:-rotate-180">
        <summary class="flex items-center justify-between font-bold text-slate-900 dark:text-white cursor-pointer list-none text-base sm:text-lg">
          <span>What documents are required to initiate my relocation docket?</span>
          <svg class="w-5 h-5 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <p class="mt-4 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          The essential documents include a valid International Passport (minimum 1.5–2 years validity remaining), an updated CV / Resume, and a clean police clearance record. Educational certificates and previous trade certificates are required for specialized roles (such as commercial drivers, welders, or medical nurses).
        </p>
      </details>

      <!-- FAQ 5 -->
      <details class="group bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 rounded-2xl p-6 transition-all [&_svg]:open:-rotate-180">
        <summary class="flex items-center justify-between font-bold text-slate-900 dark:text-white cursor-pointer list-none text-base sm:text-lg">
          <span>Can family members or spouses accompany the candidate?</span>
          <svg class="w-5 h-5 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <p class="mt-4 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          Most European countries (including Portugal, Slovakia, and Lithuania) permit family reunification after the primary applicant secures their Temporary Residence Permit (TRP) and begins employment. In some destinations, couples can apply simultaneously for matched employer vacancies in the same facility.
        </p>
      </details>
    </div>
  </section>

  <!-- QUICK ACTION CTA BANNER -->
  <section class="py-14 bg-gradient-to-r from-brand-600 via-amber-600 to-brand-700 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div>
        <h3 class="text-2xl sm:text-3xl font-black tracking-tight">Haven't completed your relocation assessment yet?</h3>
        <p class="text-white/80 text-sm mt-1">Take the 2-minute evaluation to see which European nation matches your background.</p>
      </div>
      <a 
        href="/assess" 
        class="shrink-0 inline-flex items-center gap-2 px-8 py-4 rounded-xl font-extrabold text-base bg-white text-slate-900 hover:bg-slate-100 shadow-xl transition cursor-pointer"
      >
        <span>Check Eligibility Now</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </section>

  <!-- SCRIPT FOR COPY AND FORM SUBMISSION -->
  <script is:inline>
    // Copy email handler
    document.getElementById('btn-copy-email')?.addEventListener('click', () => {
      navigator.clipboard.writeText('support@mygotravel.eu');
      alert('Email copied to clipboard: support@mygotravel.eu');
    });

    // Support Form Submission
    const supportForm = document.getElementById('support-ticket-form');
    const feedbackEl = document.getElementById('form-feedback');
    const submitBtn = document.getElementById('btn-submit-ticket');

    supportForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (feedbackEl) {
        feedbackEl.classList.remove('hidden');
        feedbackEl.className = 'mb-6 p-4 rounded-2xl text-sm font-semibold bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400';
        feedbackEl.innerHTML = `
          ✓ Thank you! Your support docket has been registered.<br/>
          Our admissions desk has received your request and will contact you at <strong>${document.getElementById('ticket-email')?.value}</strong> shortly.
        `;
      }
      supportForm.reset();
      window.scrollTo({ top: feedbackEl.offsetTop - 100, behavior: 'smooth' });
    });
  </script>
</Layout>
