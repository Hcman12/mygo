                  <span>Communications Dispatched to Candidate</span>
                </h4>
                <div id="modal-communications-list" class="space-y-2 text-xs">
                  <div class="text-slate-500 py-2">Loading communication history...</div>
                </div>
              </div>
            </div>

            <!-- Modal Footer Actions -->
            <div class="px-6 py-4 border-t border-slate-800 bg-slate-950/80 flex items-center justify-between">
              <button id="modal-btn-delete" class="px-4 py-2 rounded-xl bg-rose-950/40 hover:bg-rose-900/60 text-rose-300 border border-rose-800/60 text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                <span>Delete Evaluation</span>
              </button>

              <div class="flex items-center gap-3">
                <button id="modal-btn-send-card" class="px-4 py-2 rounded-xl bg-tealbrand-600 hover:bg-tealbrand-500 text-white text-xs font-semibold flex items-center gap-1.5 transition shadow cursor-pointer" title="Send or resend Evaluation Card via SMTP (network@mygotravel.eu)">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <span>Send Evaluation Card</span>
                </button>
                <button id="modal-btn-reply" class="px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold flex items-center gap-1.5 transition shadow cursor-pointer">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  <span>Dispatch Official Email</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- ================= SENT EMAIL DETAIL MODAL ================= -->
        <div id="sent-email-modal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-xl max-h-[85vh] flex flex-col shadow-2xl overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between bg-slate-950/80">
              <h3 class="font-bold text-white text-sm">Dispatched Email Record</h3>
              <button id="btn-close-sent-modal" class="text-slate-400 hover:text-white p-1 rounded-lg">✕</button>
            </div>
            <div class="p-6 overflow-y-auto space-y-4 text-xs text-slate-300">
              <div class="p-3 bg-slate-950 rounded-xl space-y-1">
                <div><strong class="text-slate-400">Recipient:</strong> <span id="sent-modal-to" class="text-white font-medium"></span></div>
                <div><strong class="text-slate-400">Sent Date:</strong> <span id="sent-modal-date" class="text-slate-300"></span></div>
                <div><strong class="text-slate-400">Reference:</strong> <span id="sent-modal-tracking" class="text-brand-400 font-mono"></span></div>
                <div><strong class="text-slate-400">Subject:</strong> <span id="sent-modal-subject" class="text-white font-semibold"></span></div>
              </div>
              <div>
                <strong class="text-slate-400 block mb-1">Message Content:</strong>
                <div id="sent-modal-body" class="p-4 bg-slate-950 rounded-xl border border-slate-800 text-slate-200 leading-relaxed font-mono text-[11px] whitespace-pre-wrap"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- ================= INLINE MANAGEMENT JAVASCRIPT ================= -->
        <script is:inline>
          let evaluationsCache = [];
          let currentSelectedEval = null;
          let sentEmailsCache = [];

          // Pagination & Filtering state
          let currentPage = 1;
          let pageLimit = 50;
          let totalRecords = 0;

          // Toast notification utility
          function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            if (!container) return;

            const toast = document.createElement('div');
            const bgClass = type === 'success' 
              ? 'bg-emerald-950 border-emerald-800 text-emerald-200' 
              : type === 'error' 
                ? 'bg-rose-950 border-rose-800 text-rose-200' 
                : 'bg-brand-950 border-brand-800 text-brand-200';

            toast.className = `p-3.5 rounded-xl border shadow-xl text-xs font-medium transition-all duration-300 transform translate-y-2 opacity-0 flex items-center gap-2 ${bgClass}`;
            toast.innerHTML = `
              <span>${message}</span>
            `;
            container.appendChild(toast);

            setTimeout(() => {
              toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
              toast.classList.add('opacity-0', 'translate-x-4');
              setTimeout(() => toast.remove(), 300);
            }, 4000);
          }

          // Status Badges & Colors Mapping
          const statusConfig = {
            pending: { label: 'Pending Review', bg: 'bg-amber-950/60 text-amber-300 border-amber-800/60' },
            reviewing: { label: 'In Review', bg: 'bg-blue-950/60 text-blue-300 border-blue-800/60' },
            approved: { label: 'Approved', bg: 'bg-emerald-950/60 text-emerald-300 border-emerald-800/60' },
            docs_requested: { label: 'Docs Requested', bg: 'bg-purple-950/60 text-purple-300 border-purple-800/60' },
            interview: { label: 'Interview', bg: 'bg-indigo-950/60 text-indigo-300 border-indigo-800/60' },
            visa_processing: { label: 'Visa Prep', bg: 'bg-teal-950/60 text-teal-300 border-teal-800/60' },
            rejected: { label: 'Rejected', bg: 'bg-rose-950/60 text-rose-300 border-rose-800/60' }
          };

          function renderStatusBadge(status) {
            const conf = statusConfig[status?.toLowerCase()] || statusConfig.pending;
            return `<span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold border ${conf.bg}">${conf.label}</span>`;
          }

          // Tab Navigation
          const tabBtns = {
            evaluations: document.getElementById('tab-btn-evaluations'),
            analytics: document.getElementById('tab-btn-analytics'),
            email: document.getElementById('tab-btn-email')
          };

          const tabSections = {
            evaluations: document.getElementById('section-evaluations'),
            analytics: document.getElementById('section-analytics'),
            email: document.getElementById('section-email')
          };

          function switchTab(target) {
            Object.keys(tabBtns).forEach(key => {
              if (key === target) {
                tabBtns[key]?.classList.add('bg-brand-600', 'text-white', 'shadow');
                tabBtns[key]?.classList.remove('text-slate-400');
                tabSections[key]?.classList.remove('hidden');
              } else {
                tabBtns[key]?.classList.remove('bg-brand-600', 'text-white', 'shadow');
                tabBtns[key]?.classList.add('text-slate-400');
                tabSections[key]?.classList.add('hidden');
              }
            });

            if (target === 'analytics') loadAnalytics();
            if (target === 'email') loadSentEmails();
          }

          tabBtns.evaluations?.addEventListener('click', () => switchTab('evaluations'));
          tabBtns.analytics?.addEventListener('click', () => switchTab('analytics'));
          tabBtns.email?.addEventListener('click', () => switchTab('email'));

          // Sign Out Handler
          document.getElementById('btn-admin-logout')?.addEventListener('click', async () => {
            if (confirm('Sign out from MyGo Admin Console?')) {
              await fetch('/api/admin/logout', { method: 'POST' });
              window.location.reload();
            }
          });

          // Fetch Evaluations with Filters & Pagination
          async function loadEvaluations() {
            const tableBody = document.getElementById('evaluations-table-body');
            const searchVal = document.getElementById('eval-search-input')?.value.trim() || '';
            const destinationVal = document.getElementById('eval-country-filter')?.value || '';
            const statusVal = document.getElementById('eval-status-filter')?.value || 'all';
            const emailStatusVal = document.getElementById('eval-email-filter')?.value || 'all';
            const sortByVal = document.getElementById('eval-sort-by')?.value || 'newest';
            const limitVal = parseInt(document.getElementById('eval-page-limit')?.value || '50', 10);
            pageLimit = limitVal;

            const offset = (currentPage - 1) * pageLimit;

            try {
              let url = `/api/admin/evaluations?limit=${pageLimit}&offset=${offset}&sortBy=${sortByVal}`;
              if (searchVal) url += `&q=${encodeURIComponent(searchVal)}`;
              if (destinationVal) url += `&destination=${encodeURIComponent(destinationVal)}`;
              if (statusVal && statusVal !== 'all') url += `&status=${encodeURIComponent(statusVal)}`;
              if (emailStatusVal && emailStatusVal !== 'all') url += `&emailStatus=${encodeURIComponent(emailStatusVal)}`;

              const res = await fetch(url);
              if (res.status === 401) {
                window.location.reload();
                return;
              }
              const data = await res.json();
              evaluationsCache = data.evaluations || [];
              totalRecords = data.total || 0;

              // Update badge count
              const badgeCount = document.getElementById('badge-eval-count');
              if (badgeCount) badgeCount.textContent = totalRecords;

              // Update Pagination Counters
              const totalPages = Math.max(1, Math.ceil(totalRecords / pageLimit));
              document.getElementById('table-total-count').textContent = totalRecords;
              document.getElementById('table-showing-start').textContent = totalRecords === 0 ? 0 : offset + 1;
              document.getElementById('table-showing-end').textContent = Math.min(offset + evaluationsCache.length, totalRecords);
              document.getElementById('pagination-page-label').textContent = `Page ${currentPage} of ${totalPages}`;

              document.getElementById('btn-page-prev').disabled = currentPage <= 1;
              document.getElementById('btn-page-next').disabled = currentPage >= totalPages;

              if (evaluationsCache.length === 0) {
                if (tableBody) {
                  tableBody.innerHTML = `
                    <tr>
                      <td colspan="9" class="py-12 text-center text-slate-500">
                        No candidate evaluations match your search or filter criteria.
                      </td>
                    </tr>
                  `;
                }
                return;
              }

              if (tableBody) {
                tableBody.innerHTML = evaluationsCache.map(item => {
                  const dateStr = item.created_at ? new Date(item.created_at).toLocaleDateString(undefined, {
                    month: 'short', day: 'numeric', year: 'numeric'
                  }) : 'Recent';

                  const locStr = [item.city, item.country].filter(Boolean).join(', ') || 'Global';
                  const currentStatus = item.status || 'pending';

                  return `
                    <tr class="hover:bg-slate-800/40 transition group">
                      <td class="py-3 px-4 font-mono font-bold text-brand-400">
                        <div class="flex items-center gap-1.5">
                          <span>${item.tracking_id}</span>
                        </div>
                      </td>
                      <td class="py-3 px-4 font-medium text-white">
                        <div class="flex items-center gap-1.5">
                          <span>${item.full_name}</span>
                          ${item.score >= 95 ? '<span class="text-[10px] px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-300 font-bold border border-emerald-500/30">Top</span>' : ''}
                        </div>
                        <div class="text-xs text-slate-400">${item.age ? `${item.age} yrs` : 'Age: -'} • ${item.marital_status || 'Single'}</div>
                      </td>
                      <td class="py-3 px-4 text-xs">
                        <div class="text-slate-200 font-medium">${item.email}</div>
                        <div class="text-slate-400 flex items-center gap-1.5 mt-0.5">
                          <span>${item.phone || '-'}</span>
                          ${(item.emails_sent_count || 0) > 0 
                            ? `<span class="inline-flex items-center gap-0.5 px-1.5 py-0.2 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30" title="${item.emails_sent_count} official email(s) sent">✓ Sent</span>`
                            : `<span class="inline-flex items-center gap-0.5 px-1.5 py-0.2 rounded text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30" title="No email dispatched yet">✉ Not Sent</span>`}
                        </div>
                      </td>
                      <td class="py-3 px-4 text-xs">
                        <div class="text-white font-medium truncate max-w-[180px]" title="${item.matched_job_title || item.job_category || 'Logistics'}">${item.matched_job_title || item.job_category || 'Logistics'}</div>
                        <div class="text-slate-400">${item.experience_years || 'Experienced'}</div>
                      </td>
                      <td class="py-3 px-4 text-xs">
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-brand-950/60 text-brand-300 border border-brand-800/50">
                          ${item.matched_country || 'Europe'}
                        </span>
                      </td>
                      <td class="py-3 px-4 text-xs text-slate-300">
                        <div>${locStr}</div>
                        <div class="text-[11px] font-mono text-slate-500">${item.ip_address || ''}</div>
                      </td>
                      <td class="py-3 px-4 text-xs">
                        <select onchange="updateRowStatus('${item.tracking_id}', this.value)" class="bg-slate-950 border border-slate-800 text-xs font-semibold rounded-lg px-2 py-1 focus:outline-none cursor-pointer">
                          <option value="pending" ${currentStatus === 'pending' ? 'selected' : ''}>Pending</option>
                          <option value="reviewing" ${currentStatus === 'reviewing' ? 'selected' : ''}>In Review</option>
                          <option value="approved" ${currentStatus === 'approved' ? 'selected' : ''}>Approved</option>
                          <option value="docs_requested" ${currentStatus === 'docs_requested' ? 'selected' : ''}>Docs Needed</option>
                          <option value="interview" ${currentStatus === 'interview' ? 'selected' : ''}>Interview</option>
                          <option value="visa_processing" ${currentStatus === 'visa_processing' ? 'selected' : ''}>Visa Prep</option>
                          <option value="rejected" ${currentStatus === 'rejected' ? 'selected' : ''}>Rejected</option>
                        </select>
                      </td>
                      <td class="py-3 px-4 text-xs text-slate-400 whitespace-nowrap">
                        ${dateStr}
                      </td>
                      <td class="py-3 px-4 text-right space-x-1 whitespace-nowrap">
                        ${(item.emails_sent_count || 0) === 0 ? `
                          <button onclick="sendEvaluationCard('${item.tracking_id}', this)" class="px-2 py-1 text-xs rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 transition font-medium cursor-pointer" title="Send Evaluation Card via network@mygotravel.eu">
                            ✉ Send Card
                          </button>
                        ` : `
                          <button onclick="sendEvaluationCard('${item.tracking_id}', this)" class="px-2 py-1 text-xs rounded-lg bg-slate-800 hover:bg-tealbrand-600 text-slate-300 hover:text-white transition font-medium cursor-pointer" title="Resend Evaluation Card via network@mygotravel.eu">
                            Resend Card
                          </button>
                        `}
                        <button onclick="openModal('${item.tracking_id}')" class="px-2.5 py-1 text-xs rounded-lg bg-slate-800 hover:bg-brand-600 text-slate-200 hover:text-white transition font-medium cursor-pointer" title="View Dossier">
                          Dossier
                        </button>
                        <button onclick="quickReply('${item.email}', '${encodeURIComponent(item.full_name || '')}', '${item.tracking_id}')" class="px-2.5 py-1 text-xs rounded-lg bg-slate-800 hover:bg-emerald-600 text-slate-200 hover:text-white transition font-medium cursor-pointer" title="Dispatch custom email">
                          Email
                        </button>
                        <button onclick="deleteRecord('${item.tracking_id}')" class="px-2 py-1 text-xs rounded-lg bg-slate-800 hover:bg-rose-600 text-slate-400 hover:text-white transition cursor-pointer" title="Delete evaluation">
                          ✕
                        </button>
                      </td>
                    </tr>
                  `;
                }).join('');
              }
            } catch (err) {
              console.error('Error fetching evaluations:', err);
              if (tableBody) {
                tableBody.innerHTML = `
                  <tr>
                    <td colspan="9" class="py-8 text-center text-rose-400">
                      Failed to load evaluations: ${err.message}
                    </td>
                  </tr>
                `;
              }
            }
          }

          // Inline Row Status Changer
          window.updateRowStatus = async function(trackingId, newStatus) {
            try {
              const res = await fetch('/api/admin/evaluations', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ trackingId, status: newStatus })
              });
              const data = await res.json();
              if (res.ok && data.success) {
                showToast(`Updated ${trackingId} status to ${newStatus}`);
                loadAnalytics();
              } else {
                showToast(data.error || 'Failed to update status', 'error');
              }
            } catch (err) {
              showToast('Error updating status: ' + err.message, 'error');
            }
          };

          // Dispatch Official Candidate Evaluation Card via SMTP (network@mygotravel.eu)
          window.sendEvaluationCard = async function(trackingId, btnEl) {
            if (!trackingId) return;

            const originalHtml = btnEl ? btnEl.innerHTML : '';
            if (btnEl) {
              btnEl.disabled = true;
              btnEl.innerHTML = `
                <svg class="w-3.5 h-3.5 animate-spin inline-block mr-1" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                <span>Sending...</span>
              `;
            }

            showToast(`Dispatching evaluation card for ${trackingId} via SMTP (network@mygotravel.eu)...`);

            try {
              const res = await fetch('/api/admin/send-evaluation-card', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ trackingId })
              });
              const data = await res.json();

              if (res.ok && data.success) {
                showToast(data.message || `Evaluation card dispatched for ${trackingId}!`);
                loadEvaluations();
                loadSentEmails();
                loadAnalytics();

                // If modal is currently open with this record, reload it to reflect new communications
                if (currentSelectedEval && currentSelectedEval.tracking_id === trackingId) {
                  openModal(trackingId);
                }
              } else {
                showToast(data.error || 'Failed to dispatch evaluation card.', 'error');
              }
            } catch (err) {
              showToast('Error connecting to server: ' + err.message, 'error');
            } finally {
              if (btnEl) {
                btnEl.disabled = false;
                btnEl.innerHTML = originalHtml;
              }
            }
          };

          // Search and Filters Event Handlers
          let searchTimeout = null;
          const searchInput = document.getElementById('eval-search-input');
          const countryFilter = document.getElementById('eval-country-filter');
          const statusFilter = document.getElementById('eval-status-filter');
          const emailFilter = document.getElementById('eval-email-filter');
          const sortBySelect = document.getElementById('eval-sort-by');
          const pageLimitSelect = document.getElementById('eval-page-limit');
          const clearSearchBtn = document.getElementById('btn-clear-search');

          searchInput?.addEventListener('input', (e) => {
            const val = e.target.value.trim();
            if (clearSearchBtn) {
              clearSearchBtn.classList.toggle('hidden', val.length === 0);
            }
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
              currentPage = 1;
              loadEvaluations();
            }, 300);
          });

          clearSearchBtn?.addEventListener('click', () => {
            if (searchInput) searchInput.value = '';
            clearSearchBtn.classList.add('hidden');
            currentPage = 1;
            loadEvaluations();
          });

          countryFilter?.addEventListener('change', () => {
            currentPage = 1;
            loadEvaluations();
          });

          statusFilter?.addEventListener('change', () => {
            currentPage = 1;
            loadEvaluations();
          });

          emailFilter?.addEventListener('change', () => {
            currentPage = 1;
            loadEvaluations();
          });

          sortBySelect?.addEventListener('change', () => {
            currentPage = 1;
            loadEvaluations();
          });

          pageLimitSelect?.addEventListener('change', () => {
            currentPage = 1;
            loadEvaluations();
          });

          document.getElementById('btn-refresh-evals')?.addEventListener('click', () => {
            loadEvaluations();
            showToast('Evaluations list refreshed');
          });

          // Pagination Buttons
          document.getElementById('btn-page-prev')?.addEventListener('click', () => {
            if (currentPage > 1) {
              currentPage--;
              loadEvaluations();
            }
          });

          document.getElementById('btn-page-next')?.addEventListener('click', () => {
            const totalPages = Math.ceil(totalRecords / pageLimit);
            if (currentPage < totalPages) {
              currentPage++;
              loadEvaluations();
            }
          });

          // Export to CSV
          document.getElementById('btn-export-csv')?.addEventListener('click', () => {
            const dest = countryFilter?.value || '';
            const st = statusFilter?.value || 'all';
            let url = `/api/admin/export-csv?`;
            if (dest) url += `destination=${encodeURIComponent(dest)}&`;
            if (st && st !== 'all') url += `status=${encodeURIComponent(st)}&`;
            showToast('Exporting evaluations CSV...');
            window.location.href = url;
          });

          // Open Full Details Modal
          window.openModal = async function(trackingId) {
            const modal = document.getElementById('eval-modal');
            modal?.classList.remove('hidden');

            try {
              const res = await fetch(`/api/admin/evaluations?id=${trackingId}`);
              if (!res.ok) throw new Error('Could not fetch candidate details');
              const item = await res.json();
              currentSelectedEval = item;

              const nameEl = document.getElementById('modal-candidate-name');
              const trackEl = document.getElementById('modal-tracking-id');
              const photoEl = document.getElementById('modal-photo-img');
              const photoPlaceholder = document.getElementById('modal-photo-placeholder');
              const destBadge = document.getElementById('modal-badge-destination');
              const scoreBadge = document.getElementById('modal-badge-score');
              const statusBadge = document.getElementById('modal-badge-status');
              const statusSelect = document.getElementById('modal-status-select');
              const jobEl = document.getElementById('modal-matched-job');
              const procEl = document.getElementById('modal-processing-time');
              const subDateEl = document.getElementById('modal-submitted-date');
              const emailEl = document.getElementById('modal-email');
              const phoneEl = document.getElementById('modal-phone');
              const ageMaritalEl = document.getElementById('modal-age-marital');
              const passEl = document.getElementById('modal-passport');
              const expEl = document.getElementById('modal-experience');
              const cvEl = document.getElementById('modal-cv');
              const addrEl = document.getElementById('modal-address');
              const ipEl = document.getElementById('modal-ip');
              const geoEl = document.getElementById('modal-geo-location');
              const notesEl = document.getElementById('modal-admin-notes');
              const commsList = document.getElementById('modal-communications-list');

              if (nameEl) nameEl.textContent = item.full_name;
              if (trackEl) trackEl.textContent = item.tracking_id;

              if (item.photo_data && photoEl && photoPlaceholder) {
                photoEl.src = item.photo_data;
                photoEl.classList.remove('hidden');
                photoPlaceholder.classList.add('hidden');
              } else if (photoEl && photoPlaceholder) {
                photoEl.classList.add('hidden');
                photoPlaceholder.classList.remove('hidden');
              }

              if (destBadge) destBadge.textContent = item.matched_country || 'European Placement';
              if (scoreBadge) scoreBadge.textContent = `Score: ${item.score || 95}%`;

              const currentStatus = item.status || 'pending';
              if (statusSelect) statusSelect.value = currentStatus;
              if (statusBadge) {
                const conf = statusConfig[currentStatus] || statusConfig.pending;
                statusBadge.textContent = conf.label;
                statusBadge.className = `px-2.5 py-0.5 rounded-full text-xs font-semibold border ${conf.bg}`;
              }

              if (jobEl) jobEl.textContent = item.matched_job_title || item.job_category || 'Logistics & Distribution Lead';
              if (procEl) procEl.textContent = item.matched_processing_time || '2–4 months';
              if (subDateEl) subDateEl.textContent = item.created_at ? new Date(item.created_at).toLocaleString() : 'Recent';
              if (emailEl) emailEl.textContent = item.email;
              if (phoneEl) phoneEl.textContent = item.phone || 'Not provided';
              if (ageMaritalEl) ageMaritalEl.textContent = `${item.age || 'N/A'} years old • Status: ${item.marital_status || 'Single'}`;
              if (passEl) passEl.textContent = item.passport_number || 'Pending Submission';
              if (expEl) expEl.textContent = item.experience_years || 'Experienced Candidate';
              if (cvEl) cvEl.textContent = item.cv_filename || 'Candidate_Resume.pdf';
              if (addrEl) addrEl.textContent = item.address || 'Address on record';
              if (ipEl) ipEl.textContent = `IP: ${item.ip_address || '127.0.0.1'}`;
              if (geoEl) geoEl.textContent = [item.city, item.country].filter(Boolean).join(', ') || 'Global';
              if (notesEl) notesEl.value = item.admin_notes || '';

              // Render communication timeline
              if (commsList) {
                const comms = item.communications || [];
                if (comms.length === 0) {
                  commsList.innerHTML = '<div class="text-slate-500 py-1">No official outbound notices logged for this candidate yet.</div>';
                } else {
                  commsList.innerHTML = comms.map(c => `
                    <div class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-between">
                      <div>
                        <div class="text-white font-medium">${c.subject}</div>
                        <div class="text-slate-500 text-[10px]">${new Date(c.sent_at).toLocaleString()} • ${c.to_email}</div>
                      </div>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-950 text-emerald-300 border border-emerald-800">
                        Dispatched
                      </span>
                    </div>
                  `).join('');
                }
              }
            } catch (err) {
              console.error('Error opening modal:', err);
              showToast('Error opening candidate record: ' + err.message, 'error');
            }
          };

          // Copy Tracking ID
          document.getElementById('btn-copy-tracking')?.addEventListener('click', () => {
            if (currentSelectedEval?.tracking_id) {
              navigator.clipboard.writeText(currentSelectedEval.tracking_id);
              showToast(`Tracking ID copied: ${currentSelectedEval.tracking_id}`);
            }
          });

          // Modal Status Selector Change
          document.getElementById('modal-status-select')?.addEventListener('change', async (e) => {
            if (!currentSelectedEval) return;
            const newStatus = e.target.value;
            try {
              const res = await fetch('/api/admin/evaluations', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ trackingId: currentSelectedEval.tracking_id, status: newStatus })
              });
              const data = await res.json();
              if (res.ok && data.success) {
                currentSelectedEval.status = newStatus;
                const statusBadge = document.getElementById('modal-badge-status');
                if (statusBadge) {
                  const conf = statusConfig[newStatus] || statusConfig.pending;
                  statusBadge.textContent = conf.label;
                  statusBadge.className = `px-2.5 py-0.5 rounded-full text-xs font-semibold border ${conf.bg}`;
                }
                showToast(`Status updated to ${newStatus}`);
                loadEvaluations();
                loadAnalytics();
              } else {
                showToast(data.error || 'Failed to update status', 'error');
              }
            } catch (err) {
              showToast('Network error updating status', 'error');
            }
          });

          // Save Admin Internal Notes
          document.getElementById('btn-save-notes')?.addEventListener('click', async () => {
            if (!currentSelectedEval) return;
            const notes = document.getElementById('modal-admin-notes')?.value || '';
            const statusLabel = document.getElementById('notes-save-status');
            if (statusLabel) statusLabel.textContent = 'Saving...';

            try {
              const res = await fetch('/api/admin/evaluations', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ trackingId: currentSelectedEval.tracking_id, adminNotes: notes })
              });
              const data = await res.json();
              if (res.ok && data.success) {
                if (statusLabel) statusLabel.textContent = 'Saved!';
                setTimeout(() => { if (statusLabel) statusLabel.textContent = ''; }, 2500);
                showToast('Admissions notes saved successfully');
              } else {
                if (statusLabel) statusLabel.textContent = 'Failed';
                showToast(data.error || 'Failed to save notes', 'error');
              }
            } catch (err) {
              if (statusLabel) statusLabel.textContent = 'Error';
              showToast('Error saving notes: ' + err.message, 'error');
            }
          });

          // Inspect CV
          document.getElementById('btn-view-cv')?.addEventListener('click', () => {
            if (!currentSelectedEval) return;
            alert(`Candidate Document Verified:\nFile: ${currentSelectedEval.cv_filename || 'Candidate_Resume.pdf'}\nCandidate: ${currentSelectedEval.full_name}\nTracking: ${currentSelectedEval.tracking_id}\n\nDossier is certified Schengen employment compliant.`);
          });

          // Modal Close
          document.getElementById('btn-close-modal')?.addEventListener('click', () => {
            document.getElementById('eval-modal')?.classList.add('hidden');
            currentSelectedEval = null;
          });

          // Modal Delete
          document.getElementById('modal-btn-delete')?.addEventListener('click', () => {
            if (currentSelectedEval) {
              deleteRecord(currentSelectedEval.tracking_id);
              document.getElementById('eval-modal')?.classList.add('hidden');
            }
          });

          // Modal Send Evaluation Card Button
          document.getElementById('modal-btn-send-card')?.addEventListener('click', async function() {
            if (currentSelectedEval) {
              await window.sendEvaluationCard(currentSelectedEval.tracking_id, this);
            }
          });

          // Modal Reply
          document.getElementById('modal-btn-reply')?.addEventListener('click', () => {
            if (currentSelectedEval) {
              document.getElementById('eval-modal')?.classList.add('hidden');
              quickReply(currentSelectedEval.email, currentSelectedEval.full_name, currentSelectedEval.tracking_id);
            }
          });

          // Quick Reply (switches to Email tab and pre-fills)
          window.quickReply = function(email, name, trackingId) {
            switchTab('email');
            const toEmailInput = document.getElementById('composer-to-email');
            const toNameInput = document.getElementById('composer-to-name');
            const trackingInput = document.getElementById('composer-tracking-id');
            const subjectInput = document.getElementById('composer-subject');
            const messageInput = document.getElementById('composer-message');

            if (toEmailInput) toEmailInput.value = email;
            if (toNameInput) toNameInput.value = decodeURIComponent(name || '');
            if (trackingInput) trackingInput.value = trackingId || '';
            if (subjectInput) subjectInput.value = `Official Update: MyGo Travel Relocation Application [${trackingId}]`;
            if (messageInput) {
              messageInput.value = `Dear ${decodeURIComponent(name || 'Applicant')},\n\nThank you for completing your relocation assessment with MyGo Travel.\n\nWe have successfully reviewed your candidate profile and matched documents for your European relocation program (Reference: ${trackingId}).\n\nOur legal and admissions desk is preparing your employer sponsorship docket. Please reply directly to confirm your readiness for the next consular phase.\n\nBest regards,\nMyGo Travel Admissions Directorate`;
            }
            messageInput?.focus();
          };

          // Delete Record
          window.deleteRecord = async function(trackingId) {
            if (!confirm(`Are you sure you want to delete evaluation ${trackingId}? This action cannot be undone.`)) {
              return;
            }

            try {
              const res = await fetch(`/api/admin/evaluations?id=${trackingId}`, {
                method: 'DELETE'
              });
              const data = await res.json();
              if (res.ok && data.success) {
                showToast(`Evaluation ${trackingId} deleted.`);
                loadEvaluations();
                loadAnalytics();
              } else {
                showToast(data.error || 'Failed to delete evaluation.', 'error');
              }
            } catch (err) {
              showToast('Error connecting to database: ' + err.message, 'error');
            }
          };

          // Fetch Analytics & Geolocation Stats
          async function loadAnalytics() {
            try {
              const res = await fetch('/api/admin/stats');
              if (!res.ok) return;
              const data = await res.json();

              document.getElementById('kpi-evaluations').textContent = data.totals?.evaluations || 0;
              document.getElementById('kpi-pageviews').textContent = data.totals?.pageViews || 0;
              document.getElementById('kpi-unique-visitors').textContent = data.totals?.uniqueVisitors || 1;
              document.getElementById('kpi-emails-sent').textContent = data.totals?.emailsSent || 0;

              // Status Breakdown
              const sMap = {};
              (data.statusBreakdown || []).forEach(s => { sMap[s.status?.toLowerCase()] = parseInt(s.count, 10); });
              if (document.getElementById('stat-status-pending')) document.getElementById('stat-status-pending').textContent = sMap['pending'] || 0;
              if (document.getElementById('stat-status-reviewing')) document.getElementById('stat-status-reviewing').textContent = sMap['reviewing'] || 0;
              if (document.getElementById('stat-status-approved')) document.getElementById('stat-status-approved').textContent = sMap['approved'] || 0;
              if (document.getElementById('stat-status-docs')) document.getElementById('stat-status-docs').textContent = sMap['docs_requested'] || 0;
              if (document.getElementById('stat-status-interview')) document.getElementById('stat-status-interview').textContent = sMap['interview'] || 0;
              if (document.getElementById('stat-status-visa')) document.getElementById('stat-status-visa').textContent = sMap['visa_processing'] || 0;
              if (document.getElementById('stat-status-rejected')) document.getElementById('stat-status-rejected').textContent = sMap['rejected'] || 0;

              // Geo Table
              const geoBody = document.getElementById('geo-breakdown-body');
              if (geoBody) {
                if (!data.geoBreakdown || data.geoBreakdown.length === 0) {
                  geoBody.innerHTML = '<tr><td colspan="2" class="py-4 text-center text-slate-500">No geographic traffic logged yet.</td></tr>';
                } else {
                  geoBody.innerHTML = data.geoBreakdown.map(g => `
                    <tr class="hover:bg-slate-800/30">
                      <td class="py-2 text-white font-medium flex items-center gap-2">
                        <span>${g.country}</span>
                      </td>
                      <td class="py-2 text-right font-mono text-brand-400 font-bold">${g.visitor_count}</td>
                    </tr>
                  `).join('');
                }
              }

              // Pages Table
              const pageBody = document.getElementById('page-breakdown-body');
              if (pageBody) {
                if (!data.pageBreakdown || data.pageBreakdown.length === 0) {
                  pageBody.innerHTML = '<tr><td colspan="2" class="py-4 text-center text-slate-500">No page views recorded yet.</td></tr>';
                } else {
                  pageBody.innerHTML = data.pageBreakdown.map(p => `
                    <tr class="hover:bg-slate-800/30">
                      <td class="py-2 text-slate-300 font-mono text-xs">${p.path}</td>
                      <td class="py-2 text-right font-mono text-emerald-400 font-bold">${p.views}</td>
                    </tr>
                  `).join('');
                }
              }

              // Destination Breakdown
              const destContainer = document.getElementById('destinations-distribution-container');
              if (destContainer) {
                const dests = data.destinationBreakdown || [];
                if (dests.length === 0) {
                  destContainer.innerHTML = '<div class="col-span-full text-center py-6 text-slate-500">No matched destinations recorded yet.</div>';
                } else {
                  const maxCount = Math.max(...dests.map(d => parseInt(d.applicant_count, 10)), 1);
                  destContainer.innerHTML = dests.map(d => {
                    const cnt = parseInt(d.applicant_count, 10);
                    const pct = Math.round((cnt / maxCount) * 100);
                    return `
                      <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-2">
                        <div class="flex items-center justify-between text-xs">
                          <span class="font-bold text-white">${d.destination}</span>
                          <span class="font-mono text-brand-400 font-bold">${cnt}</span>
                        </div>
                        <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
                          <div class="bg-brand-500 h-full rounded-full transition-all duration-500" style="width: ${pct}%"></div>
                        </div>
                      </div>
                    `;
                  }).join('');
                }
              }
            } catch (err) {
              console.error('Analytics load error:', err);
            }
          }

          // Fetch Sent Emails Log
          async function loadSentEmails() {
            const listEl = document.getElementById('sent-emails-list');
            const badgeCount = document.getElementById('badge-email-count');
            try {
              const res = await fetch('/api/admin/sent-emails');
              if (!res.ok) return;
              const data = await res.json();
              sentEmailsCache = data.emails || [];

              if (badgeCount) badgeCount.textContent = sentEmailsCache.length;

              renderSentEmails(sentEmailsCache);
            } catch (err) {
              console.error('Sent emails error:', err);
            }
          }

          function renderSentEmails(emails) {
            const listEl = document.getElementById('sent-emails-list');
            if (!listEl) return;

            if (emails.length === 0) {
              listEl.innerHTML = '<div class="text-center py-8 text-slate-500">No emails dispatched yet.</div>';
              return;
            }

            listEl.innerHTML = emails.map(e => `
              <div onclick="openSentEmailDetail(${e.id})" class="p-3 rounded-xl bg-slate-950 border border-slate-800 hover:border-slate-700 transition cursor-pointer space-y-1">
                <div class="flex items-center justify-between text-[11px]">
                  <span class="font-bold text-white truncate max-w-[170px]">${e.to_email}</span>
                  <span class="text-slate-500">${new Date(e.sent_at).toLocaleDateString()}</span>
                </div>
                <div class="font-medium text-slate-300 text-xs truncate">${e.subject}</div>
                ${e.tracking_id ? `<div class="text-[10px] font-mono text-brand-400">Ref: ${e.tracking_id}</div>` : ''}
                <div class="text-[11px] text-slate-400 line-clamp-2 pt-1 border-t border-slate-900">${e.body.replace(/<[^>]*>?/gm, '')}</div>
              </div>
            `).join('');
          }

          // Filter Sent Emails
          document.getElementById('sent-email-search')?.addEventListener('input', (e) => {
            const val = e.target.value.toLowerCase().trim();
            if (!val) {
              renderSentEmails(sentEmailsCache);
              return;
            }
            const filtered = sentEmailsCache.filter(item => 
              item.to_email?.toLowerCase().includes(val) ||
              item.subject?.toLowerCase().includes(val) ||
              item.tracking_id?.toLowerCase().includes(val)
            );
            renderSentEmails(filtered);
          });

          // Open Sent Email Modal
          window.openSentEmailDetail = function(id) {
            const email = sentEmailsCache.find(e => e.id === id);
            if (!email) return;

            document.getElementById('sent-modal-to').textContent = `${email.to_name ? email.to_name + ' ' : ''}<${email.to_email}>`;
            document.getElementById('sent-modal-date').textContent = new Date(email.sent_at).toLocaleString();
            document.getElementById('sent-modal-tracking').textContent = email.tracking_id || 'N/A';
            document.getElementById('sent-modal-subject').textContent = email.subject;
            document.getElementById('sent-modal-body').textContent = email.body.replace(/<[^>]*>?/gm, '');

            document.getElementById('sent-email-modal')?.classList.remove('hidden');
          };

          document.getElementById('btn-close-sent-modal')?.addEventListener('click', () => {
            document.getElementById('sent-email-modal')?.classList.add('hidden');
          });

          document.getElementById('btn-refresh-sent')?.addEventListener('click', () => {
            loadSentEmails();
            showToast('Sent emails log refreshed');
          });

          // Email Template Selection Handler
          document.getElementById('composer-template-select')?.addEventListener('change', (e) => {
            const val = e.target.value;
            const name = document.getElementById('composer-to-name')?.value || 'Applicant';
            const tracking = document.getElementById('composer-tracking-id')?.value || 'YOUR_TRACKING_ID';
            const subject = document.getElementById('composer-subject');
            const message = document.getElementById('composer-message');
            const cardCheckbox = document.getElementById('composer-send-as-card');

            if (val === 'eval_card') {
              if (cardCheckbox) cardCheckbox.checked = true;
              if (subject) subject.value = `Official Assessment Passed: European Relocation Placement Card [${tracking}]`;
              if (message) message.value = `Dear ${name},\n\nCongratulations! We are pleased to confirm that your profile has been successfully reviewed and verified under the MyGo Travel European Relocation Program.\n\nYour official Candidate Evaluation Card has been issued and attached with certified eligibility for your matched placement.\n\nPlease review your verified placement details below. Contact our admissions directorate via WhatsApp or NicerApp to initiate your consular employer sponsorship docket.\n\nWarm regards,\nMyGo Travel Admissions Directorate`;
            } else if (val === 'congrats') {
              if (cardCheckbox) cardCheckbox.checked = false;
              if (subject) subject.value = `Official Confirmation: European Relocation Match Approved [${tracking}]`;
              if (message) message.value = `Dear ${name},\n\nCongratulations! Your European job placement and relocation assessment (Reference: ${tracking}) has been approved by our partner employers.\n\nAccommodation and meals are officially confirmed in your relocation package. Our admissions directorate will now assist you with consular filing and biometric scheduling.\n\nPlease reply to this email with your current availability for an introductory orientation call.\n\nWarm regards,\nMyGo Travel European Relocation Directorate`;
            } else if (val === 'docs') {
              if (cardCheckbox) cardCheckbox.checked = false;
              if (subject) subject.value = `Document Action Required: International Passport Bio-Data Page [${tracking}]`;
              if (message) message.value = `Dear ${name},\n\nRegarding your European application dossier ${tracking}:\n\nTo ensure swift issuance of your work sponsorship certificate, our legal desk requires a clear, full-page digital copy of your International Passport Bio-Data page.\n\nPlease reply directly to this email attaching the document.\n\nSincerely,\nMyGo Travel Legal & Consular Operations`;
            } else if (val === 'interview') {
              if (cardCheckbox) cardCheckbox.checked = false;
              if (subject) subject.value = `Sponsor Interview Notice: European Employment Placement [${tracking}]`;
              if (message) message.value = `Dear ${name},\n\nWe are pleased to inform you that the European employer review board has requested a brief video interview regarding your application ${tracking}.\n\nPlease let us know your preferred time slot between 10:00 CET and 16:00 CET this week.\n\nBest regards,\nMyGo Travel Operations Team`;
            } else if (val === 'work_permit') {
              if (cardCheckbox) cardCheckbox.checked = false;
              if (subject) subject.value = `Consular Clearance: European Work Permit Issued [${tracking}]`;
              if (message) message.value = `Dear ${name},\n\nGreat news! Your European work permit and government labor clearance has been officially issued for reference ${tracking}.\n\nYour relocation package including guaranteed housing and daily meal provisions is locked in. Please contact your dedicated case manager to finalize travel arrangements and flight dates.\n\nCongratulations,\nMyGo Travel Admissions & Relocation Desk`;
            }
          });

          // Dispatch Email Handler
          document.getElementById('admin-composer-form')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const feedback = document.getElementById('email-feedback');
            const sendBtn = document.getElementById('btn-send-dispatch');

            const to = document.getElementById('composer-to-email')?.value;
            const name = document.getElementById('composer-to-name')?.value;
            const trackingId = document.getElementById('composer-tracking-id')?.value;
            const subject = document.getElementById('composer-subject')?.value;
            const message = document.getElementById('composer-message')?.value;
            const isEvaluationCard = document.getElementById('composer-send-as-card')?.checked;

            if (feedback) feedback.classList.add('hidden');
            if (sendBtn) {
              sendBtn.setAttribute('disabled', 'true');
              sendBtn.innerHTML = 'Sending email...';
            }

            try {
              const res = await fetch('/api/admin/send-email', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ to, name, trackingId, subject, message, isEvaluationCard })
              });
              const data = await res.json();

              if (res.ok && data.success) {
                if (feedback) {
                  feedback.textContent = data.message || `Email successfully dispatched to ${to}!`;
                  feedback.className = 'mb-4 p-3 rounded-xl text-sm bg-emerald-500/10 border border-emerald-500/30 text-emerald-300';
                  feedback.classList.remove('hidden');
                }
                showToast(`Email dispatched to ${to}`);
                loadEvaluations();
                loadSentEmails();
                loadAnalytics();
              } else {
                if (feedback) {
                  feedback.textContent = data.error || 'Failed to dispatch email.';
                  feedback.className = 'mb-4 p-3 rounded-xl text-sm bg-rose-500/10 border border-rose-500/30 text-rose-300';
                  feedback.classList.remove('hidden');
                }
                showToast(data.error || 'Failed to dispatch email', 'error');
              }
            } catch (err) {
              if (feedback) {
                feedback.textContent = 'Network error: ' + err.message;
                feedback.className = 'mb-4 p-3 rounded-xl text-sm bg-rose-500/10 border border-rose-500/30 text-rose-300';
                feedback.classList.remove('hidden');
              }
              showToast('Network error: ' + err.message, 'error');
            } finally {
              if (sendBtn) {
                sendBtn.removeAttribute('disabled');
                sendBtn.innerHTML = `
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                  <span>Dispatch Email</span>
                `;
              }
            }
          });

          document.getElementById('btn-clear-composer')?.addEventListener('click', () => {
            (document.getElementById('admin-composer-form')).reset();
            const feedback = document.getElementById('email-feedback');
            if (feedback) feedback.classList.add('hidden');
          });

          // Initial Page Load
          loadEvaluations();
          loadAnalytics();
          loadSentEmails();
        </script>
      </div>
    )
  }
</Layout>
