---
import Layout from '../layouts/Layout.astro';
import { isAuthenticated } from '../lib/auth';

export const prerender = false;

const authenticated = isAuthenticated(Astro.cookies);
---

<Layout title="MyGo Management Portal · Relocation Admissions Directorate" hideHeaderFooter={true} noindex={true}>
  {
    !authenticated ? (
      /* ================= LOGIN SCREEN ================= */
      <div class="min-h-screen flex items-center justify-center bg-slate-950 px-4 py-12 relative overflow-hidden">
        <!-- Subtle ambient glows -->
        <div class="absolute -top-40 -left-40 w-96 h-96 bg-brand-600/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl p-8 relative z-10">
          <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-brand-600/10 border border-brand-500/20 text-brand-400 mb-4 shadow-inner">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </div>
            <h1 class="text-2xl font-bold text-white tracking-tight">MyGo Travel Portal</h1>
            <p class="text-sm text-slate-400 mt-1">European Relocation Directorate &amp; Admissions Control</p>
          </div>

          <div id="login-error" class="hidden mb-5 p-3 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-sm text-center"></div>

          <form id="admin-login-form" class="space-y-5">
            <div>
              <label for="admin-user" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Username</label>
              <div class="relative">
                <input
                  type="text"
                  id="admin-user"
                  name="username"
                  required
                  autocomplete="username"
                  class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 text-sm transition"
                  placeholder="Enter administrator username"
                />
              </div>
            </div>

            <div>
              <label for="admin-password" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Password</label>
              <div class="relative">
                <input
                  type="password"
                  id="admin-password"
                  name="password"
                  required
                  autocomplete="current-password"
                  class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 text-sm transition"
                  placeholder="Enter administrator password"
                />
              </div>
            </div>

            <button
              type="submit"
              id="login-submit-btn"
              class="w-full bg-brand-600 hover:bg-brand-500 text-white font-semibold py-3 px-4 rounded-xl transition duration-150 flex items-center justify-center gap-2 shadow-lg shadow-brand-600/20 text-sm mt-2 cursor-pointer"
            >
              <span>Authenticate &amp; Open Portal</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>
          </form>

          <div class="mt-6 pt-6 border-t border-slate-800/80 text-center">
            <span class="text-xs text-slate-500 flex items-center justify-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              PostgreSQL Connected: Aiven Cloud DefaultDB
            </span>
          </div>
        </div>

        <script is:inline>
          const form = document.getElementById('admin-login-form');
          const errBox = document.getElementById('login-error');
          const submitBtn = document.getElementById('login-submit-btn');

          form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (errBox) errBox.classList.add('hidden');
            if (submitBtn) {
              submitBtn.setAttribute('disabled', 'true');
              submitBtn.innerHTML = 'Verifying credentials...';
            }

            const username = (document.getElementById('admin-user')).value;
            const password = (document.getElementById('admin-password')).value;

            try {
              const res = await fetch('/api/admin/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
              });
              const data = await res.json();

              if (res.ok && data.success) {
                window.location.reload();
              } else {
                if (errBox) {
                  errBox.textContent = data.error || 'Authentication rejected. Check credentials.';
                  errBox.classList.remove('hidden');
                }
                if (submitBtn) {
                  submitBtn.removeAttribute('disabled');
                  submitBtn.innerHTML = 'Authenticate &amp; Open Portal';
                }
              }
            } catch (err) {
              if (errBox) {
                errBox.textContent = 'Server connection error. Please retry.';
                errBox.classList.remove('hidden');
              }
              if (submitBtn) {
                submitBtn.removeAttribute('disabled');
                submitBtn.innerHTML = 'Authenticate &amp; Open Portal';
              }
            }
          });
        </script>
      </div>
    ) : (
      /* ================= AUTHENTICATED ADMIN CONSOLE ================= */
      <div class="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans selection:bg-brand-600 selection:text-white">
        <!-- Toast Notification Container -->
        <div id="toast-container" class="fixed top-5 right-5 z-50 space-y-3 pointer-events-none"></div>

        <!-- Top Navigation Bar -->
        <header class="bg-slate-900/90 backdrop-blur border-b border-slate-800 sticky top-0 z-40 px-4 lg:px-8 py-3 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-brand-600 flex items-center justify-center font-black text-white text-lg tracking-wider shadow">
              M
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-bold text-white text-base tracking-tight">MyGo Travel</span>
                <span class="text-[10px] uppercase font-bold tracking-widest bg-brand-500/20 text-brand-300 border border-brand-500/30 px-2 py-0.5 rounded">Admin Console</span>
              </div>
              <p class="text-xs text-slate-400">European Admissions &amp; Inquiries Directorate</p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="hidden md:flex items-center gap-2 text-xs bg-emerald-950/40 text-emerald-400 border border-emerald-800/40 px-3 py-1.5 rounded-full">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Aiven PostgreSQL Live</span>
            </div>

            <a href="/" target="_blank" class="hidden sm:inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-white px-2.5 py-1.5 rounded-lg border border-slate-800 hover:border-slate-700 transition">
              <span>View Site</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>

            <a href="/assess" target="_blank" class="hidden sm:inline-flex items-center gap-1.5 text-xs text-brand-400 hover:text-brand-300 px-2.5 py-1.5 rounded-lg border border-brand-900/50 hover:border-brand-700 transition">
              <span>Intake Form</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </a>

            <button id="btn-admin-logout" class="flex items-center gap-1.5 text-xs font-semibold text-rose-400 hover:text-rose-300 bg-rose-950/30 hover:bg-rose-950/50 border border-rose-900/50 px-3 py-1.5 rounded-lg transition cursor-pointer">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
              <span>Sign Out</span>
            </button>
          </div>
        </header>

        <!-- Navigation Tabs -->
        <nav class="bg-slate-900/70 border-b border-slate-800 px-4 lg:px-8 py-2 flex items-center gap-2 overflow-x-auto text-sm">
          <button id="tab-btn-evaluations" class="tab-button active flex items-center gap-2 px-4 py-2 rounded-xl font-medium text-white bg-brand-600 transition shadow cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>Candidate Evaluations</span>
            <span id="badge-eval-count" class="ml-1 px-2 py-0.5 text-xs rounded-full bg-brand-700 font-mono text-white">0</span>
          </button>

          <button id="tab-btn-analytics" class="tab-button flex items-center gap-2 px-4 py-2 rounded-xl font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            <span>Traffic &amp; Geolocation</span>
          </button>

          <button id="tab-btn-email" class="tab-button flex items-center gap-2 px-4 py-2 rounded-xl font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>Email Composer &amp; Dispatches</span>
            <span id="badge-email-count" class="ml-1 px-2 py-0.5 text-xs rounded-full bg-slate-800 font-mono text-slate-300">0</span>
          </button>
        </nav>

        <!-- Main Workspace Body -->
        <main class="flex-grow p-4 lg:p-8 max-w-7xl mx-auto w-full space-y-6">

          <!-- ================= TAB 1: EVALUATIONS INTAKE ================= -->
          <section id="section-evaluations" class="space-y-5">
            <!-- Search, Filters & Action Controls -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl space-y-3">
              <div class="flex flex-col lg:flex-row gap-3 items-stretch lg:items-center justify-between">
                <!-- Search Input -->
                <div class="relative flex-grow max-w-lg">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-500 pointer-events-none">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                  </span>
                  <input
                    type="text"
                    id="eval-search-input"
                    placeholder="Search candidate, tracking ID (mygo...), email, phone, notes..."
                    class="w-full bg-slate-950 border border-slate-800 rounded-xl pl-10 pr-4 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition"
                  />
                  <button id="btn-clear-search" class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-xs text-slate-400 hover:text-white">✕</button>
                </div>

                <!-- Filters & Sorting -->
                <div class="flex flex-wrap items-center gap-2.5">
                  <!-- Destination Filter -->
                  <select id="eval-country-filter" class="bg-slate-950 border border-slate-800 text-slate-300 text-xs rounded-xl px-3 py-2.5 focus:outline-none focus:border-brand-500 cursor-pointer">
                    <option value="">All Destinations</option>
                    <option value="Poland">Poland</option>
                    <option value="Slovakia">Slovakia</option>
                    <option value="Czech Republic">Czech Republic</option>
                    <option value="Lithuania">Lithuania</option>
                    <option value="Bulgaria">Bulgaria</option>
                    <option value="Hungary">Hungary</option>
                    <option value="Portugal">Portugal</option>
                    <option value="Serbia">Serbia</option>
                    <option value="Latvia">Latvia</option>
                    <option value="Croatia">Croatia</option>
                    <option value="Romania">Romania</option>
                  </select>

                  <!-- Status Filter -->
                  <select id="eval-status-filter" class="bg-slate-950 border border-slate-800 text-slate-300 text-xs rounded-xl px-3 py-2.5 focus:outline-none focus:border-brand-500 cursor-pointer">
                    <option value="all">All Statuses</option>
                    <option value="pending">Pending Review</option>
                    <option value="reviewing">In Review</option>
                    <option value="approved">Approved</option>
                    <option value="docs_requested">Docs Requested</option>
                    <option value="interview">Interview Scheduled</option>
                    <option value="visa_processing">Visa Processing</option>
                    <option value="rejected">Rejected</option>
                  </select>

                  <!-- Delivery / Email Filter -->
                  <select id="eval-email-filter" class="bg-slate-950 border border-slate-800 text-slate-300 text-xs rounded-xl px-3 py-2.5 focus:outline-none focus:border-brand-500 cursor-pointer" title="Filter by candidate email status">
                    <option value="all">All Email Status</option>
                    <option value="unsent">✉ Not Sent Yet</option>
                    <option value="sent">✓ Emailed</option>
                  </select>

                  <!-- Sort Selector -->
                  <select id="eval-sort-by" class="bg-slate-950 border border-slate-800 text-slate-300 text-xs rounded-xl px-3 py-2.5 focus:outline-none focus:border-brand-500 cursor-pointer">
                    <option value="newest">Newest First</option>
                    <option value="oldest">Oldest First</option>
                    <option value="score_desc">Highest Score</option>
                    <option value="score_asc">Lowest Score</option>
                    <option value="status">By Status</option>
                  </select>

                  <!-- Export to CSV Button -->
                  <button id="btn-export-csv" class="flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-800 hover:bg-emerald-600/30 text-emerald-400 border border-slate-700 hover:border-emerald-500/50 text-xs font-semibold transition cursor-pointer" title="Export current list to CSV">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    <span>Export CSV</span>
                  </button>

                  <!-- Refresh Button -->
                  <button id="btn-refresh-evals" class="flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition cursor-pointer">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    <span>Refresh</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Evaluations Table Container -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
              <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-300">
                  <thead class="bg-slate-950/90 text-xs font-semibold text-slate-400 uppercase tracking-wider border-b border-slate-800">
                    <tr>
                      <th class="py-3.5 px-4">Tracking ID</th>
                      <th class="py-3.5 px-4">Candidate</th>
                      <th class="py-3.5 px-4">Contact</th>
                      <th class="py-3.5 px-4">Matched Role</th>
                      <th class="py-3.5 px-4">Destination</th>
                      <th class="py-3.5 px-4">Applicant Origin (IP)</th>
                      <th class="py-3.5 px-4">Status</th>
                      <th class="py-3.5 px-4">Submitted</th>
                      <th class="py-3.5 px-4 text-right">Actions</th>
                    </tr>
                  </thead>
                  <tbody id="evaluations-table-body" class="divide-y divide-slate-800/60">
                    <tr>
                      <td colspan="9" class="py-12 text-center text-slate-500">
                        <div class="flex flex-col items-center justify-center gap-2">
                          <svg class="w-8 h-8 animate-spin text-brand-500" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                          </svg>
                          <span>Loading candidate records from Aiven PostgreSQL database...</span>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <!-- Table Footer with Pagination Controls -->
              <div class="bg-slate-950/80 px-4 py-3 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-400">
                <div class="flex items-center gap-3">
                  <div>Showing <span id="table-showing-start" class="text-white font-semibold">0</span>–<span id="table-showing-end" class="text-white font-semibold">0</span> of <span id="table-total-count" class="text-white font-semibold">0</span> records</div>
                  <div class="flex items-center gap-1.5 border-l border-slate-800 pl-3">
                    <span>Per page:</span>
                    <select id="eval-page-limit" class="bg-slate-900 border border-slate-800 rounded px-2 py-0.5 text-white focus:outline-none">
                      <option value="15">15</option>
                      <option value="30">30</option>
                      <option value="50" selected>50</option>
                      <option value="100">100</option>
                    </select>
                  </div>
                </div>

                <!-- Pagination Buttons -->
                <div class="flex items-center gap-2">
                  <button id="btn-page-prev" class="px-3 py-1.5 rounded-lg border border-slate-800 bg-slate-900 hover:bg-slate-800 text-slate-300 disabled:opacity-40 disabled:cursor-not-allowed transition">
                    ← Previous
                  </button>
                  <span id="pagination-page-label" class="px-2 font-mono text-slate-300">Page 1 of 1</span>
                  <button id="btn-page-next" class="px-3 py-1.5 rounded-lg border border-slate-800 bg-slate-900 hover:bg-slate-800 text-slate-300 disabled:opacity-40 disabled:cursor-not-allowed transition">
                    Next →
                  </button>
                </div>
              </div>
            </div>
          </section>

          <!-- ================= TAB 2: ANALYTICS & GEOLOCATION ================= -->
          <section id="section-analytics" class="hidden space-y-6">
            <!-- Stat Cards Row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Applications</span>
                  <span class="p-2 rounded-xl bg-brand-500/10 text-brand-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                  </span>
                </div>
                <div class="text-3xl font-extrabold text-white mt-2" id="kpi-evaluations">0</div>
                <p class="text-xs text-slate-500 mt-1">Full dossiers submitted</p>
              </div>

              <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Site Traffic (Views)</span>
                  <span class="p-2 rounded-xl bg-emerald-500/10 text-emerald-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                  </span>
                </div>
                <div class="text-3xl font-extrabold text-white mt-2" id="kpi-pageviews">0</div>
                <p class="text-xs text-slate-500 mt-1">Total page impressions logged</p>
              </div>

              <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Unique Visitors</span>
                  <span class="p-2 rounded-xl bg-indigo-500/10 text-indigo-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                  </span>
                </div>
                <div class="text-3xl font-extrabold text-white mt-2" id="kpi-unique-visitors">0</div>
                <p class="text-xs text-slate-500 mt-1">Distinct IP addresses tracked</p>
              </div>

              <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Outbound Emails</span>
                  <span class="p-2 rounded-xl bg-amber-500/10 text-amber-400">
