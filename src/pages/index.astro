  <!-- CANDIDATE SUCCESS STORY MODAL -->
  <div 
    id="candidate-story-modal" 
    class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center p-4 transition-opacity"
  >
    <div class="bg-white dark:bg-navy-900 rounded-3xl max-w-lg w-full p-6 sm:p-8 border border-slate-200 dark:border-navy-800 shadow-2xl relative">
      <button 
        id="candidate-story-close" 
        type="button" 
        class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition-colors"
        aria-label="Close story"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>

      <div class="flex items-center gap-4 mb-5">
        <img id="modal-candidate-avatar" src="/images/waleed.jpg" alt="Waleed from Egypt" class="w-16 h-16 rounded-2xl object-cover border border-amber-400" />
        <div>
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/15 text-amber-600 dark:text-amber-400 mb-1">
            Verified Candidate Placement
          </span>
          <h3 id="modal-candidate-name" class="text-lg font-black text-slate-900 dark:text-white">Waleed from Egypt</h3>
          <p id="modal-candidate-role" class="text-xs text-slate-500 dark:text-slate-400">Relocated to Czech Republic · Automotive Assembler</p>
        </div>
      </div>

      <div class="space-y-3.5 text-xs sm:text-sm text-slate-600 dark:text-slate-300 border-t border-slate-100 dark:border-navy-800 pt-4">
        <div class="p-3.5 rounded-2xl bg-[#FAF8F0] dark:bg-navy-950 border border-amber-300/40">
          <p id="modal-candidate-fullstory" class="italic font-serif leading-relaxed text-slate-800 dark:text-slate-100">
            "Arriving in Prague with airport reception and a dedicated MyGo case officer welcoming me directly into employer housing made all the difference. The meals on shift are great and my contract is guaranteed for 2 years."
          </p>
        </div>

        <div class="grid grid-cols-2 gap-3 text-center">
          <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-navy-950 border border-slate-200 dark:border-navy-800">
            <span class="text-[10px] uppercase tracking-wider text-slate-400 block font-bold">Relocation Route</span>
            <span id="modal-candidate-route" class="text-xs font-bold text-tealbrand-600">Czech Republic (Employee Card)</span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-navy-950 border border-slate-200 dark:border-navy-800">
            <span class="text-[10px] uppercase tracking-wider text-slate-400 block font-bold">Monthly Savings</span>
            <span id="modal-candidate-savings" class="text-xs font-bold text-emerald-600">€1,100+ / month</span>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-slate-100 dark:border-navy-800 flex gap-3">
        <a 
          href="/assess" 
          class="flex-1 py-3.5 rounded-xl font-bold text-xs sm:text-sm text-center text-white bg-tealbrand-600 hover:bg-tealbrand-700 shadow-sm transition"
        >
          Begin Free Evaluation
        </a>
      </div>
    </div>
  </div>

</Layout>

<script is:inline>
  // Candidate Story Spotlight Auto-Swipe & Modal
  (() => {
    const candidates = [
      {
        img: '/images/waleed.jpg',
        name: 'Waleed from Egypt',
        role: 'Relocated to Czech Republic · Automotive Assembler',
        quote: '“ Having clean housing arranged before my flight took all the fear out of moving to Europe.”',
        fullStory: 'Arriving in Prague with airport reception and a dedicated MyGo case officer welcoming me directly into employer housing made all the difference. The meals on shift are great and my contract is guaranteed for 2 years.',
        route: 'Czech Republic (Employee Card)',
        savings: '€1,100+ / month'
      },
      {
        img: '/headshot/workers/images.jpg',
        name: 'Amara from Nigeria',
        role: 'Relocated to Poland · Logistics & Inventory Coordinator',
        quote: '“ Employer-provided accommodation was ready when I landed in Warsaw. Everything promised in my contract was honored.”',
        fullStory: 'Poland logistics placement was approved within the stated timeline. Accommodation was ready upon arrival with warm bedding and close to the warehouse depot. My salary and meal allowance have been paid on the exact dates.',
        route: 'Poland (National Type D Work Visa)',
        savings: '€1,250+ / month'
      },
      {
        img: '/headshot/workers/images%20(1).jpg',
        name: 'Elena from Moldova',
        role: 'Relocated to Slovakia · Warehouse & Production Specialist',
        quote: '“ Transparent process from day one. Shift meals and company housing let me save over €1,000 every single month.”',
        fullStory: 'Securing my manufacturing work permit for Slovakia was handled with absolute precision. Transparent from consultation to permit collection. The dorm accommodation and shift canteen meal vouchers are exactly as promised in the contract.',
        route: 'Slovakia (Single Work Permit)',
        savings: '€1,050+ / month'
      },
      {
        img: '/headshot/workers/images%20(14).jpg',
        name: 'David from Nigeria',
        role: 'Relocated to Czech Republic · Industrial Assembly Operator',
        quote: '“ My work permit arrived right on schedule and the on-site supervisor helped me settle into our apartment immediately.”',
        fullStory: 'Good morning and have a wonderful day at work. My experience with the MyGo relocation team was amazing. Thanks MyGo for making this relocation dream a reality. The work permit arrived without delay and my housing was completely organized.',
        route: 'Czech Republic (Industrial Work Permit)',
        savings: '€1,300+ / month'
      }
    ];

    let currentIndex = 0;
    let autoTimer = null;
    const intervalTime = 4500; // 4.5 seconds auto swipe

    const container = document.getElementById('hero-slider-container');
    const track = document.getElementById('hero-slider-track');
    const badge = document.getElementById('hero-slider-badge');
    const dots = document.querySelectorAll('.hero-dot');
    const prevBtn = document.getElementById('hero-slider-prev');
    const nextBtn = document.getElementById('hero-slider-next');
    const cardContent = document.getElementById('hero-candidate-content');
    const quoteEl = document.getElementById('hero-candidate-quote');
    const nameEl = document.getElementById('hero-candidate-name');
    const destEl = document.getElementById('hero-candidate-dest');
    const quoteCard = document.getElementById('hero-quote-card');

    function updateSlide(index) {
      if (!track) return;
      if (index < 0) index = candidates.length - 1;
      if (index >= candidates.length) index = 0;
      currentIndex = index;

      // Smooth slide transform
      track.style.transition = 'transform 600ms cubic-bezier(0.22, 1, 0.36, 1)';
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      // Update badge
      if (badge) {
        badge.textContent = `Verified Story ${currentIndex + 1} of ${candidates.length}`;
      }

      // Update dots
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.className = 'hero-dot w-6 h-1.5 rounded-full bg-amber-400 transition-all duration-300 cursor-pointer';
        } else {
          dot.className = 'hero-dot w-2 h-1.5 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300 cursor-pointer';
        }
      });

      // Synchronize floating card text with smooth crossfade
      if (cardContent) {
        cardContent.style.opacity = '0';
        setTimeout(() => {
          const c = candidates[currentIndex];
          if (quoteEl) quoteEl.textContent = c.quote;
          if (nameEl) nameEl.textContent = c.name;
          if (destEl) destEl.textContent = c.role;
          cardContent.style.opacity = '1';
        }, 180);
      }
    }

    function startAutoSwipe() {
      stopAutoSwipe();
      autoTimer = setInterval(() => {
        updateSlide(currentIndex + 1);
      }, intervalTime);
    }

    function stopAutoSwipe() {
      if (autoTimer) {
        clearInterval(autoTimer);
        autoTimer = null;
      }
    }

    // Arrows navigation
    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      updateSlide(currentIndex - 1);
      startAutoSwipe();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      updateSlide(currentIndex + 1);
      startAutoSwipe();
    });

    // Dot indicators navigation
    dots.forEach(dot => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
        updateSlide(idx);
        startAutoSwipe();
      });
    });

    // Pause on hover
    container?.addEventListener('mouseenter', stopAutoSwipe);
    container?.addEventListener('mouseleave', startAutoSwipe);
    quoteCard?.addEventListener('mouseenter', stopAutoSwipe);
    quoteCard?.addEventListener('mouseleave', startAutoSwipe);

    // Touch swipe support (Mobile & Tablets)
    let touchStartX = 0;
    let touchEndX = 0;

    container?.addEventListener('touchstart', (e) => {
      stopAutoSwipe();
      touchStartX = e.touches[0].clientX;
      touchEndX = touchStartX;
    }, { passive: true });

    container?.addEventListener('touchmove', (e) => {
      touchEndX = e.touches[0].clientX;
    }, { passive: true });

    container?.addEventListener('touchend', () => {
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 45) {
        if (diff > 0) {
          updateSlide(currentIndex + 1);
        } else {
          updateSlide(currentIndex - 1);
        }
      }
      startAutoSwipe();
    });

    // Mouse drag swipe support (Desktop)
    let isMouseDown = false;
    let mouseStartX = 0;
    let mouseEndX = 0;

    container?.addEventListener('mousedown', (e) => {
      if (e.target.closest('button')) return;
      isMouseDown = true;
      mouseStartX = e.clientX;
      mouseEndX = mouseStartX;
      stopAutoSwipe();
    });

    window.addEventListener('mousemove', (e) => {
      if (!isMouseDown) return;
      mouseEndX = e.clientX;
    });

    window.addEventListener('mouseup', () => {
      if (!isMouseDown) return;
      isMouseDown = false;
      const diff = mouseStartX - mouseEndX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) {
          updateSlide(currentIndex + 1);
        } else {
          updateSlide(currentIndex - 1);
        }
      }
      startAutoSwipe();
    });

    // Start auto swiping on page load
    startAutoSwipe();

    // Modal Handling with active candidate story
    const modal = document.getElementById('candidate-story-modal');
    const openBtn = document.getElementById('btn-hero-video');
    const closeBtn = document.getElementById('candidate-story-close');
    const modalAvatar = document.getElementById('modal-candidate-avatar');
    const modalName = document.getElementById('modal-candidate-name');
    const modalRole = document.getElementById('modal-candidate-role');
    const modalFullStory = document.getElementById('modal-candidate-fullstory');
    const modalRoute = document.getElementById('modal-candidate-route');
    const modalSavings = document.getElementById('modal-candidate-savings');

    openBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!modal) return;
      stopAutoSwipe();

      const story = candidates[currentIndex];
      if (modalAvatar) modalAvatar.src = story.img;
      if (modalName) modalName.textContent = story.name;
      if (modalRole) modalRole.textContent = story.role;
      if (modalFullStory) modalFullStory.textContent = `"${story.fullStory}"`;
      if (modalRoute) modalRoute.textContent = story.route;
      if (modalSavings) modalSavings.textContent = story.savings;

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    });

    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      startAutoSwipe();
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        startAutoSwipe();
      }
    });

    // Filter Destination items
    const filterButtons = document.querySelectorAll('.filter-btn');
    const destinationItems = document.querySelectorAll('.destination-item');

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        filterButtons.forEach(btn => {
          btn.classList.remove('bg-tealbrand-600', 'text-white');
          btn.classList.add('text-slate-600', 'dark:text-slate-300');
        });

        button.classList.add('bg-tealbrand-600', 'text-white');
        button.classList.remove('text-slate-600', 'dark:text-slate-300');

        const filterValue = button.getAttribute('data-filter');

        destinationItems.forEach(item => {
          const category = item.getAttribute('data-category');
          if (filterValue === 'all' || category === filterValue) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  })();
</script>
