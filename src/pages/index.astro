  <!-- CANDIDATE PASS TEASER BANNER -->
  <section class="py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl p-8 sm:p-12 bg-navy-900 text-white border border-slate-800 shadow-2xl overflow-hidden flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left">
        
        <div class="max-w-2xl space-y-4">
          <h2 class="text-3xl sm:text-4xl font-black font-serif tracking-tight leading-tight">
            Get Your Digital European Relocation Pass Card
          </h2>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            Complete your intake questionnaire with your background, trade preferences, and travel documents. Our advisors match your profile against current consular quotas and issue an official candidate pass you can submit directly on WhatsApp or NicerApp.
          </p>
        </div>

        <div class="shrink-0">
          <a 
            href="/assess" 
            class="inline-flex items-center gap-2 px-8 py-4 rounded-full font-bold text-base text-white bg-amber-500 hover:bg-amber-600 shadow-md hover:shadow-lg transition-all whitespace-nowrap cursor-pointer"
          >
            <span>Start Candidate Application</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
