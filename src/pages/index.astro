---
import Layout from '../layouts/Layout.astro';
import DestinationCard from '../components/DestinationCard.astro';
import Testimonials from '../components/Testimonials.astro';
import TeamSlider from '../components/TeamSlider.astro';
import StepperPath from '../components/StepperPath.astro';
import JobSearchFilter from '../components/JobSearchFilter.astro';
import RequirementsChecklist from '../components/RequirementsChecklist.astro';
import ConsultationBox from '../components/ConsultationBox.astro';
import HomeFAQ from '../components/HomeFAQ.astro';
import { destinations } from '../data/destinations';

const schengenDestinations = destinations.filter(d => d.category === 'schengen');
const nonSchengenDestinations = destinations.filter(d => d.category === 'non-schengen');
const educationDestinations = destinations.filter(d => d.category === 'education');
---

<Layout 
  title="MyGo Travel · European Jobs with Accommodation & Work Visa Relocation | Official Legal Programs"
  description="Official European work visa, legal relocation, and verified workforce placement agency. Guaranteed jobs in Poland, Czech Republic, Slovakia, Portugal & Germany with employer-provided housing and meals. 9,000+ placed workers. Fast-track 1–3 months."
  keywords="work in europe, live and study in europe reviews, live and work in europe, jobs in europe with housing, jobs in europe with accommodation, easiest eu country to get a job, eures european jobs, eures alternative, schengen work visa, czech republic employee card, poland work visa, slovakia work permit, jobs abroad for foreigners no language required, live and study in europe fake or real, legal european relocation, eu blue card network"
  ogImage="/images/og-share-cover.jpg"
>
  
  <!-- HERO SECTION (Inspired by Reference Screenshot 1) -->
  <section class="relative pt-10 pb-16 sm:pt-16 sm:pb-24 bg-[#FAF8F0] dark:bg-navy-950 border-b border-slate-200/80 dark:border-navy-800 transition-colors overflow-hidden">
    <!-- Ambient glows -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-tealbrand-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
        
        <!-- Left Column: Primary Copy -->
        <div class="lg:col-span-7 text-center lg:text-left">
          
          <!-- Google 5-Star Rating & Founder Trust Pill (Matching Screenshot 1) -->
          <div class="inline-flex items-center gap-3 bg-white dark:bg-navy-900 p-1.5 sm:p-2 pr-4 rounded-full border border-slate-200/80 dark:border-navy-800 shadow-sm mb-6">
            <img 
              src="/headshot/team-1.jpg" 
              alt="Marcus Sterling" 
              class="w-10 h-10 sm:w-11 sm:h-11 rounded-full object-cover border border-amber-400 shrink-0" 
            />
            <div class="text-left">
              <div class="flex items-center gap-1 text-[11px] font-black text-slate-900 dark:text-white">
                <span class="text-[#4285F4] font-bold">G</span><span class="text-[#EA4335] font-bold">o</span><span class="text-[#FBBC05] font-bold">o</span><span class="text-[#4285F4] font-bold">g</span><span class="text-[#34A853] font-bold">l</span><span class="text-[#EA4335] font-bold">e</span>
                <span class="text-amber-400 ml-1">★★★★★</span>
              </div>
              <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">based on 340+ verified candidate reviews</span>
            </div>
          </div>

          <!-- Main Serif Headline (Matching Screenshot 1) -->
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black font-serif tracking-tight text-slate-900 dark:text-white leading-[1.08] mb-6">
            Immigrate to <br/>
            <span class="text-tealbrand-600">Europe Legally</span>
          </h1>

          <!-- Subtitle -->
          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-xl mx-auto lg:mx-0 mb-8 leading-relaxed font-normal">
            Verified employers, embassy-ready documents, visa interview support from the #1 expert — with employer-guaranteed furnished housing and meal stipends.
          </p>

          <!-- Primary Action Buttons -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-10">
            <a 
              href="/assess" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-9 py-4 rounded-full font-black text-sm sm:text-base text-white bg-tealbrand-600 hover:bg-tealbrand-700 shadow-md hover:shadow-lg transition-all duration-150 transform hover:-translate-y-0.5 cursor-pointer"
            >
              <span>Apply Now</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>

            <a 
              href="#jobs" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full font-bold text-sm sm:text-base text-slate-700 dark:text-slate-200 bg-white dark:bg-navy-900 hover:bg-slate-50 dark:hover:bg-navy-800 border border-slate-200 dark:border-navy-800 shadow-sm transition cursor-pointer"
            >
              <span>Select Best Fit Jobs</span>
            </a>
          </div>

          <!-- Fast Highlights -->
          <div class="grid grid-cols-3 gap-4 pt-6 border-t border-slate-200/80 dark:border-navy-800/80 max-w-lg mx-auto lg:mx-0 text-center lg:text-left">
            <div>
              <span class="block text-xl sm:text-2xl font-black text-tealbrand-600">8+ Years</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">Immigration Leadership</span>
            </div>
            <div>
              <span class="block text-xl sm:text-2xl font-black text-amber-500">100% Free</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">Housing &amp; Meals</span>
            </div>
            <div>
              <span class="block text-xl sm:text-2xl font-black text-slate-900 dark:text-white">9,000+</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">Workers Relocated</span>
            </div>
          </div>

        </div>

        <!-- Right Column: Candidate Success Story Spotlight (Matching Screenshot 1) -->
        <div class="lg:col-span-5 relative flex justify-center">
          <div class="relative w-full max-w-md">
            
            <!-- Main Candidate Portrait Photo Carousel / Auto Swipe -->
            <div 
              id="hero-slider-container" 
              class="relative rounded-3xl overflow-hidden border-4 border-white dark:border-navy-800 shadow-2xl bg-slate-200 dark:bg-navy-800 aspect-[4/5] select-none group cursor-grab active:cursor-grabbing touch-pan-y"
              tabindex="0"
              aria-label="Candidate stories slider"
              role="region"
            >
              <!-- Sliding Track -->
              <div 
                id="hero-slider-track" 
                class="flex w-full h-full will-change-transform"
                style="transform: translateX(0%); transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);"
              >
                <!-- Slide 0: Waleed -->
                <div class="w-full h-full shrink-0 relative">
                  <img 
                    src="/images/waleed.jpg" 
                    alt="Waleed from Egypt - Placed in Czech Republic" 
                    class="w-full h-full object-cover filter contrast-105 pointer-events-none"
                    loading="eager"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent pointer-events-none"></div>
                </div>

                <!-- Slide 1: Amara -->
                <div class="w-full h-full shrink-0 relative">
                  <img 
                    src="/headshot/workers/images.jpg" 
                    alt="Amara from Nigeria - Placed in Poland" 
                    class="w-full h-full object-cover filter contrast-105 pointer-events-none"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent pointer-events-none"></div>
                </div>

                <!-- Slide 2: Elena -->
                <div class="w-full h-full shrink-0 relative">
                  <img 
                    src="/headshot/workers/images%20(1).jpg" 
                    alt="Elena from Moldova - Placed in Slovakia" 
                    class="w-full h-full object-cover filter contrast-105 pointer-events-none"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent pointer-events-none"></div>
                </div>

                <!-- Slide 3: David -->
                <div class="w-full h-full shrink-0 relative">
                  <img 
                    src="/headshot/workers/images%20(14).jpg" 
                    alt="David from Nigeria - Placed in Czech Republic" 
                    class="w-full h-full object-cover filter contrast-105 pointer-events-none"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent pointer-events-none"></div>
                </div>
              </div>

              <!-- Top Floating Controls: Status Pill + Indicator Dots -->
              <div class="absolute top-4 left-4 right-4 flex items-center justify-between z-20 pointer-events-none">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-slate-950/65 backdrop-blur-md text-white border border-white/15 shadow-sm">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span id="hero-slider-badge">Verified Story 1 of 4</span>
                </span>
                
                <!-- Dot navigation with active pill animation -->
                <div class="flex items-center gap-1.5 pointer-events-auto bg-slate-950/50 backdrop-blur-md px-2.5 py-1.5 rounded-full border border-white/15 shadow-sm" id="hero-slider-dots">
                  <button type="button" class="hero-dot w-6 h-1.5 rounded-full bg-amber-400 transition-all duration-300 cursor-pointer" data-index="0" aria-label="Go to slide 1"></button>
                  <button type="button" class="hero-dot w-2 h-1.5 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300 cursor-pointer" data-index="1" aria-label="Go to slide 2"></button>
                  <button type="button" class="hero-dot w-2 h-1.5 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300 cursor-pointer" data-index="2" aria-label="Go to slide 3"></button>
                  <button type="button" class="hero-dot w-2 h-1.5 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300 cursor-pointer" data-index="3" aria-label="Go to slide 4"></button>
                </div>
              </div>

              <!-- Prev / Next Navigation Arrows -->
              <button 
                type="button" 
                id="hero-slider-prev"
                class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 rounded-full bg-slate-950/60 hover:bg-slate-950/90 active:scale-90 backdrop-blur-md text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-200 border border-white/20 shadow-lg cursor-pointer transform -translate-x-1 group-hover:translate-x-0"
                aria-label="Previous worker"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
              </button>
              <button 
                type="button" 
                id="hero-slider-next"
                class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 rounded-full bg-slate-950/60 hover:bg-slate-950/90 active:scale-90 backdrop-blur-md text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-200 border border-white/20 shadow-lg cursor-pointer transform translate-x-1 group-hover:translate-x-0"
                aria-label="Next worker"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
              </button>
            </div>

            <!-- Floating Testimonial Quote Card (Matching Screenshot 1) -->
            <div id="hero-quote-card" class="absolute -bottom-6 -left-3 sm:-bottom-8 sm:-left-6 right-3 sm:right-auto z-20 bg-white/95 dark:bg-navy-900/95 backdrop-blur-md rounded-2xl p-4 sm:p-5 border border-slate-200 dark:border-navy-800 shadow-2xl max-w-sm sm:max-w-md text-left transition-all duration-300">
              <div id="hero-candidate-content" class="transition-opacity duration-300">
                <p id="hero-candidate-quote" class="text-xs sm:text-sm font-serif italic text-slate-800 dark:text-slate-100 leading-relaxed min-h-[40px] flex items-center">
                  “ Having clean housing arranged before my flight took all the fear out of moving to Europe.”
                </p>
                <div class="mt-3.5 flex items-center justify-between gap-2">
                  <div>
                    <div id="hero-candidate-name" class="text-xs sm:text-sm font-bold text-amber-500">Waleed from Egypt</div>
                    <div id="hero-candidate-dest" class="text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400">Relocated to Czech Republic · Automotive Assembler</div>
                  </div>
                  <button 
                    type="button" 
                    id="btn-hero-video"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[10px] sm:text-xs font-bold bg-amber-400 text-slate-950 hover:bg-amber-300 shadow-sm transition shrink-0 cursor-pointer active:scale-95"
                  >
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    <span>Watch Story</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Verified Relocation Trust Badge underneath -->
            <div class="flex items-center justify-center gap-2 mt-10 pt-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                Verified Candidate Placement
              </span>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- 4-STEP PATH TIMELINE (Inspired by Screenshot 2) -->
  <StepperPath />


  <!-- SELECT BEST FIT WITH EMPLOYER IN EUROPE (Inspired by Screenshot 2) -->
  <JobSearchFilter />


  <!-- BEFORE YOU START: ESSENTIAL REQUIREMENTS (Inspired by Screenshot 2) -->
  <RequirementsChecklist />


  <!-- DESTINATIONS CATALOG SECTION (`#destinations`) -->
  <section id="destinations" class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-tealbrand-500/10 border border-tealbrand-500/20 text-tealbrand-700 dark:text-tealbrand-400 text-xs font-bold mb-3">
            <span>Official European Quotas</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black font-serif text-slate-900 dark:text-white tracking-tight">
            Work &amp; Relocation Destinations
          </h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm mt-2 max-w-xl">
            Choose from Schengen Zone employment destinations, Fast-Track Non-Schengen programs, or European Student Work Routes.
          </p>
        </div>

        <!-- Filter Tab Buttons -->
        <div class="flex flex-wrap gap-2 p-1.5 rounded-2xl bg-slate-200/80 dark:bg-navy-900 border border-slate-300/80 dark:border-navy-800" id="dest-filters">
          <button class="filter-btn active px-4 py-2 rounded-xl text-xs font-bold text-white bg-tealbrand-600 transition-all cursor-pointer" data-filter="all">
            All Programs ({destinations.length})
          </button>
          <button class="filter-btn px-4 py-2 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-tealbrand-600 transition-all cursor-pointer" data-filter="schengen">
            Schengen ({schengenDestinations.length})
          </button>
          <button class="filter-btn px-4 py-2 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-tealbrand-600 transition-all cursor-pointer" data-filter="non-schengen">
            Fast Entry Non-Schengen ({nonSchengenDestinations.length})
          </button>
          <button class="filter-btn px-4 py-2 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-tealbrand-600 transition-all cursor-pointer" data-filter="education">
            Education Route ({educationDestinations.length})
          </button>
        </div>
      </div>

      <!-- Destinations Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="destinations-grid">
        {destinations.map((destination) => (
          <div class="destination-item" data-category={destination.category}>
            <DestinationCard destination={destination} />
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- HOUSING & MEALS GUARANTEE HIGHLIGHT (`#benefits`) -->
  <section id="benefits" class="py-16 bg-slate-100/70 dark:bg-navy-900/50 border-y border-slate-200 dark:border-navy-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl sm:text-4xl font-extrabold font-serif text-slate-900 dark:text-white">
          Why Job Seekers Choose MyGo Travel
        </h2>
        <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base mt-3">
          Relocating overseas can be daunting. We eliminate your major living expenses so every euro earned can be saved or sent to your family.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Perk 1: Accommodation -->
        <div class="bg-white dark:bg-navy-900 rounded-2xl p-8 border border-slate-200 dark:border-navy-800 shadow-sm relative group hover:border-tealbrand-500 transition-all">
          <div class="w-12 h-12 rounded-xl bg-tealbrand-500/10 text-tealbrand-600 flex items-center justify-center mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
            Provided Accommodation
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Every work package includes fully furnished, clean housing (apartments, employee dormitories, or family units) provided directly or heavily subsidized by your employer.
          </p>
          <div class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-emerald-600 dark:text-emerald-400">
            ✓ Zero rent stress on arrival
          </div>
        </div>

        <!-- Perk 2: Meals -->
        <div class="bg-white dark:bg-navy-900 rounded-2xl p-8 border border-slate-200 dark:border-navy-800 shadow-sm relative group hover:border-amber-500 transition-all">
          <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
            Meals &amp; Food Subsidies
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Employers provide hot canteen meals on shift, meal cards, or monthly tax-free food stipends so you never have to worry about dining costs.
          </p>
          <div class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-emerald-600 dark:text-emerald-400">
            ✓ Canteen access or daily food stipends
          </div>
        </div>

        <!-- Perk 3: Legal Visa & Schengen Access -->
        <div class="bg-white dark:bg-navy-900 rounded-2xl p-8 border border-slate-200 dark:border-navy-800 shadow-sm relative group hover:border-tealbrand-500 transition-all">
          <div class="w-12 h-12 rounded-xl bg-tealbrand-500/10 text-tealbrand-600 flex items-center justify-center mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
            100% Legal Work Permits
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            All positions are certified by national labor ministries. We secure your official European work invitation, embassy booking, and residence permit.
          </p>
          <div class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-emerald-600 dark:text-emerald-400">
            ✓ Genuine government work authorization
          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- CLIENT TESTIMONIALS SECTION -->
  <Testimonials />


  <!-- MEET OUR TEAM SLIDER SECTION (Matching Screenshots) -->
  <TeamSlider />


  <!-- QUICK CONSULTATION LEAD CAPTURE SECTION (Matching Screenshot 1) -->
  <ConsultationBox />


  <!-- FREQUENTLY ASKED QUESTIONS & EUROPEAN WORK GUIDE (Beating EURES & Live and Study) -->
  <HomeFAQ />


  <!-- DEDICATED SUPPORT & HELP DESK HIGHLIGHT (`#contact`) -->
  <section id="contact" class="py-16 sm:py-20 bg-slate-100/80 dark:bg-navy-900/60 border-t border-slate-200 dark:border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white dark:bg-navy-900 rounded-3xl p-8 sm:p-12 border border-slate-200 dark:border-navy-800 shadow-xl flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="max-w-2xl space-y-4 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-tealbrand-500/10 border border-tealbrand-500/20 text-tealbrand-700 dark:text-tealbrand-400 text-xs font-bold">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <span>Dedicated Admissions Support Desk</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold font-serif text-slate-900 dark:text-white tracking-tight">
            Have Questions About Relocation or Your Application?
          </h2>
