---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  hideHeaderFooter?: boolean;
  jsonLd?: Record<string, any>;
}

const { 
  title = "MyGo Travel · European Jobs with Accommodation, Work Permits & Legal Relocation", 
  description = "Official European work visa and legal relocation programs. Guaranteed employment in Poland, Czech Republic, Slovakia, Portugal & across Schengen Europe with employer-provided accommodation and meals. 9,000+ placed workers.",
  keywords = "work in europe, live and study in europe reviews, live and work in europe, jobs in europe with housing, jobs in europe with accommodation, easiest eu country to get a job, eures european jobs, eures alternative, schengen work visa, czech republic employee card, poland work visa, slovakia work permit, jobs abroad for foreigners no language required, live and study in europe fake or real, legal european relocation, eu blue card",
  ogImage = "/images/og-share-cover.jpg",
  ogType = "website",
  canonicalUrl,
  noindex = false,
  hideHeaderFooter = false,
  jsonLd
} = Astro.props;

const siteUrl = "https://mygotravel.eu";
const currentPath = Astro.url.pathname;
const canonical = canonicalUrl || `${siteUrl}${currentPath === '/' ? '' : currentPath}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const organizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EmploymentAgency",
      "@id": "https://mygotravel.eu/#organization",
      "name": "MyGo Travel",
      "alternateName": ["MyGo Travel Europe", "MyGo European Relocation Services"],
      "url": "https://mygotravel.eu",
      "logo": {
        "@type": "ImageObject",
        "@id": "https://mygotravel.eu/#logo",
        "url": "https://mygotravel.eu/Mygo_Travel_Logo.png",
        "caption": "MyGo Travel Official Logo"
      },
      "image": fullOgImage,
      "description": "Premier European immigration, consular visa filing, and legal workforce placement agency specializing in verified employer contracts with guaranteed accommodation and meals.",
      "email": "support@mygotravel.eu",
      "telephone": "+12099493346",
      "priceRange": "€€",
      "areaServed": {
        "@type": "AdministrativeArea",
        "name": "European Union"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "1420",
        "bestRating": "5",
        "worstRating": "1"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "European Work Visa & Relocation Packages",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Czech Republic Employee Card & Automotive Assembly Placement"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Poland Voivodeship Type A Work Permit & Logistics Placement"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Slovakia National D-Visa & Electronics Manufacturing Placement"
            }
          }
        ]
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://mygotravel.eu/#website",
      "url": "https://mygotravel.eu",
      "name": "MyGo Travel",
      "description": "Official European Relocation and Verified Work Visa Agency",
      "publisher": {
        "@id": "https://mygotravel.eu/#organization"
      }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/Mygo_Travel_Icon.png" />
    <link rel="apple-touch-icon" href="/Mygo_Travel_Icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Core Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content="MyGo Travel Europe" />
    <meta name="publisher" content="MyGo Travel Europe" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    <meta name="googlebot" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    <meta name="bingbot" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />

    <!-- Geo & Regional Meta for European Targeting -->
    <meta name="geo.region" content="EU" />
    <meta name="geo.placename" content="European Union" />
    <meta name="theme-color" content="#169B88" />

    <!-- OpenGraph / Facebook / WhatsApp / LinkedIn Meta -->
    <meta property="og:site_name" content="MyGo Travel" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:secure_url" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:type" content="image/jpeg" />

    <!-- Twitter / X Cards Meta -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@mygotravel_eu" />
    <meta name="twitter:creator" content="@mygotravel_eu" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Google Fonts Inter & Playfair Display -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600;1,700&display=swap" rel="stylesheet">

    <!-- Structured Data JSON-LD (Schema.org Organization & Website) -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Anti-flicker Dark Mode Script -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (savedTheme === 'dark' || (!savedTheme && systemDark)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- Site Traffic & Geolocation Analytics Beacon -->
    <script is:inline>
      (function() {
        if (window.location.pathname.startsWith('/nicle')) return;
        try {
          fetch('/api/analytics/pageview', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              path: window.location.pathname,
              title: document.title,
              referrer: document.referrer || ''
            }),
            keepalive: true
          }).catch(function() {});
        } catch(e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 dark:bg-navy-950 text-slate-800 dark:text-slate-100 transition-colors duration-200">
    {!hideHeaderFooter && <Header />}
    <main class={`flex-grow ${hideHeaderFooter ? 'flex flex-col min-h-screen' : ''}`}>
      <slot />
    </main>
    {!hideHeaderFooter && <Footer />}
    {!hideHeaderFooter && <WhatsAppWidget />}
  </body>
</html>
