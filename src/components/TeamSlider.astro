---
import { teamMembers } from '../data/team';
---

<section id="team" class="py-16 sm:py-24 bg-[#FAF7EE] dark:bg-navy-950/80 border-y border-slate-200/80 dark:border-navy-800 relative overflow-hidden transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading matching screenshot -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 sm:mb-12">
      <div>
        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white font-serif tracking-tight leading-tight">
          Meet <span class="text-amber-500 italic">our team</span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-medium mt-2 max-w-xl">
          Experienced European visa attorneys, corporate recruiters, and candidate relocation case officers dedicated to your journey.
        </p>
      </div>

      <!-- Quick Counter Indicator -->
      <div class="hidden sm:flex items-center gap-2 text-xs font-bold text-slate-500 dark:text-slate-400">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>15 Active European Relocation Officers</span>
      </div>
    </div>

    <!-- Carousel Relative Container -->
    <div class="relative group/carousel">
      
      <!-- Prev Button (Teal Circular Icon matching screenshot) -->
      <button 
        type="button" 
        id="team-carousel-prev" 
        aria-label="Previous Team Members"
        class="absolute left-0 sm:-left-3 top-24 sm:top-28 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white flex items-center justify-center shadow-lg transition-all transform hover:scale-110 active:scale-95 cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <!-- Next Button (Teal Circular Icon matching screenshot) -->
      <button 
        type="button" 
        id="team-carousel-next" 
        aria-label="Next Team Members"
        class="absolute right-0 sm:-right-3 top-24 sm:top-28 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white flex items-center justify-center shadow-lg transition-all transform hover:scale-110 active:scale-95 cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </button>

      <!-- Scrollable Track -->
      <div 
        id="team-carousel-track" 
        class="flex gap-6 sm:gap-8 overflow-x-auto scroll-smooth snap-x snap-mandatory py-4 px-2 no-scrollbar"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {teamMembers.map((member) => (
          <div 
            class="snap-start shrink-0 w-60 sm:w-72 flex flex-col items-center text-center group cursor-pointer"
            data-member-id={member.id}
            data-member-name={member.name}
            data-member-role={member.role}
            data-member-img={member.image}
            data-member-exp={member.experience}
            data-member-spec={member.specialization}
            data-member-lang={member.languages.join(', ')}
            data-member-bio={member.bio}
          >
            <!-- Large Circular Portrait Frame -->
            <div class="relative w-44 h-44 sm:w-52 sm:h-52 rounded-full overflow-hidden border-4 border-white dark:border-navy-800 shadow-md group-hover:shadow-xl transition-all duration-300 bg-slate-200 dark:bg-navy-800">
              <img 
                src={member.image} 
                alt={member.name} 
                loading="lazy"
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 rounded-full ring-1 ring-black/5 dark:ring-white/10 pointer-events-none"></div>
            </div>

            <!-- Member Info -->
            <div class="mt-4 flex flex-col items-center">
              <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white tracking-tight group-hover:text-amber-500 transition-colors">
                {member.name}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-medium mt-0.5">
                {member.role}
              </p>
              
              <!-- Eye Icon matching screenshot -->
              <button 
                type="button" 
                class="mt-2 text-slate-400 hover:text-amber-500 dark:text-slate-500 dark:hover:text-amber-400 transition-colors p-1"
                aria-label={`View background for ${member.name}`}
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </button>
            </div>
          </div>
        ))}
      </div>

    </div>

    <!-- Bottom Pill Button: "See all team members" -->
    <div class="text-center mt-10 sm:mt-12">
      <a 
        href="/team" 
        class="inline-flex items-center justify-center gap-2 px-9 py-3.5 rounded-full font-bold text-sm sm:text-base text-white bg-amber-500 hover:bg-amber-600 shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5 cursor-pointer"
      >
        <span>See all team members</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

  </div>

  <!-- TEAM MEMBER DETAIL MODAL -->
  <div 
    id="team-bio-modal" 
    class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center p-4 transition-opacity"
  >
    <div class="bg-white dark:bg-navy-900 rounded-3xl max-w-lg w-full p-6 sm:p-8 border border-slate-200 dark:border-navy-800 shadow-2xl relative transform transition-all">
      <button 
        id="team-modal-close" 
        type="button" 
        class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition-colors"
        aria-label="Close bio"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>

      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 mb-5 text-center sm:text-left">
        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden border-4 border-amber-500/20 shadow-md shrink-0 bg-slate-100 dark:bg-navy-800">
          <img id="modal-img" src="" alt="" class="w-full h-full object-cover object-top" />
        </div>
        <div>
          <div class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-500/15 text-amber-600 dark:text-amber-400 mb-1">
            MyGo Travel Relocation Officer
          </div>
          <h3 id="modal-name" class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white"></h3>
          <p id="modal-role" class="text-sm font-semibold text-slate-600 dark:text-slate-300"></p>
          <p id="modal-exp" class="text-xs text-slate-400 dark:text-slate-500 mt-1"></p>
        </div>
      </div>

      <div class="space-y-3.5 text-xs sm:text-sm text-slate-600 dark:text-slate-300 border-t border-slate-100 dark:border-navy-800 pt-4">
        <div>
          <span class="font-bold text-slate-900 dark:text-white block uppercase tracking-wider text-[11px] mb-1">Specialization</span>
          <p id="modal-spec" class="bg-slate-50 dark:bg-navy-950 p-2.5 rounded-xl border border-slate-200 dark:border-navy-800"></p>
        </div>
        <div>
          <span class="font-bold text-slate-900 dark:text-white block uppercase tracking-wider text-[11px] mb-1">Languages Spoken</span>
          <p id="modal-lang" class="font-medium text-slate-800 dark:text-slate-200"></p>
        </div>
        <div>
          <span class="font-bold text-slate-900 dark:text-white block uppercase tracking-wider text-[11px] mb-1">Advisor Background</span>
          <p id="modal-bio" class="leading-relaxed"></p>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-slate-100 dark:border-navy-800 flex gap-3">
        <a 
          href="/assess" 
          class="flex-1 py-3 rounded-xl font-bold text-xs sm:text-sm text-center text-white bg-amber-500 hover:bg-amber-600 shadow-sm transition"
        >
          Begin Case Evaluation
        </a>
        <a 
          href="/support" 
          class="px-4 py-3 rounded-xl font-bold text-xs sm:text-sm text-center text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-navy-800 hover:bg-slate-200 dark:hover:bg-navy-700 transition"
        >
          Contact Desk
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script is:inline>
  (() => {
    const track = document.getElementById('team-carousel-track');
    const prevBtn = document.getElementById('team-carousel-prev');
    const nextBtn = document.getElementById('team-carousel-next');

    if (track && prevBtn && nextBtn) {
      const scrollStep = 300;

      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -scrollStep, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: scrollStep, behavior: 'smooth' });
      });
    }

    // Modal Handling
    const modal = document.getElementById('team-bio-modal');
    const closeBtn = document.getElementById('team-modal-close');
    const cards = document.querySelectorAll('[data-member-id]');

    const modalImg = document.getElementById('modal-img');
    const modalName = document.getElementById('modal-name');
    const modalRole = document.getElementById('modal-role');
    const modalExp = document.getElementById('modal-exp');
    const modalSpec = document.getElementById('modal-spec');
    const modalLang = document.getElementById('modal-lang');
    const modalBio = document.getElementById('modal-bio');

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        if (!modal) return;
        modalImg.src = card.getAttribute('data-member-img') || '';
        modalImg.alt = card.getAttribute('data-member-name') || '';
        modalName.textContent = card.getAttribute('data-member-name') || '';
        modalRole.textContent = card.getAttribute('data-member-role') || '';
        modalExp.textContent = card.getAttribute('data-member-exp') || '';
        modalSpec.textContent = card.getAttribute('data-member-spec') || '';
        modalLang.textContent = card.getAttribute('data-member-lang') || '';
        modalBio.textContent = card.getAttribute('data-member-bio') || '';

        modal.classList.remove('hidden');
        modal.classList.add('flex');
      });
    });

    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });
  })();
</script>
