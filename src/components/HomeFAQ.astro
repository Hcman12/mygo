---
// FAQ questions specifically optimized for "People Also Ask" and top organic European relocation queries
const faqs = [
  {
    q: "Which country is best to live and work in Europe?",
    a: "The best country depends on your financial and career goals. For maximum net savings and rapid visa processing, the Czech Republic, Poland, and Slovakia are the top choices because partner employers provide free or subsidized housing and shift meals, allowing workers to save €900–€1,400 monthly. For higher gross base wages and long-term permanent residency pathways, Germany, Netherlands, and Portugal are exceptional destinations."
  },
  {
    q: "Which EU country is easiest to immigrate to for foreign workers?",
    a: "Poland, Slovakia, and the Czech Republic offer the most streamlined work permit processes for non-EU/EEA nationals. Poland's Type A Voivodeship work permit and Slovakia's National D-Visa route have higher approval rates and shorter waiting times (typically 6–10 weeks) compared to Western European points-based systems, with established employer quotas for international talent."
  },
  {
    q: "Which EU country is easiest to get a job without speaking the local language?",
    a: "Poland, Czech Republic, and Slovakia have the highest volume of English-friendly entry-level positions in automotive manufacturing, e-commerce logistics (Amazon/DHL/InPost hubs), and electronics assembly. These employers provide multilingual on-site coordinators, eliminating the need to speak Czech, Polish, or Slovak prior to arrival."
  },
  {
    q: "Which country hires the most foreigners in Europe?",
    a: "According to official Eurostat and EURES labor migration data, Poland, Germany, and the Czech Republic issue the highest number of first-time work residence permits to third-country nationals annually. Poland alone issues over 500,000 work permits each year to address domestic labor shortages across industrial, manufacturing, and supply chain sectors."
  },
  {
    q: "Is MyGo Travel legal, real, or a scam? How is employer legitimacy guaranteed?",
    a: "MyGo Travel is a fully registered European legal relocation and workforce placement consultancy operating strictly under European Union labor directives and Schengen consular regulations. Every work contract is legally registered with national ministries of labor before consular filing, with zero illegal fees. Placed candidates receive verified national D-Visas issued directly by official embassies, and have access to our European legal desk and round-the-clock candidate welfare support."
  },
  {
    q: "Are accommodation and meals included in European employment contracts?",
    a: "Yes. Over 85% of our partner employment contracts in the Czech Republic, Poland, Slovakia, and Hungary include employer-provided housing (fully furnished company apartments or modern residences with Wi-Fi and utilities included). Additionally, hot meals are provided during shifts or supplemented by monthly grocery allowances, drastically lowering monthly cost of living."
  },
  {
    q: "What is the typical salary range and monthly savings in Europe?",
    a: "Net take-home earnings typically range from €1,100 to €2,800+ per month depending on the trade, shifts, and overtime. Because accommodation, utilities, and daily work transport are provided by the employer, candidates routinely save between €900 and €1,800 per month to remit to their families."
  },
  {
    q: "How long does the entire relocation process take from application to flight?",
    a: "Fast-track and seasonal logistics positions take approximately 4 to 8 weeks from initial document submission to embassy visa issuance. Long-term technical routes and Employee Card programs in Czechia and Slovakia take between 8 and 12 weeks. Our legal specialists guide you through medical checks, criminal record apostilles, embassy appointments, and airport reception."
  }
];

// Schema.org FAQPage structured data for rich snippet ranking
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<section id="faq" class="py-20 bg-[#FAF8F0] dark:bg-navy-950 border-t border-b border-amber-900/10 transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-tealbrand-50 dark:bg-navy-900 border border-tealbrand-200 dark:border-navy-700 text-tealbrand-700 dark:text-tealbrand-300 mb-3">
        <svg class="w-3.5 h-3.5 text-tealbrand-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
        </svg>
        <span>European Work &amp; Relocation Intelligence</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-slate-900 dark:text-white leading-tight">
        Frequently Asked Questions <span class="text-tealbrand-600">&amp; Insights</span>
      </h2>
      <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-300">
        Everything you need to know about European work permits, housing arrangements, legal compliance, and visa approvals.
      </p>
    </div>

    <!-- FAQ Accordion Container -->
    <div class="space-y-3.5">
      {faqs.map((faq, idx) => (
        <div class="faq-item rounded-2xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 shadow-sm overflow-hidden transition-all duration-200 hover:border-tealbrand-300 dark:hover:border-tealbrand-700">
          <button 
            type="button" 
            class="faq-btn w-full px-5 py-4 sm:px-6 sm:py-5 flex items-center justify-between gap-4 text-left cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-tealbrand-500"
            aria-expanded={idx === 0 ? "true" : "false"}
            aria-controls={`faq-answer-${idx}`}
          >
            <span class="font-serif font-bold text-sm sm:text-base text-slate-900 dark:text-white pr-2">
              {faq.q}
            </span>
            <span class="faq-icon shrink-0 w-8 h-8 rounded-full bg-slate-100 dark:bg-navy-800 flex items-center justify-center text-slate-500 dark:text-slate-400 transition-transform duration-200">
              <svg class="w-4 h-4 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </button>
          
          <div 
            id={`faq-answer-${idx}`} 
            class={`faq-content px-5 sm:px-6 pb-5 pt-1 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-navy-800/60 ${idx === 0 ? 'block' : 'hidden'}`}
          >
            <p>{faq.a}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Still Have Questions CTA Box -->
    <div class="mt-12 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-tealbrand-900 to-slate-950 text-white border border-tealbrand-700/30 text-center relative overflow-hidden shadow-xl">
      <div class="absolute -top-24 -right-24 w-60 h-60 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 max-w-xl mx-auto">
        <h3 class="text-lg sm:text-xl font-serif font-bold mb-2">Have a specific question about your nationality or trade?</h3>
        <p class="text-xs sm:text-sm text-slate-300 mb-6">
          Our accredited European consular advisors evaluate your CV, destination fit, and embassy eligibility free of charge.
        </p>
        <div class="flex flex-wrap justify-center items-center gap-3">
          <a 
            href="/assess" 
            class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-amber-400 text-slate-950 hover:bg-amber-300 shadow-md transition transform hover:-translate-y-0.5"
          >
            Check Eligibility in 2 Minutes
          </a>
          <a 
            href="/support" 
            class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-white/10 hover:bg-white/20 border border-white/20 text-white transition"
          >
            Contact Admissions Desk
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- JSON-LD FAQPage Schema Markup for Google Rich Snippets -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<script is:inline>
  // FAQ Interactive Accordion
  document.addEventListener('DOMContentLoaded', () => {
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach(item => {
      const btn = item.querySelector('.faq-btn');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon svg');

      btn?.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        // Close all other items
        faqItems.forEach(otherItem => {
          if (otherItem !== item) {
            const otherBtn = otherItem.querySelector('.faq-btn');
            const otherContent = otherItem.querySelector('.faq-content');
            const otherIcon = otherItem.querySelector('.faq-icon svg');
            otherBtn?.setAttribute('aria-expanded', 'false');
            otherContent?.classList.add('hidden');
            otherIcon?.classList.remove('rotate-180');
          }
        });

        // Toggle current item
        if (isExpanded) {
          btn.setAttribute('aria-expanded', 'false');
          content?.classList.add('hidden');
          icon?.classList.remove('rotate-180');
        } else {
          btn.setAttribute('aria-expanded', 'true');
          content?.classList.remove('hidden');
          icon?.classList.add('rotate-180');
        }
      });
    });
  });
</script>
