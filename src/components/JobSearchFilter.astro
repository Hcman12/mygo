---

<section id="jobs" class="py-16 sm:py-24 bg-[#FAF8F0] dark:bg-navy-950 border-b border-slate-200/80 dark:border-navy-800 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title (Matching Screenshot 2) -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
      <h2 class="text-3xl sm:text-5xl font-black font-serif tracking-tight leading-tight">
        <span class="text-tealbrand-600 block sm:inline">Select Best Fit</span>
        <span class="text-slate-900 dark:text-white block sm:inline">with Employer in Europe</span>
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-medium mt-3">
        Filter through active bilateral European employer quotas with guaranteed accommodation and meal plans.
      </p>
    </div>

    <!-- Filter Bar Card (Matching Screenshot 2) -->
    <div class="max-w-5xl mx-auto">
      <div class="bg-white dark:bg-navy-900 p-4 sm:p-6 rounded-3xl border border-slate-200 dark:border-navy-800 shadow-lg">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-5">
          
          <!-- Dropdown 1: Country -->
          <div class="relative">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5 ml-1">
              Destination Country
            </label>
            <div class="relative">
              <select 
                id="filter-country" 
                class="w-full appearance-none bg-slate-50 dark:bg-navy-950 border-2 border-tealbrand-500/40 hover:border-tealbrand-500 focus:border-tealbrand-600 rounded-2xl px-4 py-3.5 text-sm font-semibold text-slate-800 dark:text-slate-100 focus:outline-none transition cursor-pointer"
              >
                <option value="all">All European Countries</option>
                <option value="Montenegro">Montenegro</option>
                <option value="Slovakia">Slovakia (Schengen)</option>
                <option value="Poland">Poland (Schengen)</option>
                <option value="Czech Republic">Czech Republic (Schengen)</option>
                <option value="Lithuania">Lithuania (Schengen)</option>
                <option value="Portugal">Portugal (Schengen)</option>
                <option value="Serbia">Serbia (Fast-Track 1–2 mo)</option>
                <option value="North Macedonia">North Macedonia (Fast-Track)</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-tealbrand-600">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
          </div>

          <!-- Dropdown 2: Job Role -->
          <div class="relative">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5 ml-1">
              Job Position / Trade
            </label>
            <div class="relative">
              <select 
                id="filter-role" 
                class="w-full appearance-none bg-slate-50 dark:bg-navy-950 border-2 border-tealbrand-500/40 hover:border-tealbrand-500 focus:border-tealbrand-600 rounded-2xl px-4 py-3.5 text-sm font-semibold text-slate-800 dark:text-slate-100 focus:outline-none transition cursor-pointer"
              >
                <option value="all">All Available Trades</option>
                <option value="hospitality">Hotel Staff Assistant &amp; Service</option>
                <option value="logistics">Warehouse Operative &amp; Order Picker</option>
                <option value="manufacturing">Automotive Assembly &amp; Production</option>
                <option value="food">Food Processing &amp; Packaging</option>
                <option value="agriculture">Agricultural Logistics &amp; Farming</option>
                <option value="construction">Construction &amp; Technical Trades</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-tealbrand-600">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
          </div>

          <!-- Dropdown 3: Salary -->
          <div class="relative">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5 ml-1">
              Salary Expectation
            </label>
            <div class="relative">
              <select 
                id="filter-salary" 
                class="w-full appearance-none bg-slate-50 dark:bg-navy-950 border-2 border-tealbrand-500/40 hover:border-tealbrand-500 focus:border-tealbrand-600 rounded-2xl px-4 py-3.5 text-sm font-semibold text-slate-800 dark:text-slate-100 focus:outline-none transition cursor-pointer"
              >
                <option value="all">Any Monthly Remuneration</option>
                <option value="1000-1650">1,000 – 1,650 EUR / month</option>
                <option value="1300-2000">1,300 – 2,000 EUR / month</option>
                <option value="1500+">1,500+ EUR / month</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-tealbrand-600">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
          </div>

        </div>

        <!-- Button matching Screenshot 2: Triggers Popup Modal -->
        <div class="text-center pt-2">
          <button 
            type="button" 
            id="btn-open-jobs-modal" 
            class="inline-flex items-center justify-center gap-2 px-10 py-3.5 rounded-full font-bold text-sm sm:text-base text-white bg-amber-400 hover:bg-amber-500 shadow-md hover:shadow-lg transition-all duration-150 transform hover:-translate-y-0.5 cursor-pointer"
          >
            <span>See Jobs</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </div>
      </div>
    </div>

  </div>

  <!-- POPUP MODAL FOR JOBS RESULTS (Matching User Request) -->
  <div 
    id="jobs-result-modal" 
    class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center p-4 transition-opacity"
  >
    <div class="bg-white dark:bg-navy-900 rounded-3xl max-w-2xl w-full p-6 sm:p-8 border border-slate-200 dark:border-navy-800 shadow-2xl relative max-h-[88vh] flex flex-col transform transition-all">
      
      <!-- Close Button -->
      <button 
        id="jobs-modal-close" 
        type="button" 
        class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition-colors cursor-pointer"
        aria-label="Close jobs modal"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>

      <!-- Modal Header -->
      <div class="mb-4 pr-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-400 text-xs font-bold mb-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Verified European Employer Contracts</span>
        </div>
        <h3 id="modal-jobs-title" class="text-xl sm:text-2xl font-black font-serif text-slate-900 dark:text-white">
          Matched European Vacancies
        </h3>
        <p id="modal-jobs-subtitle" class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Showing active positions with employer-provided accommodation and meal plans.
        </p>
      </div>

      <!-- Scrollable Results Container -->
      <div id="modal-jobs-list" class="overflow-y-auto space-y-3.5 pr-1.5 flex-1 my-2">
        <!-- Javascript dynamically inserts filtered cards here -->
      </div>

      <!-- Modal Footer -->
      <div class="pt-4 mt-3 border-t border-slate-100 dark:border-navy-800 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-tealbrand-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <span>All packages include verified work permits &amp; housing</span>
        </div>
        <a 
          href="/assess" 
          class="w-full sm:w-auto px-6 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-white bg-tealbrand-600 hover:bg-tealbrand-700 shadow-md transition text-center"
        >
          Begin Candidate Assessment
        </a>
      </div>

    </div>
  </div>
</section>

<script is:inline define:vars={{ allJobs }}>
  (() => {
    const countrySelect = document.getElementById('filter-country');
    const roleSelect = document.getElementById('filter-role');
    const salarySelect = document.getElementById('filter-salary');
    const openBtn = document.getElementById('btn-open-jobs-modal');

    const modal = document.getElementById('jobs-result-modal');
    const closeBtn = document.getElementById('jobs-modal-close');
    const modalTitle = document.getElementById('modal-jobs-title');
    const modalSubtitle = document.getElementById('modal-jobs-subtitle');
    const modalList = document.getElementById('modal-jobs-list');

    function filterAndShowJobs() {
      if (!modal || !modalList) return;

      const selectedCountry = countrySelect?.value || 'all';
      const selectedRole = roleSelect?.value || 'all';
      const selectedSalary = salarySelect?.value || 'all';

      const filtered = allJobs.filter((job) => {
        const matchCountry = selectedCountry === 'all' || job.country.toLowerCase() === selectedCountry.toLowerCase();
        const matchRole = selectedRole === 'all' || job.category.toLowerCase() === selectedRole.toLowerCase();
        let matchSalary = true;
        if (selectedSalary === '1000-1650') matchSalary = job.salaryMin <= 1300;
        if (selectedSalary === '1300-2000') matchSalary = job.salaryMin >= 1200;
        if (selectedSalary === '1500+') matchSalary = job.salaryMin >= 1400;

        return matchCountry && matchRole && matchSalary;
      });

      // Update titles
      const countryLabel = selectedCountry === 'all' ? 'All European Corridors' : selectedCountry;
      if (modalTitle) modalTitle.textContent = `Active Vacancies: ${countryLabel}`;
      if (modalSubtitle) modalSubtitle.textContent = `Found ${filtered.length} positions with employer-guaranteed accommodation & meals.`;

      // Render cards into modal
      modalList.innerHTML = '';

      if (filtered.length === 0) {
        modalList.innerHTML = `
          <div class="p-8 text-center bg-slate-50 dark:bg-navy-950 rounded-2xl border border-slate-200 dark:border-navy-800">
            <div class="w-12 h-12 rounded-full bg-amber-500/10 text-amber-500 mx-auto flex items-center justify-center mb-3">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h4 class="font-bold text-slate-900 dark:text-white text-base mb-1">Custom Allocation Available</h4>
            <p class="text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto mb-4">
              We frequently open new employer quotas for ${countryLabel}. Start your evaluation and an admissions counselor will match your profile directly.
            </p>
            <a href="/assess" class="inline-flex px-6 py-2.5 rounded-xl font-bold text-xs text-white bg-amber-500 hover:bg-amber-600 transition">
              Submit Direct Application
            </a>
          </div>
        `;
      } else {
        filtered.forEach((job) => {
          const cardEl = document.createElement('div');
          cardEl.className = 'p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-navy-950 border border-slate-200 dark:border-navy-800 hover:border-tealbrand-500/50 transition flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-sm';
          cardEl.innerHTML = `
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 text-slate-800 dark:text-slate-200">
                  <span>${job.flag}</span>
                  <span>${job.country}</span>
                </span>
                <span class="text-[10px] font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  ${job.spots}
                </span>
              </div>
              <h4 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-snug">
                ${job.role}
              </h4>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                ${job.type} · <strong class="text-slate-700 dark:text-slate-300 font-semibold">${job.contract}</strong>
              </p>
              <div class="flex flex-wrap gap-1.5 mt-2">
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400">
                  ✓ Housing Covered
                </span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-700 dark:text-amber-400">
                  ✓ Meals Included
                </span>
              </div>
            </div>

            <div class="shrink-0 text-left sm:text-right w-full sm:w-auto flex sm:flex-col items-center sm:items-end justify-between gap-2 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-200 dark:border-navy-800">
              <div class="text-base sm:text-lg font-black text-amber-500">
                ${job.salary}
              </div>
              <a 
                href="/assess" 
                class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-tealbrand-600 hover:bg-tealbrand-700 transition inline-flex items-center gap-1"
              >
                <span>Apply</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            </div>
          `;
          modalList.appendChild(cardEl);
        });
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    openBtn?.addEventListener('click', filterAndShowJobs);

    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });
  })();
</script>
