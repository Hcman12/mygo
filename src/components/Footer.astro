---
---

<footer class="bg-slate-900 text-slate-300 dark:bg-navy-950 border-t border-slate-800 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      
      <!-- Brand & Mission Column (Span 2) -->
      <div class="lg:col-span-2 space-y-5">
        <a href="/" class="inline-block">
          <img 
            src="/Mygo_Travel_Logo_White.png" 
            alt="MyGo Travel" 
            class="h-10 w-auto object-contain"
          />
        </a>
        <p class="text-sm text-slate-400 leading-relaxed max-w-md">
          MyGo Travel is your accredited visa & relocation partner connecting motivated candidates to guaranteed European employment packages with employer-provided accommodation and meal plans.
        </p>
        
        <!-- Live Badges -->
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand-500/15 text-brand-400 border border-brand-500/30">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            Accommodation Included
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            Meal Plan Covered
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/15 text-blue-400 border border-blue-500/30">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            Schengen Certified
          </span>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Schengen Hubs</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/#destinations" class="hover:text-brand-400 transition-colors">Poland</a></li>
          <li><a href="/#destinations" class="hover:text-brand-400 transition-colors">Czech Republic</a></li>
          <li><a href="/#destinations" class="hover:text-brand-400 transition-colors">Lithuania</a></li>
          <li><a href="/#destinations" class="hover:text-brand-400 transition-colors">Portugal</a></li>
          <li><a href="/#destinations" class="hover:text-brand-400 transition-colors">Slovakia</a></li>
          <li><a href="/#destinations" class="hover:text-brand-400 transition-colors">Bulgaria & Latvia</a></li>
        </ul>
      </div>

      <!-- Fast Entry & Routes -->
      <div>
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Fast Entry & Study</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/#destinations" class="hover:text-brand-400 transition-colors">Serbia (1–2 months)</a></li>
          <li><a href="/#destinations" class="hover:text-brand-400 transition-colors">Ukraine (~1 month)</a></li>
          <li><a href="/#destinations" class="hover:text-brand-400 transition-colors">North Macedonia (2 months)</a></li>
          <li><a href="/#destinations" class="hover:text-brand-400 transition-colors">Portugal Student Route</a></li>
          <li><a href="/assess" class="text-brand-400 font-semibold hover:underline">Candidate Eligibility Form →</a></li>
          <li><a href="/support" class="text-emerald-400 font-semibold hover:underline">Support &amp; Help Desk →</a></li>
          <li><a href="/team" class="text-amber-400 font-semibold hover:underline">Meet Our Team (15 Officers) →</a></li>
        </ul>
      </div>

      <!-- Official Contact & Agent Chat -->
      <div id="contact" class="space-y-3">
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Direct Contact</h4>
        
        <div class="text-sm space-y-2.5">
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href="mailto:support@mygotravel.eu" class="hover:text-white transition-colors font-medium">support@mygotravel.eu</a>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <a href="/support" class="hover:text-white transition-colors">Help Center &amp; Inquiries</a>
          </p>
        </div>

        <div class="pt-2 space-y-2">
          <!-- WhatsApp Button -->
          <a 
            href="https://wa.me/12099493346?text=hi%20go%20travel%20i%20have%20an%20inquiry%20regarding%20work%20visa%20and%20relocation" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 hover:bg-emerald-600/30 transition-colors w-full"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Chat on WhatsApp</span>
          </a>

          <!-- NicerApp Button -->
          <a 
            href="https://nicerapp.cloud/invite/cd0452e9-e0be-4f0d-9fde-2aaa865c4e01" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-brand-500/20 text-brand-400 border border-brand-500/30 hover:bg-brand-500/30 transition-colors w-full"
          >
            <img src="/nicerapplogo.png" alt="NicerApp" class="w-4 h-4 object-contain rounded-full shrink-0" />
            <span>Chat on NicerApp</span>
          </a>
        </div>

      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© 2026 MyGo Travel. All rights reserved. Work & Relocation Destinations 2026.</p>
      <div class="flex items-center gap-6">
        <span>Verified Employer Network</span>
        <span>Schengen & EU Relocation</span>
        <a href="/assess" class="text-brand-400 hover:underline font-semibold">Candidate Relocation Portal</a>
        <a href="/nicle" class="hover:text-slate-400 transition-colors flex items-center gap-1 opacity-70 hover:opacity-100" title="Staff Admissions Directorate">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          <span>Staff Portal</span>
        </a>
      </div>
    </div>
  </div>
</footer>
