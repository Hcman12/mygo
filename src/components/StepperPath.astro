---
---

<section id="process" class="py-16 sm:py-24 bg-white dark:bg-navy-900 border-b border-slate-200/80 dark:border-navy-800 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Inspired by Screenshot 2) -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <h2 class="text-3xl sm:text-5xl font-black font-serif tracking-tight leading-tight">
        <span class="text-tealbrand-600 block sm:inline">Your 4-Step Path to a</span>
        <span class="text-slate-900 dark:text-white block sm:inline">Legal Job in Europe</span>
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-medium mt-3 max-w-xl mx-auto">
        A clear, certified process backed by bilateral European employer quotas with accommodation and meal coverage.
      </p>
    </div>

    <!-- Stepper Grid with Connected Horizontal Line on Desktop -->
    <div class="relative">
      
      <!-- Connecting Line (Desktop) -->
      <div class="hidden lg:block absolute top-4 left-[12%] right-[12%] h-0.5 bg-amber-200 dark:bg-amber-500/20 z-0"></div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6 relative z-10">
        
        <!-- STEP 1 -->
        <div class="flex flex-col items-center text-center group">
          <!-- Number Badge -->
          <div class="w-8 h-8 rounded-full bg-amber-400 text-white font-extrabold text-sm flex items-center justify-center shadow-md mb-4 ring-4 ring-white dark:ring-navy-900 group-hover:scale-110 transition-transform">
            1
          </div>
          <!-- Icon Card -->
          <div class="w-20 h-20 rounded-2xl bg-amber-50 dark:bg-navy-800/80 border border-amber-200/60 dark:border-navy-700 flex items-center justify-center mb-4 shadow-sm group-hover:border-amber-400 transition-all">
            <svg class="w-10 h-10 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <!-- Content -->
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white mb-2">
            Eligibility Check &amp; Job Match
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-xs">
            Submit your background, select trade preferences, and get matched with verified host employers in Europe.
          </p>
        </div>

        <!-- STEP 2 -->
        <div class="flex flex-col items-center text-center group">
          <!-- Number Badge -->
          <div class="w-8 h-8 rounded-full bg-amber-400 text-white font-extrabold text-sm flex items-center justify-center shadow-md mb-4 ring-4 ring-white dark:ring-navy-900 group-hover:scale-110 transition-transform">
            2
          </div>
          <!-- Icon Card -->
          <div class="w-20 h-20 rounded-2xl bg-amber-50 dark:bg-navy-800/80 border border-amber-200/60 dark:border-navy-700 flex items-center justify-center mb-4 shadow-sm group-hover:border-amber-400 transition-all">
            <svg class="w-10 h-10 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <!-- Content -->
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white mb-2">
            Work Permit &amp; Document Prep
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-xs">
            Our legal desk handles state labor certifications, certified apostilles, employer sponsorship letters, and legal filings.
          </p>
        </div>

        <!-- STEP 3 -->
        <div class="flex flex-col items-center text-center group">
          <!-- Number Badge -->
          <div class="w-8 h-8 rounded-full bg-amber-400 text-white font-extrabold text-sm flex items-center justify-center shadow-md mb-4 ring-4 ring-white dark:ring-navy-900 group-hover:scale-110 transition-transform">
            3
          </div>
          <!-- Icon Card -->
          <div class="w-20 h-20 rounded-2xl bg-amber-50 dark:bg-navy-800/80 border border-amber-200/60 dark:border-navy-700 flex items-center justify-center mb-4 shadow-sm group-hover:border-amber-400 transition-all">
            <svg class="w-10 h-10 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <!-- Content -->
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white mb-2">
            Visa Interview
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-xs">
            We book your embassy appointment and conduct biometric dossier review and mock interviews for a 98% approval rate.
          </p>
        </div>

        <!-- STEP 4 -->
        <div class="flex flex-col items-center text-center group">
          <!-- Number Badge -->
          <div class="w-8 h-8 rounded-full bg-amber-400 text-white font-extrabold text-sm flex items-center justify-center shadow-md mb-4 ring-4 ring-white dark:ring-navy-900 group-hover:scale-110 transition-transform">
            4
          </div>
          <!-- Icon Card -->
          <div class="w-20 h-20 rounded-2xl bg-amber-50 dark:bg-navy-800/80 border border-amber-200/60 dark:border-navy-700 flex items-center justify-center mb-4 shadow-sm group-hover:border-amber-400 transition-all">
            <svg class="w-10 h-10 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <!-- Content -->
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white mb-2">
            Arrival &amp; Support
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-xs">
            Airport reception in Europe, check-in to your furnished accommodation, meal allowance orientation, and start your job!
          </p>
        </div>

      </div>
    </div>

  </div>
</section>
