---
import type { Destination } from '../data/destinations';
import CountryFlag from './CountryFlag.astro';

interface Props {
  destination: Destination;
}

const { destination } = Astro.props;

// Category styling
const categoryBadgeColors: Record<string, string> = {
  'schengen': 'bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/60 dark:text-blue-300 dark:border-blue-800',
  'non-schengen': 'bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800',
  'education': 'bg-purple-50 text-purple-700 border-purple-200 dark:bg-purple-950/60 dark:text-purple-300 dark:border-purple-800',
};
---

<div class={`relative group rounded-2xl p-6 transition-all duration-200 flex flex-col justify-between bg-white dark:bg-navy-900 border ${
  destination.featured 
    ? 'border-brand-500/50 shadow-sm hover:shadow-md hover:border-brand-500' 
    : 'border-slate-200 dark:border-navy-800 shadow-sm hover:border-slate-300 dark:hover:border-navy-700 hover:shadow-md'
}`}>

  <!-- Real Destination Cover Photography -->
  <div class="relative h-48 -mx-6 -mt-6 mb-4 overflow-hidden rounded-t-2xl bg-slate-200 dark:bg-navy-800">
    <img 
      src={`/images/destinations/${destination.id}.jpg`} 
      alt={`${destination.country} European relocation opportunity`}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
    
    <!-- Tag badge if available -->
    {destination.tag && (
      <div class="absolute top-3 right-3 z-10">
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-brand-500 text-white shadow-md">
          <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <span>{destination.tag}</span>
        </span>
      </div>
    )}

    <!-- Bottom overlay on image: Flag + Country name + Category -->
    <div class="absolute bottom-3 left-4 right-4 flex items-end justify-between z-10">
      <div class="flex items-center gap-2.5">
        <CountryFlag id={destination.id} country={destination.country} size="md" class="rounded shadow-md ring-1 ring-white/30" />
        <h3 class="text-xl font-black text-white tracking-tight drop-shadow-sm">
          {destination.country}
        </h3>
      </div>
      <span class={`inline-block text-[11px] font-bold px-2.5 py-0.5 rounded-full shadow-sm ${categoryBadgeColors[destination.category]}`}>
        {destination.categoryLabel}
      </span>
    </div>
  </div>

  <div>

    <!-- Description -->
    <p class="text-xs text-slate-600 dark:text-slate-400 mb-5 line-clamp-2 leading-relaxed">
      {destination.description}
    </p>

    <!-- Key Metrics Grid: Processing Time & Inquiry Details -->
    <div class="grid grid-cols-2 gap-2.5 p-3.5 rounded-2xl bg-slate-100/80 dark:bg-navy-950/80 border border-slate-200/80 dark:border-navy-800/80 mb-5">
      <div>
        <span class="block text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400">Processing Time</span>
        <span class="text-sm font-bold text-slate-800 dark:text-slate-200">{destination.processingTime}</span>
      </div>
      <div>
        <span class="block text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400">Work Permit</span>
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 mt-0.5 block">Official Sponsor</span>
      </div>
      <div class="col-span-2 pt-2 border-t border-slate-200/60 dark:border-navy-800/60 flex items-center justify-between">
        <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Compensation & Fees</span>
        <span class="text-xs font-bold text-brand-600 dark:text-brand-400 flex items-center gap-1">
          <span>Provided on Reach-Out</span>
          <svg class="w-3 h-3 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </span>
      </div>
    </div>

    <!-- Free Housing & Meals Badges -->
    <div class="space-y-2 mb-5">
      <div class="flex items-center gap-2 text-xs font-medium text-slate-700 dark:text-slate-300">
        <div class="w-5 h-5 rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
        </div>
        <span class="truncate"><strong class="text-slate-900 dark:text-white">Housing:</strong> {destination.accommodation}</span>
      </div>
      <div class="flex items-center gap-2 text-xs font-medium text-slate-700 dark:text-slate-300">
        <div class="w-5 h-5 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
        </div>
        <span class="truncate"><strong class="text-slate-900 dark:text-white">Meals:</strong> {destination.meals}</span>
      </div>
    </div>

    <!-- Popular Sectors -->
    <div class="mb-5">
      <span class="block text-[10px] uppercase font-bold text-slate-400 dark:text-slate-500 mb-2">Available Job Openings</span>
      <div class="flex flex-wrap gap-1.5">
        {destination.popularJobs.map((job) => (
          <span class="text-[11px] font-medium px-2 py-0.5 rounded-lg bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-300">
            {job}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom CTA -->
  <div class="pt-4 border-t border-slate-200/80 dark:border-navy-800 flex flex-col gap-2">
    <div class="flex items-center gap-2">
      <a 
        href={`/assess?destination=${destination.id}`} 
        class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold text-white bg-slate-900 dark:bg-brand-500 hover:bg-brand-500 dark:hover:bg-brand-600 transition-all shadow-md group/btn"
      >
        <span>Apply for {destination.country}</span>
        <svg class="w-3.5 h-3.5 transform group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
      <a 
        href={`https://wa.me/12099493346?text=${encodeURIComponent(`Hi MyGo Travel, I am interested in relocating to ${destination.country}. Could you please share the package details, compensation, and pricing?`)}`}
        target="_blank"
        rel="noopener noreferrer"
        title={`Chat on WhatsApp for ${destination.country} package & pricing`}
        aria-label={`Inquire about ${destination.country} package on WhatsApp`}
        class="inline-flex items-center justify-center p-2.5 rounded-xl text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/20 transition-colors shrink-0"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
      </a>
    </div>
    <span class="text-[10px] text-slate-500 dark:text-slate-400 text-center">
      Reach out to receive full compensation & pricing details
    </span>
  </div>

</div>
