---

<section id="reviews" class="py-16 sm:py-20 bg-[#fbfbfa] dark:bg-navy-950/90 border-y border-slate-200/80 dark:border-navy-800/80 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- MAIN REVIEW WIDGET CONTAINER -->
    <div class="rounded-2xl bg-white dark:bg-navy-900 border border-slate-200/90 dark:border-navy-800 shadow-sm p-4 sm:p-6 mb-8">
      
      <!-- TOP TAB ROW (All reviews | Google | Facebook) -->
      <div class="flex items-center gap-6 border-b border-slate-100 dark:border-navy-800 pb-3 text-sm font-semibold">
        <button 
          type="button"
          data-tab="all" 
          class="review-tab-btn relative pb-2 text-slate-900 dark:text-white font-bold border-b-2 border-slate-900 dark:border-brand-400 transition-all cursor-pointer"
        >
          All reviews
        </button>

        <button 
          type="button"
          data-tab="google" 
          class="review-tab-btn relative pb-2 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white flex items-center gap-2 border-b-2 border-transparent transition-all cursor-pointer"
        >
          <!-- Google 4-color SVG Icon -->
          <svg class="w-4 h-4" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Google</span>
        </button>

        <button 
          type="button"
          data-tab="facebook" 
          class="review-tab-btn relative pb-2 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white flex items-center gap-2 border-b-2 border-transparent transition-all cursor-pointer"
        >
          <!-- Facebook Blue SVG Icon -->
          <svg class="w-4 h-4 fill-[#1877F2]" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span>Facebook</span>
        </button>
      </div>

      <!-- AGGREGATE SUMMARY ROW (Excellent ★★★★★ 4.6 | 323 reviews) -->
