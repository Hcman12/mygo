        type="button" 
        id="reviews-scroll-prev"
        aria-label="Previous reviews"
        class="absolute -left-3 sm:-left-5 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-700 shadow-lg flex items-center justify-center text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-navy-800 transition-all focus:outline-none"
      >
