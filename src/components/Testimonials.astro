---
// Testimonials.astro - Candidate stories about MyGo Travel
interface Review {
  name: string;
  placement: string;
  avatar: string;
  text: string;
}

const reviews: Review[] = [
  {
    name: 'Kayode David Ibitoye',
    placement: 'Warehouse operative · Poland',
    avatar: '/images/avatars/david.jpg',
    text: 'MyGo Travel made my relocation to Poland straightforward. My work permit arrived on schedule and my accommodation was arranged before I landed, so I could start work the same week.',
  },
  {
    name: 'Waleed Butt',
    placement: 'Automotive assembler · Czech Republic',
    avatar: '/images/avatars/waleed.jpg',
    text: 'The MyGo Travel team kept me informed at every stage of my work visa. Clear instructions, quick answers on WhatsApp, and everything happened on the timeline they gave me at the start.',
  },
  {
    name: 'Yomah K.',
    placement: 'Construction helper · Serbia',
    avatar: '/images/avatars/yomah.jpg',
    text: 'I am waiting on my Serbian work permit now. My MyGo Travel advisor explained each legal step patiently and showed me the employer contract, with accommodation included, before I paid anything.',
  },
  {
    name: 'Diana V.',
    placement: 'Logistics staff · Slovakia',
    avatar: '/images/avatars/diana.jpg',
    text: 'A professional team from the first call. MyGo Travel handled my apostilles and translations quickly, and the employer in Bratislava was expecting me when I arrived.',
  },
  {
    name: 'Mateo Kovács',
    placement: 'Machine operator · Slovakia',
    avatar: '/images/avatars/mateo.jpg',
    text: 'My manufacturing work permit was handled carefully from consultation to collection. The dormitory and canteen meals are exactly what was written in my contract.',
  },
  {
    name: 'Elena Dumitru',
    placement: 'Food packaging · Slovakia',
    avatar: '/images/avatars/elena.jpg',
    text: 'MyGo Travel helped with document legalisation, reviewed my employer contract with me, and booked my embassy appointment. No hidden surprises along the way.',
  },
  {
    name: 'Amara Nwosu',
    placement: 'Logistics · Poland',
    avatar: '/images/avatars/amara.jpg',
    text: 'My Poland placement was approved within the timeline MyGo Travel quoted. The housing was ready on arrival and close to the depot, and my salary is paid on time every month.',
  },
  {
    name: 'Taras S.',
    placement: 'Seasonal worker · Czech Republic',
    avatar: '/images/avatars/taras.jpg',
    text: 'Getting my Czech seasonal permit through MyGo Travel was smooth. Fast WhatsApp support, and my employer picked me up from Prague main station as arranged.',
  },
];
---

<section id="reviews" class="py-16 sm:py-20 bg-white dark:bg-navy-950 border-y border-slate-200/80 dark:border-navy-800/80 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 sm:mb-10">
      <div class="max-w-2xl">
        <h2 class="text-3xl sm:text-4xl font-serif font-black text-slate-900 dark:text-white tracking-tight">
          What our candidates say
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Workers MyGo Travel has helped relocate to jobs across Europe, in their own words.
        </p>
      </div>

      <div class="hidden sm:flex items-center gap-2 shrink-0">
        <button
          type="button"
          id="reviews-scroll-prev"
          aria-label="Previous reviews"
          class="w-10 h-10 rounded-full border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-900 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-navy-800 flex items-center justify-center transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        </button>
        <button
          type="button"
          id="reviews-scroll-next"
          aria-label="Next reviews"
          class="w-10 h-10 rounded-full border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-900 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-navy-800 flex items-center justify-center transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>

    <div
      id="reviews-carousel-track"
      class="no-scrollbar -mx-4 px-4 sm:mx-0 sm:px-0 flex gap-4 sm:gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2"
    >
      {reviews.map((review) => (
        <figure class="review-card snap-start flex-none w-[85%] sm:w-[340px] flex flex-col rounded-2xl border border-slate-200 dark:border-navy-800 bg-slate-50 dark:bg-navy-900 p-6">
          <div class="flex items-center gap-0.5 text-amber-400" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
            <p>“{review.text}”</p>
          </blockquote>

          <figcaption class="mt-6 flex items-center gap-3">
            <img
              src={review.avatar}
              alt=""
              class="w-10 h-10 rounded-full object-cover shrink-0"
              loading="lazy"
            />
            <div class="min-w-0">
              <div class="text-sm font-semibold text-slate-900 dark:text-white">{review.name}</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">{review.placement}</div>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>

  </div>
</section>

<style>
  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const track = document.getElementById('reviews-carousel-track');
  const btnPrev = document.getElementById('reviews-scroll-prev');
  const btnNext = document.getElementById('reviews-scroll-next');

  function scrollStep() {
    const card = track?.querySelector<HTMLElement>('.review-card');
    return card ? card.offsetWidth + 24 : 360;
  }

  btnPrev?.addEventListener('click', () => track?.scrollBy({ left: -scrollStep(), behavior: 'smooth' }));
  btnNext?.addEventListener('click', () => track?.scrollBy({ left: scrollStep(), behavior: 'smooth' }));
</script>
