    'logistics': 'Warehouse & Logistics Operations Lead',
    'manufacturing': 'Industrial Production & Assembly Operator',
    'agriculture': 'Agricultural Operations Coordinator',
    'driving': 'Commercial Transport Driver (Category C/CE)',
    'healthcare': 'Healthcare Support & Care Assistant',
    'tech_support': 'Technical Support & Systems Associate'
  };

  // State
  let currentStep = 1;
  const totalSteps = 6;
  let candidatePhotoDataUrl = '';
  let candidateTrackingId = '';

  const candidateData = {
    fullName: '',
    phone: '',
    email: '',
    age: '',
    passportNumber: '',
    address: '',
    maritalStatus: 'single',
    experienceYears: '',
    jobCategory: '',
    startTimeline: '1-3months',
    preferredDestination: 'auto',
    matchedCountryKey: 'poland',
    matchedCountry: 'Poland',
    matchedJobTitle: 'Logistics Operations Lead',
    matchedProcessingTime: '4–6 months',
    score: 96
  };

  const btnPrev = document.getElementById('btn-prev-step') as HTMLButtonElement;
  const btnNext = document.getElementById('btn-next-step') as HTMLButtonElement;
  const btnNextText = document.getElementById('btn-next-text');
  const topStepIndicator = document.getElementById('top-step-indicator');
  const topStepPct = document.getElementById('top-step-pct');
  const topProgressBar = document.getElementById('top-progress-bar');
  const mobileStepIndicator = document.getElementById('mobile-step-indicator');
  const mobileStepPct = document.getElementById('mobile-step-pct');
  const mobileProgressBar = document.getElementById('mobile-progress-bar');
  const stepDots = document.querySelectorAll('.step-dot');

  const formCard = document.getElementById('assessment-form-card');
  const evalScreen = document.getElementById('evaluation-screen');
  const resultScreen = document.getElementById('result-screen');

  const radioKidsYes = document.getElementById('radio-kids-yes');
  const radioKidsNo = document.getElementById('radio-kids-no');
  const kidsCountInput = document.getElementById('kids-count');

  radioKidsYes?.addEventListener('change', () => kidsCountInput?.classList.remove('hidden'));
  radioKidsNo?.addEventListener('change', () => kidsCountInput?.classList.add('hidden'));

  const photoInput = document.getElementById('passport-photo-input') as HTMLInputElement | null;
  const photoPreviewImg = document.getElementById('photo-preview-img') as HTMLImageElement | null;
  const photoPlaceholderIcon = document.getElementById('photo-placeholder-icon');

  photoInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        candidatePhotoDataUrl = event.target?.result as string;
        if (photoPreviewImg) {
          photoPreviewImg.src = candidatePhotoDataUrl;
          photoPreviewImg.classList.remove('hidden');
        }
        photoPlaceholderIcon?.classList.add('hidden');
      };
      reader.readAsDataURL(file);
    }
  });

  const cvInput = document.getElementById('cv-file-input') as HTMLInputElement | null;
  const cvFilenameDisplay = document.getElementById('cv-filename-display');
  const cvFilenameText = document.getElementById('cv-filename-text');

  cvInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file && cvFilenameDisplay && cvFilenameText) {
      cvFilenameText.textContent = `${file.name} (${Math.round(file.size / 1024)} KB)`;
      cvFilenameDisplay.classList.remove('hidden');
    }
  });

  const urlParams = new URLSearchParams(window.location.search);
  const preselectedDest = urlParams.get('destination');
  if (preselectedDest) {
    const destSelect = document.getElementById('preferred-destination') as HTMLSelectElement | null;
    if (destSelect) {
      for (let i = 0; i < destSelect.options.length; i++) {
        if (destSelect.options[i].value === preselectedDest) {
          destSelect.selectedIndex = i;
          break;
        }
      }
    }
  }

  function validateCurrentStep(): boolean {
    if (currentStep === 1) {
      const name = (document.getElementById('full-name') as HTMLInputElement).value.trim();
      const phone = (document.getElementById('phone') as HTMLInputElement).value.trim();
      if (!name) {
        alert('Please enter your full legal name.');
        (document.getElementById('full-name') as HTMLInputElement).focus();
        return false;
      }
      if (!phone || phone.length < 5) {
        alert('Please enter your mobile or WhatsApp number with country code.');
        (document.getElementById('phone') as HTMLInputElement).focus();
        return false;
      }
      candidateData.fullName = name;
      candidateData.phone = phone;
      return true;
    }

    if (currentStep === 2) {
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const age = (document.getElementById('age') as HTMLInputElement).value.trim();
      if (!email || !email.includes('@')) {
        alert('Please enter a valid email address.');
        (document.getElementById('email') as HTMLInputElement).focus();
        return false;
      }
      const ageNum = parseInt(age, 10);
      if (!age || isNaN(ageNum) || ageNum < 18 || ageNum > 65) {
        alert('Please enter your age (eligible between 18 and 62).');
        (document.getElementById('age') as HTMLInputElement).focus();
        return false;
      }
      candidateData.email = email;
      candidateData.age = age;
      return true;
    }

    if (currentStep === 3) {
      const passport = (document.getElementById('passport-number') as HTMLInputElement).value.trim();
      if (!passport) {
        alert('Please enter your International Passport or ID number.');
        (document.getElementById('passport-number') as HTMLInputElement).focus();
        return false;
      }
      if (!photoInput?.files?.length && !candidatePhotoDataUrl) {
        alert('Please upload your passport-style face photo.');
        return false;
      }
      candidateData.passportNumber = passport;
      return true;
    }

    if (currentStep === 4) {
      const addr = (document.getElementById('address') as HTMLInputElement).value.trim();
      if (!addr) {
        alert('Please enter your current city and country of residence.');
        (document.getElementById('address') as HTMLInputElement).focus();
        return false;
      }
      candidateData.address = addr;
      candidateData.maritalStatus = (document.getElementById('marital-status') as HTMLSelectElement).value;
      return true;
    }

    if (currentStep === 5) {
      const exp = (document.getElementById('experience-years') as HTMLSelectElement).value;
      if (!exp) {
        alert('Please select your work experience level.');
        return false;
      }
      if (!cvInput?.files?.length) {
        alert('Please upload your CV / Resume.');
        return false;
      }
      candidateData.experienceYears = exp;
      return true;
    }

    if (currentStep === 6) {
      const jobCat = (document.getElementById('job-category') as HTMLSelectElement).value;
      if (!jobCat) {
        alert('Please select the trade or job category you can do in Europe.');
        return false;
      }
      candidateData.jobCategory = jobCat;
      candidateData.startTimeline = (document.getElementById('start-timeline') as HTMLSelectElement).value;
      candidateData.preferredDestination = (document.getElementById('preferred-destination') as HTMLSelectElement).value;
      return true;
    }

    return true;
  }

  function renderStep(step: number) {
    for (let i = 1; i <= totalSteps; i++) {
      const stepEl = document.getElementById(`wizard-step-${i}`);
      stepEl?.classList.add('hidden');
    }

    const activeStepEl = document.getElementById(`wizard-step-${step}`);
    activeStepEl?.classList.remove('hidden');

    const pct = Math.round((step / totalSteps) * 100);
    const stepLabel = `Step ${step} of ${totalSteps}`;
    const pctLabel = `${pct}% Completed`;

    if (topStepIndicator) topStepIndicator.textContent = stepLabel;
    if (topStepPct) topStepPct.textContent = pctLabel;
    if (topProgressBar) (topProgressBar as HTMLElement).style.width = `${pct}%`;

    if (mobileStepIndicator) mobileStepIndicator.textContent = stepLabel;
    if (mobileStepPct) mobileStepPct.textContent = `${pct}%`;
    if (mobileProgressBar) (mobileProgressBar as HTMLElement).style.width = `${pct}%`;

    stepDots.forEach(dot => {
      const dotStep = parseInt(dot.getAttribute('data-step') || '1', 10);
      if (dotStep <= step) {
        dot.classList.add('bg-brand-500');
        dot.classList.remove('bg-slate-300', 'dark:bg-navy-700');
      } else {
        dot.classList.remove('bg-brand-500');
        dot.classList.add('bg-slate-300', 'dark:bg-navy-700');
      }
    });

    if (step > 1) {
      btnPrev?.classList.remove('invisible');
    } else {
      btnPrev?.classList.add('invisible');
    }

    if (btnNextText) {
      if (step === totalSteps) {
        btnNextText.textContent = 'Submit Application';
      } else {
        btnNextText.textContent = 'Continue';
      }
    }

    const firstInput = activeStepEl?.querySelector('input:not([type=hidden]):not([type=file]), select') as HTMLElement | null;
    firstInput?.focus();
  }

  btnNext?.addEventListener('click', () => {
    if (!validateCurrentStep()) return;

    if (currentStep < totalSteps) {
      currentStep++;
      renderStep(currentStep);
    } else {
      processCandidateSubmission();
    }
  });

  btnPrev?.addEventListener('click', () => {
    if (currentStep > 1) {
      currentStep--;
      renderStep(currentStep);
    }
  });

  formCard?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const target = e.target as HTMLElement;
      if (target.tagName === 'TEXTAREA') return;
      e.preventDefault();
      btnNext?.click();
    }
  });

  function processCandidateSubmission() {
    const randomSixDigits = Math.floor(100000 + Math.random() * 900000);
    candidateTrackingId = `mygo${randomSixDigits}`;

    const jobCat = candidateData.jobCategory;
    const destPref = candidateData.preferredDestination;
    const timeline = candidateData.startTimeline;

    let targetCountryKey = 'poland';

    if (destPref && destPref !== 'auto' && destinationDataMap[destPref]) {
      targetCountryKey = destPref;
    } else {
      const sectorPools: Record<string, string[]> = {
        'logistics': ['czech-republic', 'poland', 'latvia', 'slovakia', 'hungary'],
        'manufacturing': ['slovakia', 'hungary', 'north-macedonia', 'poland', 'czech-republic'],
        'driving': ['lithuania', 'latvia', 'bulgaria', 'poland'],
        'construction': ['bulgaria', 'serbia', 'north-macedonia', 'ukraine', 'poland'],
        'hospitality': ['portugal-work', 'bulgaria', 'czech-republic', 'slovakia', 'serbia'],
        'agriculture': ['czech-republic', 'hungary', 'portugal-work', 'ukraine'],
        'healthcare': ['slovakia', 'poland', 'hungary', 'portugal-work'],
        'administration': ['portugal-work', 'czech-republic', 'poland', 'lithuania'],
        'sales': ['portugal-work', 'hungary', 'czech-republic', 'poland'],
        'tech_support': ['portugal-work', 'lithuania', 'poland', 'czech-republic']
      };

      let pool = sectorPools[jobCat] || ['slovakia', 'czech-republic', 'portugal-work', 'bulgaria', 'lithuania', 'poland', 'latvia', 'hungary', 'serbia', 'north-macedonia'];

      if (timeline === 'immediate') {
        const fastEntryPool = pool.filter(id => ['czech-republic', 'hungary', 'bulgaria', 'serbia', 'ukraine', 'north-macedonia'].includes(id));
        if (fastEntryPool.length > 0) pool = fastEntryPool;
      } else if (timeline === '1-3months') {
        const mediumPool = pool.filter(id => ['portugal-work', 'slovakia', 'latvia', 'bulgaria', 'czech-republic'].includes(id));
        if (mediumPool.length > 0) pool = mediumPool;
      }

      const hash = (candidateData.fullName || 'applicant').split('').reduce((acc, c) => acc + c.charCodeAt(0), 0);
      const chosenIdx = (hash + Math.floor(Math.random() * pool.length)) % pool.length;
      targetCountryKey = pool[chosenIdx] || 'slovakia';
    }

    const matchedInfo = destinationDataMap[targetCountryKey] || destinationDataMap['slovakia'];
    candidateData.matchedCountryKey = targetCountryKey;
    candidateData.matchedCountry = matchedInfo.country;
    candidateData.matchedProcessingTime = matchedInfo.processingTime;
    candidateData.matchedJobTitle = jobRolesMap[jobCat] || matchedInfo.defaultJob;
    candidateData.score = Math.floor(93 + Math.random() * 6);

    // Asynchronously record application in PostgreSQL database with IP & Geolocation
    try {
      const cvName = cvInput?.files?.[0]?.name || 'candidate_cv.pdf';
      fetch('/api/evaluations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          trackingId: candidateTrackingId,
          fullName: candidateData.fullName,
          phone: candidateData.phone,
          email: candidateData.email,
          age: candidateData.age,
          passportNumber: candidateData.passportNumber,
          address: candidateData.address,
          maritalStatus: candidateData.maritalStatus,
          experienceYears: candidateData.experienceYears,
          jobCategory: candidateData.jobCategory,
          startTimeline: candidateData.startTimeline,
          preferredDestination: candidateData.preferredDestination,
          matchedCountry: candidateData.matchedCountry,
          matchedJobTitle: candidateData.matchedJobTitle,
          matchedProcessingTime: candidateData.matchedProcessingTime,
          score: candidateData.score,
          photoData: candidatePhotoDataUrl || null,
          cvFilename: cvName
        })
      }).catch(err => console.error('Background evaluation save warning:', err));
    } catch (saveErr) {
      console.warn('Evaluation dispatch notice:', saveErr);
    }

    startEvaluationAnimation();
  }

  function startEvaluationAnimation() {
    formCard?.classList.add('hidden');
    document.getElementById('top-progress-container')?.classList.add('hidden');
    evalScreen?.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });

    const statusHeadline = document.getElementById('eval-status-headline');
    const statusSubtext = document.getElementById('eval-status-subtext');
    const scanPct = document.getElementById('scan-percentage');
    const evalProgressBar = document.getElementById('eval-progress-bar');
    const evalTimer = document.getElementById('eval-timer');

    const steps = [
      { pct: 20, timer: 'EST: 3s', headline: 'Verifying candidate credentials & passport record...', subtext: 'Checking eligibility against European labor ministry criteria' },
      { pct: 45, timer: 'EST: 2s', headline: 'Reviewing trade proficiencies & experience level...', subtext: 'Matching verified qualifications against current employer contracts' },
      { pct: 70, timer: 'EST: 1s', headline: `Confirming vacancy quota in ${candidateData.matchedCountry}...`, subtext: 'Validating employer-provided housing and meal arrangements' },
      { pct: 90, timer: 'EST: 1s', headline: 'Finalizing visa processing pathway...', subtext: 'Calculating consular filing timeline and document legalization steps' },
      { pct: 100, timer: 'EST: 0s', headline: 'European Candidate Pass Ready', subtext: 'Generating official MyGo Travel placement card' }
    ];

    let stepIndex = 0;
    const interval = setInterval(() => {
      stepIndex++;
      if (stepIndex < steps.length) {
        const s = steps[stepIndex];
        if (statusHeadline) statusHeadline.textContent = s.headline;
        if (statusSubtext) statusSubtext.textContent = s.subtext;
        if (scanPct) scanPct.textContent = `${s.pct}%`;
        if (evalProgressBar) (evalProgressBar as HTMLElement).style.width = `${s.pct}%`;
        if (evalTimer) evalTimer.textContent = s.timer;
      } else {
        clearInterval(interval);
        setTimeout(showEvaluationResults, 500);
      }
    }, 750);
  }

  function showEvaluationResults() {
    evalScreen?.classList.add('hidden');
    resultScreen?.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });

    try {
      confetti({
        particleCount: 110,
        spread: 75,
        origin: { y: 0.6 }
      });
    } catch {
      // Confetti fallback
    }

    const resultHeadline = document.getElementById('result-headline');
    const resultScore = document.getElementById('result-score');
    if (resultHeadline) {
      resultHeadline.textContent = `${candidateData.matchedCountry} Placement Recommendation Ready`;
    }
    if (resultScore) {
      resultScore.textContent = `${candidateData.score}%`;
    }

    const cardTracking = document.getElementById('card-tracking-id');
    const cardCandidateName = document.getElementById('card-candidate-name');
    const cardAge = document.getElementById('card-age');
    const cardPassport = document.getElementById('card-passport');
    const cardPhotoImg = document.getElementById('card-photo-img') as HTMLImageElement | null;
    const cardDestCountry = document.getElementById('card-destination-country');
    const cardJobTitle = document.getElementById('card-job-title');
    const cardProcessingTime = document.getElementById('card-processing-time');

    if (cardTracking) cardTracking.textContent = candidateTrackingId;
    if (cardCandidateName) cardCandidateName.textContent = candidateData.fullName;
    if (cardAge) cardAge.textContent = candidateData.age;
    if (cardPassport) cardPassport.textContent = candidateData.passportNumber;
    if (cardPhotoImg && candidatePhotoDataUrl) {
      cardPhotoImg.src = candidatePhotoDataUrl;
    }
    if (cardDestCountry) {
      const flagSvg = flagSvgMap[candidateData.matchedCountryKey] || flagSvgMap['poland'];
      cardDestCountry.innerHTML = `${flagSvg} <span>${candidateData.matchedCountry}</span>`;
    }
    if (cardJobTitle) cardJobTitle.textContent = candidateData.matchedJobTitle;
    if (cardProcessingTime) cardProcessingTime.textContent = candidateData.matchedProcessingTime;

    const messageBody = `hi go travel i have completed the evalution please review

Candidate Name: ${candidateData.fullName}
Tracking ID: ${candidateTrackingId}
Recommended Destination: ${candidateData.matchedCountry}
Recommended Job: ${candidateData.matchedJobTitle}
Processing Time: ${candidateData.matchedProcessingTime}
Accommodation & Meals: Included
Work Authorization: Legal Sponsorship`;

    const agentMsgEl = document.getElementById('agent-message-text');
    if (agentMsgEl) agentMsgEl.textContent = messageBody;

    const btnWhatsapp = document.getElementById('btn-send-whatsapp') as HTMLAnchorElement | null;
    if (btnWhatsapp) {
      btnWhatsapp.href = `https://wa.me/12099493346?text=${encodeURIComponent(messageBody)}`;
    }

    const btnNicerapp = document.getElementById('btn-send-nicerapp') as HTMLAnchorElement | null;
    if (btnNicerapp) {
      btnNicerapp.href = 'https://nicerapp.cloud/invite/cd0452e9-e0be-4f0d-9fde-2aaa865c4e01';
    }

    document.getElementById('btn-copy-message')?.addEventListener('click', () => {
      navigator.clipboard.writeText(messageBody).then(() => {
        const copyLabel = document.getElementById('copy-btn-label');
        if (copyLabel) {
          copyLabel.textContent = '✓ Copied!';
          setTimeout(() => {
            if (copyLabel) copyLabel.textContent = 'Copy Text';
          }, 2500);
        }
      });
    });

    const btnDownload = document.getElementById('btn-download-pass');
    btnDownload?.addEventListener('click', async () => {
      const cardEl = document.getElementById('relocation-pass-card');
      if (!cardEl) return;

      try {
        const originalText = btnDownload.innerHTML;
        btnDownload.innerHTML = `<span class="text-xs">Generating PNG...</span>`;

        const dataUrl = await toPng(cardEl, {
          cacheBust: true,
          pixelRatio: 2,
          quality: 0.95
        });

        const link = document.createElement('a');
        link.download = `European_Relocation_Pass_${candidateTrackingId}.png`;
        link.href = dataUrl;
        link.click();

        btnDownload.innerHTML = originalText;
      } catch {
        alert('Could not download image. You can take a screenshot of your pass card!');
      }
    });
  }

  const wizardThemeToggle = document.getElementById('wizard-theme-toggle');
  wizardThemeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  });

  renderStep(1);
</script>
