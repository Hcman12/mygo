  // Country Master Data without salary
  const destinationDataMap: Record<string, { country: string; processingTime: string; defaultJob: string }> = {
    'poland': { country: 'Poland', processingTime: '4–6 months', defaultJob: 'Logistics Operations Lead' },
    'slovakia': { country: 'Slovakia', processingTime: '3–4 months', defaultJob: 'Industrial Manufacturing Specialist' },
