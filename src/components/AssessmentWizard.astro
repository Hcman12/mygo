    'latvia': { country: 'Latvia', processingTime: '2 months', defaultJob: 'Freight & Logistics Coordinator' },
    'lithuania': { country: 'Lithuania', processingTime: '3–5 months', defaultJob: 'Heavy Transport & Logistics Tech' },
