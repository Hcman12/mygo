---
import { destinations } from '../data/destinations';
import CountryFlag from './CountryFlag.astro';
---

<div class="min-h-screen flex flex-col justify-between bg-slate-50 dark:bg-navy-950 text-slate-900 dark:text-white transition-colors duration-200" id="wizard-fullscreen-container">
  
  <!-- TOP NAVBAR -->
  <header class="sticky top-0 z-30 w-full backdrop-blur-md bg-white/90 dark:bg-navy-900/90 border-b border-slate-200 dark:border-navy-800 py-3.5 px-4 sm:px-8">
    <div class="max-w-6xl mx-auto flex items-center justify-between gap-4">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2 group shrink-0" title="Exit to MyGo Travel Home">
        <img 
          src="/Mygo_Travel_Logo.png" 
          alt="MyGo Travel" 
          class="h-8 w-auto object-contain dark:hidden transition-transform group-hover:scale-105"
        />
        <img 
          src="/Mygo_Travel_Logo_White.png" 
          alt="MyGo Travel" 
          class="h-8 w-auto object-contain hidden dark:block transition-transform group-hover:scale-105"
        />
      </a>

      <!-- Progress Center Indicator (visible during form) -->
      <div id="top-progress-container" class="flex-1 max-w-md mx-4 hidden sm:block">
        <div class="flex items-center justify-between text-xs font-semibold mb-1.5 text-slate-600 dark:text-slate-400">
          <span id="top-step-indicator">Step 1 of 6</span>
          <span id="top-step-pct">17% Completed</span>
        </div>
        <div class="w-full bg-slate-200 dark:bg-navy-800 h-2 rounded-full overflow-hidden">
          <div id="top-progress-bar" class="bg-gradient-to-r from-brand-500 to-emerald-500 h-full w-[17%] transition-all duration-300"></div>
        </div>
      </div>

      <!-- Action: Theme Toggle & Exit -->
      <div class="flex items-center gap-3 shrink-0">
        <!-- Theme Switcher -->
        <button 
          id="wizard-theme-toggle" 
          type="button" 
          aria-label="Toggle dark/light theme"
          class="p-2 rounded-xl text-slate-500 hover:text-brand-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:text-brand-400 dark:hover:bg-navy-800 transition-colors"
        >
          <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
        </button>

        <!-- Exit Link -->
        <a 
          href="/" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-rose-500 dark:hover:text-rose-400 hover:bg-slate-100 dark:hover:bg-navy-800 transition-all border border-slate-200 dark:border-navy-700"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
          <span>Exit</span>
        </a>
      </div>

    </div>

    <!-- Mobile Progress Bar -->
    <div class="sm:hidden mt-2 pt-2 border-t border-slate-200 dark:border-navy-800">
      <div class="flex items-center justify-between text-[11px] font-semibold mb-1 text-slate-500 dark:text-slate-400">
        <span id="mobile-step-indicator">Step 1 of 6</span>
        <span id="mobile-step-pct">17%</span>
      </div>
      <div class="w-full bg-slate-200 dark:bg-navy-800 h-1.5 rounded-full overflow-hidden">
        <div id="mobile-progress-bar" class="bg-gradient-to-r from-brand-500 to-emerald-500 h-full w-[17%] transition-all duration-300"></div>
      </div>
    </div>
  </header>

  <!-- MAIN VIEWPORT CONTAINER -->
  <main class="flex-1 flex items-center justify-center p-4 sm:p-8 relative">
    
    <!-- 1. MULTI-STEP QUESTIONNAIRE (1-2 QUESTIONS PER PAGE) -->
    <div id="assessment-form-card" class="w-full max-w-2xl bg-white dark:bg-navy-900 rounded-2xl p-6 sm:p-10 border border-slate-200 dark:border-navy-800 shadow-xl relative transition-all duration-200">
      
      <form id="assessment-form" onsubmit="return false;" autocomplete="off">
        
        <!-- STEP 1: NAME & PHONE (2 QUESTIONS) -->
        <div id="wizard-step-1" class="wizard-step space-y-6">
          <div class="space-y-1">
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
              Candidate contact details
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
              Your details will be used to generate your official European Relocation Pass.
            </p>
          </div>

          <div class="space-y-5 pt-2">
            <!-- Question 1: Full Name -->
            <div class="space-y-1.5">
              <label for="full-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                1. What is your full legal name? <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </div>
                <input 
                  type="text" 
                  id="full-name" 
                  name="fullName" 
                  required 
                  placeholder="e.g. Maria Santos / Ahmed Hassan" 
                  class="w-full pl-10 pr-4 py-3.5 rounded-xl bg-slate-50 dark:bg-navy-950 border border-slate-300 dark:border-navy-700 text-slate-900 dark:text-white font-medium text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all"
                />
              </div>
            </div>

            <!-- Question 2: Phone / WhatsApp -->
            <div class="space-y-1.5">
              <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                2. What is your mobile / WhatsApp number? <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-emerald-500">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                  </svg>
                </div>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  required 
                  placeholder="+1 (555) 000-0000 (with country code)" 
                  class="w-full pl-10 pr-4 py-3.5 rounded-xl bg-slate-50 dark:bg-navy-950 border border-slate-300 dark:border-navy-700 text-slate-900 dark:text-white font-medium text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 2: EMAIL & AGE (2 QUESTIONS) -->
        <div id="wizard-step-2" class="wizard-step space-y-6 hidden">
          <div class="space-y-1">
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
              Email address & age bracket
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
              European work visa programs have specific age eligibility thresholds.
            </p>
          </div>

          <div class="space-y-5 pt-2">
            <!-- Question 3: Email -->
            <div class="space-y-1.5">
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                3. What is your email address? <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  placeholder="name@example.com" 
                  class="w-full pl-10 pr-4 py-3.5 rounded-xl bg-slate-50 dark:bg-navy-950 border border-slate-300 dark:border-navy-700 text-slate-900 dark:text-white font-medium text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all"
                />
              </div>
            </div>

            <!-- Question 4: Age -->
            <div class="space-y-1.5">
              <label for="age" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                4. How old are you? <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
                <input 
                  type="number" 
                  id="age" 
                  name="age" 
                  min="18" 
                  max="62" 
                  required 
                  placeholder="e.g. 29 (must be between 18 and 60)" 
                  class="w-full pl-10 pr-4 py-3.5 rounded-xl bg-slate-50 dark:bg-navy-950 border border-slate-300 dark:border-navy-700 text-slate-900 dark:text-white font-medium text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 3: PASSPORT & PHOTO (2 QUESTIONS) -->
        <div id="wizard-step-3" class="wizard-step space-y-6 hidden">
          <div class="space-y-1">
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
              Passport details & headshot photo
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
              Used to stamp your official Digital Relocation Pass Card for our European visa team.
            </p>
          </div>

          <div class="space-y-5 pt-2">
            <!-- Question 5: Passport Number -->
            <div class="space-y-1.5">
              <label for="passport-number" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                5. What is your International Passport / ID Number? <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"/>
                  </svg>
                </div>
                <input 
                  type="text" 
                  id="passport-number" 
                  name="passportNumber" 
                  required 
                  placeholder="e.g. P12345678 or ID Document number" 
                  class="w-full pl-10 pr-4 py-3.5 rounded-xl bg-slate-50 dark:bg-navy-950 border border-slate-300 dark:border-navy-700 text-slate-900 dark:text-white font-medium text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all uppercase"
                />
              </div>
            </div>

            <!-- Question 6: Passport Photo Upload -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                6. Upload your clear face photo (Passport style) <span class="text-rose-500">*</span>
              </label>
              <div class="flex items-center gap-5 p-4 rounded-xl bg-slate-50 dark:bg-navy-950 border border-slate-300 dark:border-navy-700 hover:border-brand-500 transition-colors">
                <!-- Preview Avatar Circle -->
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl bg-slate-200 dark:bg-navy-900 border border-slate-300 dark:border-navy-700 overflow-hidden flex items-center justify-center shrink-0">
                  <img id="photo-preview-img" src="" alt="Passport Preview" class="w-full h-full object-cover hidden" />
                  <div id="photo-placeholder-icon" class="text-slate-400">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                </div>

                <div class="flex-1 min-w-0">
                  <label for="passport-photo-input" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-white bg-brand-500 hover:bg-brand-600 transition-colors cursor-pointer">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                    </svg>
                    <span>Choose Photo File</span>
                  </label>
                  <input type="file" id="passport-photo-input" name="passportPhoto" accept="image/*" class="sr-only" required />
                  <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1.5">
                    Clear front-facing headshot on light background (JPG, PNG).
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 4: LOCATION & FAMILY (2 QUESTIONS) -->
        <div id="wizard-step-4" class="wizard-step space-y-6 hidden">
          <div class="space-y-1">
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
              Residence location & family status
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
              European employers provide different accommodation arrangements for individuals versus families.
            </p>
          </div>

          <div class="space-y-5 pt-2">
            <!-- Question 7: Residence Address / City -->
            <div class="space-y-1.5">
              <label for="address" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                7. What is your current residential city & country? <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <input 
                  type="text" 
                  id="address" 
                  name="address" 
                  required 
                  placeholder="e.g. Manila, Philippines / Nairobi, Kenya" 
                  class="w-full pl-10 pr-4 py-3.5 rounded-xl bg-slate-50 dark:bg-navy-950 border border-slate-300 dark:border-navy-700 text-slate-900 dark:text-white font-medium text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all"
                />
              </div>
            </div>

            <!-- Question 8: Marital Status & Children -->
            <div class="space-y-3">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                8. Marital status & family accompaniment
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <select 
                    id="marital-status" 
                    name="maritalStatus" 
                    class="w-full px-4 py-3.5 rounded-xl bg-slate-50 dark:bg-navy-950 border border-slate-300 dark:border-navy-700 text-slate-900 dark:text-white font-medium text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all"
                  >
                    <option value="single">Single / Independent</option>
                    <option value="married">Married</option>
                    <option value="divorced">Divorced / Separated</option>
                  </select>
                </div>

                <div class="p-3 rounded-xl bg-slate-50 dark:bg-navy-950 border border-slate-300 dark:border-navy-700 flex items-center justify-between">
                  <span class="text-xs font-medium text-slate-700 dark:text-slate-300">Relocating with children?</span>
                  <div class="flex items-center gap-3">
                    <label class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 dark:text-slate-300 cursor-pointer">
                      <input type="radio" name="hasKids" value="no" checked class="accent-brand-500" id="radio-kids-no" />
                      <span>No</span>
                    </label>
                    <label class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 dark:text-slate-300 cursor-pointer">
                      <input type="radio" name="hasKids" value="yes" class="accent-brand-500" id="radio-kids-yes" />
                      <span>Yes</span>
                    </label>
                  </div>
                </div>
              </div>
              
              <!-- Hidden Kids Count input -->
              <div id="kids-count" class="hidden pt-1">
                <input 
                  type="number" 
                  min="1" 
                  max="8" 
                  placeholder="Number of children (e.g. 2)" 
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-navy-950 border border-slate-300 dark:border-navy-700 text-slate-900 dark:text-white text-xs outline-none"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 5: WORK EXPERIENCE & CV (2 QUESTIONS) -->
        <div id="wizard-step-5" class="wizard-step space-y-6 hidden">
          <div class="space-y-1">
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
              Work experience & resume document
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
              European employers match contracts based on verified employment history.
            </p>
          </div>

          <div class="space-y-5 pt-2">
            <!-- Question 9: Experience Years -->
            <div class="space-y-1.5">
              <label for="experience-years" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                9. How many years of work experience do you have? <span class="text-rose-500">*</span>
              </label>
              <select 
                id="experience-years" 
                name="experienceYears" 
                required 
                class="w-full px-4 py-3.5 rounded-xl bg-slate-50 dark:bg-navy-950 border border-slate-300 dark:border-navy-700 text-slate-900 dark:text-white font-medium text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all"
              >
                <option value="" disabled selected>Select your experience level</option>
                <option value="entry">Entry Level / General Labor (0–1 Year)</option>
                <option value="junior">1–2 Years Verified Experience</option>
                <option value="mid">3–5 Years Skilled Experience</option>
                <option value="senior">5+ Years Senior Specialist / Lead</option>
              </select>
            </div>

            <!-- Question 10: CV / Resume File Upload -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                10. Upload your CV or Resume <span class="text-rose-500">*</span>
              </label>
              <div class="p-6 rounded-xl bg-slate-50 dark:bg-navy-950 border border-dashed border-slate-300 dark:border-navy-700 hover:border-brand-500 transition-colors text-center">
                <div class="w-10 h-10 mx-auto rounded-lg bg-brand-500/10 text-brand-500 flex items-center justify-center mb-3">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                  </svg>
                </div>
                <label for="cv-file-input" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold text-white bg-brand-500 hover:bg-brand-600 transition-colors cursor-pointer shadow-sm">
                  <span>Browse CV / Resume File</span>
                </label>
