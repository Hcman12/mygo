---
---

<section id="consultation" class="py-16 sm:py-24 bg-[#FAF8F0] dark:bg-navy-950 border-b border-slate-200/80 dark:border-navy-800 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Why Relocate (Inspired by Screenshot 1) -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-tealbrand-500/10 border border-tealbrand-500/20 text-tealbrand-700 dark:text-tealbrand-400 text-xs font-bold">
          <span>Free Relocation Advisory</span>
        </div>

        <h2 class="text-3xl sm:text-5xl font-black font-serif tracking-tight text-slate-900 dark:text-white leading-tight">
          Why Relocate <br class="hidden sm:block"/>
          <span class="text-tealbrand-600">With MyGo Travel?</span>
        </h2>

        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
          Moving abroad is a life-changing milestone. We remove the uncertainty by connecting you exclusively to licensed European host companies with legally binding housing and meal guarantees.
        </p>

        <div class="space-y-4 pt-2">
          <div class="flex items-start gap-4">
            <div class="w-9 h-9 rounded-xl bg-tealbrand-500/10 text-tealbrand-600 dark:text-tealbrand-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white text-sm sm:text-base">Guaranteed Accommodation &amp; Meal Plans</h4>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-0.5">Furnished quarters arranged prior to departure. No upfront European rent or landlord screening.</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-9 h-9 rounded-xl bg-tealbrand-500/10 text-tealbrand-600 dark:text-tealbrand-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white text-sm sm:text-base">Direct Embassy &amp; Consular Legal Desk</h4>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-0.5">In-house European immigration attorneys handle labor ministry approvals, apostilles, and biometric bookings.</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-9 h-9 rounded-xl bg-tealbrand-500/10 text-tealbrand-600 dark:text-tealbrand-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white text-sm sm:text-base">9,000+ Workers Placed Over 8 Years</h4>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-0.5">A proven track record with accredited employers in Poland, Slovakia, Czech Republic, Portugal, and Lithuania.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Quick Lead Capture Form (Inspired by Screenshot 1) -->
      <div class="lg:col-span-6">
        <div class="bg-white dark:bg-navy-900 rounded-3xl p-6 sm:p-10 border-2 border-tealbrand-500/30 shadow-xl">
          
          <div class="mb-6 text-center sm:text-left">
            <h3 class="text-2xl sm:text-3xl font-black font-serif tracking-tight text-slate-900 dark:text-white">
              Fill out the form <br/>
              <span class="text-tealbrand-600">to get a free consultation</span>
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">
              Speak directly with an official admissions counselor regarding your European relocation docket.
            </p>
          </div>

          <form id="consultation-form" class="space-y-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
                Your Full Name *
              </label>
              <input 
                type="text" 
                id="consult-name" 
                required 
                placeholder="e.g. Samuel O. Mwangi" 
                class="w-full bg-slate-50 dark:bg-navy-950 border-2 border-tealbrand-500/40 focus:border-tealbrand-600 rounded-xl px-4 py-3.5 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none transition"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
                Your WhatsApp / Phone Number *
              </label>
              <input 
                type="tel" 
                id="consult-phone" 
                required 
                placeholder="e.g. +234 803 000 0000" 
                class="w-full bg-slate-50 dark:bg-navy-950 border-2 border-tealbrand-500/40 focus:border-tealbrand-600 rounded-xl px-4 py-3.5 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none transition"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
                Preferred European Country
              </label>
              <select 
                id="consult-dest" 
                class="w-full bg-slate-50 dark:bg-navy-950 border-2 border-tealbrand-500/40 focus:border-tealbrand-600 rounded-xl px-4 py-3.5 text-sm text-slate-900 dark:text-white focus:outline-none transition cursor-pointer"
              >
                <option value="Slovakia">Slovakia (Hospitality &amp; Logistics)</option>
                <option value="Poland">Poland (Schengen Work Permit)</option>
                <option value="Czech Republic">Czech Republic (Industrial &amp; Manufacturing)</option>
                <option value="Lithuania">Lithuania (Food Processing)</option>
                <option value="Portugal">Portugal (Agritech &amp; Student Route)</option>
                <option value="Serbia">Serbia (Fast-Track 1–2 Months)</option>
                <option value="Any">Match me with the Fastest Corridor</option>
              </select>
            </div>

            <div class="pt-2">
              <button 
                type="submit" 
                class="w-full py-4 rounded-xl font-black text-sm sm:text-base text-white bg-tealbrand-600 hover:bg-tealbrand-700 shadow-md hover:shadow-lg transition-all duration-150 cursor-pointer"
              >
                Submit for Free Case Consultation
              </button>
            </div>

            <!-- Security note matching screenshot 1 -->
            <div class="flex items-center justify-center gap-1.5 text-[11px] text-slate-500 dark:text-slate-400 pt-2 text-center">
              <svg class="w-3.5 h-3.5 text-tealbrand-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
              </svg>
              <span>Your data is secure. We never share or sell your personal information.</span>
            </div>

            <div id="consult-success" class="hidden p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-semibold text-center">
              ✓ Consultation requested! An admissions officer will contact you on WhatsApp shortly.
            </div>
          </form>

        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const form = document.getElementById('consultation-form');
    const successMsg = document.getElementById('consult-success');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (successMsg) {
        successMsg.classList.remove('hidden');
      }
      form.reset();
    });
  })();
</script>
