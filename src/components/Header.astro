---
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full backdrop-blur-lg bg-white/90 dark:bg-navy-900/90 border-b border-slate-200/80 dark:border-navy-800 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <!-- Light Mode Logo -->
        <img 
          src="/Mygo_Travel_Logo.png" 
          alt="MyGo Travel" 
          class="h-10 w-auto object-contain dark:hidden transition-transform group-hover:scale-105"
        />
        <!-- Dark Mode Logo -->
        <img 
          src="/Mygo_Travel_Logo_White.png" 
          alt="MyGo Travel" 
          class="h-10 w-auto object-contain hidden dark:block transition-transform group-hover:scale-105"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8">
        <a 
          href="/" 
          class={`text-sm font-semibold transition-colors hover:text-brand-500 ${currentPath === '/' ? 'text-brand-500' : 'text-slate-600 dark:text-slate-300'}`}
        >
          Home
        </a>
        <a 
          href="/#destinations" 
          class="text-sm font-semibold text-slate-600 hover:text-brand-500 dark:text-slate-300 dark:hover:text-brand-400 transition-colors"
        >
          Destinations & Visas
        </a>
        <a 
          href="/#benefits" 
          class="text-sm font-semibold text-slate-600 hover:text-brand-500 dark:text-slate-300 dark:hover:text-brand-400 transition-colors flex items-center gap-1.5"
        >
          Housing & Meals
          <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-green-100 text-green-700 dark:bg-green-950/80 dark:text-green-300 border border-green-200 dark:border-green-800">
            Included
          </span>
        </a>
        <a 
          href="/#reviews" 
          class="text-sm font-semibold text-slate-600 hover:text-brand-500 dark:text-slate-300 dark:hover:text-brand-400 transition-colors"
        >
          Reviews
        </a>
        <a 
          href="/#how-it-works" 
          class="text-sm font-semibold text-slate-600 hover:text-brand-500 dark:text-slate-300 dark:hover:text-brand-400 transition-colors"
        >
          How It Works
        </a>
        <a 
          href="/#contact" 
          class="text-sm font-semibold text-slate-600 hover:text-brand-500 dark:text-slate-300 dark:hover:text-brand-400 transition-colors"
        >
          Contact
        </a>
        <a 
          href="/support" 
          class={`text-sm font-semibold transition-colors hover:text-brand-500 flex items-center gap-1.5 ${currentPath === '/support' ? 'text-brand-500 font-bold' : 'text-slate-600 dark:text-slate-300'}`}
        >
          <svg class="w-3.5 h-3.5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <span>Support</span>
        </a>
      </nav>

      <!-- Action Buttons & Theme Switcher -->
      <div class="flex items-center gap-3">
        <!-- Theme Toggle Button -->
        <button 
          id="theme-toggle" 
          type="button" 
          aria-label="Toggle dark/light theme"
          class="p-2 rounded-xl text-slate-500 hover:text-brand-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:text-brand-400 dark:hover:bg-navy-800 transition-colors"
        >
          <!-- Sun icon (for dark mode -> switch to light) -->
          <svg id="theme-icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
          <!-- Moon icon (for light mode -> switch to dark) -->
          <svg id="theme-icon-moon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
          </svg>
        </button>

        <!-- CTA to Evaluation -->
        <a 
          href="/assess" 
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-bold text-white bg-brand-500 hover:bg-brand-600 rounded-xl shadow-sm hover:shadow-md transition-all duration-150"
        >
          <span>Check Eligibility</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="md:hidden p-2 rounded-xl text-slate-600 hover:text-brand-500 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-navy-800"
          aria-label="Open mobile menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 dark:border-navy-800 bg-white/95 dark:bg-navy-900/95 backdrop-blur-xl px-4 pt-2 pb-6 space-y-3">
    <a href="/" class="block px-3 py-2 rounded-lg text-base font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-navy-800">
      Home
    </a>
    <a href="/#destinations" class="block px-3 py-2 rounded-lg text-base font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-navy-800">
      Destinations & Visas
    </a>
    <a href="/#benefits" class="block px-3 py-2 rounded-lg text-base font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-navy-800">
      Housing & Meals (Included)
    </a>
    <a href="/#reviews" class="block px-3 py-2 rounded-lg text-base font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-navy-800">
      Reviews
    </a>
    <a href="/#how-it-works" class="block px-3 py-2 rounded-lg text-base font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-navy-800">
      How It Works
    </a>
    <a href="/#contact" class="block px-3 py-2 rounded-lg text-base font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-navy-800">
      Contact
    </a>
    <a href="/support" class="block px-3 py-2 rounded-lg text-base font-semibold text-brand-600 dark:text-brand-400 hover:bg-slate-100 dark:hover:bg-navy-800">
      Support Desk (support@mygotravel.eu)
    </a>
    <a href="/assess" class="block w-full text-center px-4 py-3 rounded-xl font-bold text-white bg-brand-500 hover:bg-brand-600 shadow-md">
      Start Free Assessment
    </a>
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }

  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('theme-icon-sun');
  const moonIcon = document.getElementById('theme-icon-moon');

  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      sunIcon?.classList.remove('hidden');
      moonIcon?.classList.add('hidden');
    } else {
      sunIcon?.classList.add('hidden');
      moonIcon?.classList.remove('hidden');
    }
  }

  updateThemeIcons();

  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      if (document.documentElement.classList.contains('dark')) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
      updateThemeIcons();
    });
  }
</script>
