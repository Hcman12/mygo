---
// WhatsApp Floating Corner Widget with Verified Admissions Information
---

<div id="whatsapp-floating-container" class="fixed bottom-6 right-6 z-50 font-sans print:hidden">
  
  <!-- Popup Chat Window (Hidden by default) -->
  <div 
    id="whatsapp-chat-card" 
    class="hidden mb-4 w-[360px] max-w-[calc(100vw-2rem)] bg-white dark:bg-navy-900 rounded-3xl shadow-2xl border border-slate-200/80 dark:border-navy-700/80 overflow-hidden transition-all duration-300 transform scale-95 opacity-0"
    role="dialog"
    aria-label="WhatsApp Case Counselor Chat"
  >
    <!-- Widget Header -->
    <div class="bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 p-4 text-white relative">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="relative">
            <div class="w-11 h-11 rounded-2xl bg-white/20 backdrop-blur flex items-center justify-center p-1.5 border border-white/30 shadow-inner">
              <svg class="w-full h-full fill-white" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
            </div>
            <span class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-400 border-2 border-emerald-700 rounded-full"></span>
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <h4 class="font-bold text-sm text-white">MyGo Relocation Desk</h4>
              <span class="inline-flex items-center text-[10px] bg-white/20 text-white font-semibold px-1.5 py-0.2 rounded-full">
                ✓ Verified
              </span>
            </div>
            <p class="text-xs text-emerald-100 flex items-center gap-1 mt-0.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-ping"></span>
              <span>Admissions Officer Active</span>
            </p>
          </div>
        </div>

        <button 
          id="btn-close-whatsapp" 
          type="button"
          class="text-white/80 hover:text-white p-1 rounded-lg hover:bg-white/10 transition cursor-pointer"
          aria-label="Close chat window"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Counselor Contact Info Bar -->
      <div class="mt-3 pt-2.5 border-t border-white/20 flex items-center justify-between text-xs text-emerald-50">
        <div class="flex items-center gap-1.5 font-mono font-semibold">
          <svg class="w-3.5 h-3.5 text-emerald-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>+1 (209) 949-3346</span>
        </div>
        <span class="text-[10px] bg-white/15 px-2 py-0.5 rounded-full">Typically replies &lt; 5 mins</span>
      </div>
    </div>

    <!-- Chat Messages Body -->
    <div class="p-4 bg-slate-50 dark:bg-navy-950 space-y-3 max-h-[300px] overflow-y-auto text-xs">
      <!-- Officer Message Bubble -->
      <div class="flex items-start gap-2.5">
        <div class="w-7 h-7 rounded-full bg-emerald-600/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-xs shrink-0">
          MG
        </div>
        <div class="bg-white dark:bg-navy-900 border border-slate-200/80 dark:border-navy-800 p-3 rounded-2xl rounded-tl-sm shadow-sm text-slate-700 dark:text-slate-200 leading-relaxed max-w-[85%]">
          <p class="font-semibold text-slate-900 dark:text-white mb-1">Welcome to MyGo Travel European Relocation Desk!</p>
          <p class="text-slate-600 dark:text-slate-300">
            How can our admissions officers assist you today? You can track an existing application, verify your evaluation pass, or start your relocation docket.
          </p>
          <span class="block text-[10px] text-slate-400 dark:text-slate-500 text-right mt-1.5">Official Consular Desk</span>
        </div>
      </div>

      <!-- Quick Action Chips -->
      <div class="space-y-1.5 pt-1 pl-9">
        <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Quick Actions</p>
        <div class="flex flex-col gap-1.5">
          <a 
            href="/track" 
            class="inline-flex items-center justify-between p-2 rounded-xl bg-white dark:bg-navy-900 border border-amber-500/30 hover:border-amber-500 text-slate-800 dark:text-slate-200 hover:text-amber-500 shadow-sm transition group"
          >
            <span class="flex items-center gap-2">
              <span>📦</span>
              <span class="font-semibold">Track My Application Online</span>
            </span>
            <span class="text-xs text-amber-500 group-hover:translate-x-0.5 transition-transform">→</span>
          </a>

          <a 
            href="/assess" 
            class="inline-flex items-center justify-between p-2 rounded-xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 hover:border-brand-500 text-slate-800 dark:text-slate-200 hover:text-brand-500 shadow-sm transition group"
          >
            <span class="flex items-center gap-2">
              <span>📋</span>
              <span class="font-semibold">Take 2-Min Relocation Assessment</span>
            </span>
            <span class="text-xs text-brand-500 group-hover:translate-x-0.5 transition-transform">→</span>
          </a>

          <a 
            href="https://nicerapp.cloud/invite/cd0452e9-e0be-4f0d-9fde-2aaa865c4e01" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-between p-2 rounded-xl bg-white dark:bg-navy-900 border border-blue-500/30 hover:border-blue-500 text-slate-800 dark:text-slate-200 hover:text-blue-500 shadow-sm transition group"
          >
            <span class="flex items-center gap-2">
              <img src="/nicerapplogo.png" alt="NicerApp" class="w-4 h-4 rounded-full object-contain" />
              <span class="font-semibold">Join NicerApp Support Room</span>
            </span>
            <span class="text-xs text-blue-500 group-hover:translate-x-0.5 transition-transform">→</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Quick Message Box -->
    <div class="p-3 bg-white dark:bg-navy-900 border-t border-slate-200 dark:border-navy-800">
      <form id="whatsapp-quick-form" class="space-y-2">
        <div class="relative">
          <input 
            type="text" 
            id="whatsapp-user-msg" 
            placeholder="Type your inquiry or tracking ID..." 
            class="w-full bg-slate-50 dark:bg-navy-950 border border-slate-200 dark:border-navy-800 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-emerald-500 transition"
          />
        </div>

        <button 
          type="submit" 
          class="w-full py-2.5 px-4 rounded-xl font-bold text-xs text-white bg-emerald-600 hover:bg-emerald-500 shadow-md shadow-emerald-600/20 transition flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Start WhatsApp Chat (+1 209 949-3346)</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Floating Launcher Button -->
  <div class="flex items-center gap-3 justify-end">
    <!-- Desktop hover hint pill -->
    <div 
      id="whatsapp-hint-pill" 
      class="hidden sm:inline-flex items-center gap-2 bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-700 shadow-xl px-3.5 py-2 rounded-full text-xs font-semibold text-slate-800 dark:text-slate-100 transition-all cursor-pointer hover:border-emerald-500"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>Chat with Admissions</span>
    </div>

    <!-- Pulsing Trigger Button -->
    <button 
      id="btn-whatsapp-trigger" 
      type="button" 
      aria-label="Open WhatsApp Chat Support"
      class="w-14 h-14 rounded-full bg-gradient-to-tr from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white shadow-xl shadow-emerald-600/30 flex items-center justify-center transition-all duration-200 transform hover:scale-105 active:scale-95 cursor-pointer relative"
    >
      <!-- Official WhatsApp Icon -->
      <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
      <!-- Online green dot badge -->
      <span class="absolute top-0 right-0 flex h-4 w-4">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-4 w-4 bg-emerald-500 border-2 border-white dark:border-navy-900"></span>
      </span>
    </button>
  </div>
</div>

<script is:inline>
  (function() {
    const trigger = document.getElementById('btn-whatsapp-trigger');
    const pill = document.getElementById('whatsapp-hint-pill');
    const card = document.getElementById('whatsapp-chat-card');
    const closeBtn = document.getElementById('btn-close-whatsapp');
    const form = document.getElementById('whatsapp-quick-form');
    const input = document.getElementById('whatsapp-user-msg');

    if (!trigger || !card) return;

    let isOpen = false;

    function openChat() {
      isOpen = true;
      card.classList.remove('hidden');
      requestAnimationFrame(() => {
        card.classList.remove('scale-95', 'opacity-0');
        card.classList.add('scale-100', 'opacity-100');
      });
      if (input) input.focus();
    }

    function closeChat() {
      isOpen = false;
      card.classList.remove('scale-100', 'opacity-100');
      card.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        if (!isOpen) card.classList.add('hidden');
      }, 250);
    }

    trigger.addEventListener('click', () => {
      if (isOpen) {
        closeChat();
      } else {
        openChat();
      }
    });

    pill?.addEventListener('click', () => {
      openChat();
    });

    closeBtn?.addEventListener('click', () => {
      closeChat();
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const message = input?.value.trim() || 'Hello MyGo Travel, I have an inquiry regarding my European visa relocation package.';
      const whatsappUrl = 'https://wa.me/12099493346?text=' + encodeURIComponent(message);
      window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
      if (input) input.value = '';
      closeChat();
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeChat();
      }
    });
  })();
</script>
